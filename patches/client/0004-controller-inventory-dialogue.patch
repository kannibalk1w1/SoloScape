+package net.runelite.client.input.controller;
+
+/** UI input modes. Only directional navigation repeats; action buttons use press edges. */
+public final class UiControls
+{
+    public interface Gateway
+    {
+        UiState snapshot();
+        boolean openInventory();
+        boolean invoke(UiState.Widget widget, UiState.Action action);
+        void cancelSelection();
+        void cancelDialogue();
+    }
+    private static final int A = 1, B = 2, X = 4, Y = 8;
+    private static final int DIRECTIONS = (1 << 11) | (1 << 12) | (1 << 13) | (1 << 14);
+    private final Gateway gateway;
+    private boolean inventory, armed;
+    private long openingUntil, repeatAt;
+    private int slot, choice, dialogueId = -1, heldDirection;
+    private UiState state = UiState.EMPTY;
+    private UiState.Widget context;
+    private int contextIndex;
+
+    public UiControls(Gateway gateway) { this.gateway = gateway; }
+    public void reset()
+    {
+        inventory = false; armed = false; openingUntil = repeatAt = 0;
+        slot = choice = heldDirection = 0; dialogueId = -1; context = null; state = UiState.EMPTY;
+    }
+    public boolean active() { return inventory || state.dialogueId >= 0; }
+    public boolean inDialogue() { return state.dialogueId >= 0; }
+    public UiState.Widget focus()
+    {
+        if (inDialogue()) return choice < state.dialogue.length ? state.dialogue[choice] : null;
+        return inventory && slot < state.inventory.length ? state.inventory[slot] : null;
+    }
+    public UiState.Widget context() { return context; }
+    public int contextIndex() { return contextIndex; }
+    public String prompt()
+    {
+        UiState.Widget widget = focus();
+        if (inDialogue()) return widget == null ? "Dialogue: waiting · B: close" : "A: " + widget.name + " · B: close";
+        if (!inventory) return null;
+        if (context != null && contextIndex < context.actions.length)
+            return "A: " + context.actions[contextIndex].label + " " + context.name + " · D-pad: choose · B: back";
+        if (widget == null) return "Opening inventory · B: back";
+        if (widget.itemId < 0) return "Empty slot · D-pad: move · B: back";
+        String action = widget.actions.length == 0 ? "No action" : widget.actions[0].label;
+        return "A: " + action + " " + widget.name + " · X: actions · B: back";
+    }
+
+    public boolean update(GamepadState input, long now)
+    {
+        state = gateway.snapshot();
+        if (state.dialogueId != dialogueId)
+        {
+            dialogueId = state.dialogueId; choice = 0; context = null; armed = false;
+            heldDirection = 0; repeatAt = 0;
+            if (dialogueId >= 0) inventory = false;
+        }
+        if (!armed)
+        {
+            if ((input.buttonsHeld & (A | B | X | Y | DIRECTIONS)) == 0) armed = true;
+            else return active();
+        }
+        if (inDialogue())
+        {
+            if ((input.buttonsPressed & B) != 0) { gateway.cancelDialogue(); armed = false; return true; }
+            int direction = direction(input, now);
+            if (direction != 0) choice = clamp(choice + (direction == 11 || direction == 13 ? -1 : 1), state.dialogue.length);
+            if ((input.buttonsPressed & A) != 0)
+            {
+                UiState.Widget widget = focus();
+                if (widget != null && widget.actions.length > 0) gateway.invoke(widget, widget.actions[0]);
