+package net.runelite.client.plugins.soloscapecontroller;
+
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.Dimension;
+import java.awt.Graphics2D;
+import java.awt.Rectangle;
+import javax.inject.Inject;
+import net.runelite.client.input.controller.UiControls;
+import net.runelite.client.input.controller.UiState;
+import net.runelite.client.ui.overlay.Overlay;
+import net.runelite.client.ui.overlay.OverlayLayer;
+import net.runelite.client.ui.overlay.OverlayPosition;
+
+/** Focus follows actual rendered widget bounds, including resized layouts and empty slots. */
+public final class SoloScapeUiOverlay extends Overlay
+{
+    private final SoloScapeControllerPlugin plugin;
+    @Inject SoloScapeUiOverlay(SoloScapeControllerPlugin plugin)
+    {
+        super(plugin); this.plugin = plugin;
+        setPosition(OverlayPosition.DYNAMIC); setLayer(OverlayLayer.ABOVE_WIDGETS);
+    }
+    @Override public Dimension render(Graphics2D graphics)
+    {
+        if (!plugin.isActive()) return null;
+        UiControls ui = plugin.getUi();
+        String prompt = ui.prompt();
+        if (prompt == null) return null;
+        Graphics2D draw = (Graphics2D) graphics.create();
+        try
+        {
+            UiState.Widget focus = ui.focus();
+            if (focus != null)
+            {
+                Rectangle rect = focus.bounds;
+                draw.setColor(new Color(255, 205, 75, 65)); draw.fill(rect);
+                draw.setColor(new Color(255, 205, 75)); draw.setStroke(new BasicStroke(2)); draw.draw(rect);
+            }
+            int width = Math.min(700, draw.getFontMetrics().stringWidth(prompt) + 12);
+            draw.setColor(new Color(0, 0, 0, 210)); draw.fillRect(8, 8, width, 25);
+            draw.setColor(Color.WHITE); draw.drawString(prompt, 14, 25);
+            UiState.Widget menu = ui.context();
+            if (menu != null)
+            {
+                int menuWidth = 160;
+                for (UiState.Action action : menu.actions) menuWidth = Math.max(menuWidth, draw.getFontMetrics().stringWidth(action.label) + 20);
+                draw.setColor(new Color(0, 0, 0, 230)); draw.fillRect(8, 38, menuWidth, menu.actions.length * 23 + 6);
+                for (int i = 0; i < menu.actions.length; i++)
+                {
+                    if (i == ui.contextIndex()) { draw.setColor(new Color(110, 90, 35)); draw.fillRect(10, 41 + i * 23, menuWidth - 4, 22); }
+                    draw.setColor(i == ui.contextIndex() ? new Color(255, 220, 95) : Color.WHITE);
+                    draw.drawString(menu.actions[i].label, 16, 57 + i * 23);
+                }
+            }
+        }
+        finally { draw.dispose(); }
+        return null;
+    }
+}
