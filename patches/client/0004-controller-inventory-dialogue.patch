@@ -0,0 +1,51 @@
+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+
+/** Visible native widgets and their ordinary actions, copied on the client thread. */
+public final class UiState
+{
+    public static final UiState EMPTY = new UiState(new Widget[28], new Widget[0], -1);
+    public final Widget[] inventory, dialogue;
+    public final int dialogueId;
+    public final boolean inventoryVisible;
+    public UiState(Widget[] inventory, Widget[] dialogue, int dialogueId)
+    {
+        this(inventory, dialogue, dialogueId, anySlot(inventory));
+    }
+    public UiState(Widget[] inventory, Widget[] dialogue, int dialogueId, boolean inventoryVisible)
+    {
+        this.inventory = inventory; this.dialogue = dialogue; this.dialogueId = dialogueId;
+        this.inventoryVisible = inventoryVisible;
+    }
+    private static boolean anySlot(Widget[] inventory)
+    {
+        for (Widget widget : inventory) if (widget != null) return true;
+        return false;
+    }
+    public boolean hasInventory() { return inventoryVisible; }
+    public static final class Action
+    {
+        public final String label;
+        public final int type, operation;
+        public Action(String label, int type, int operation) { this.label = label; this.type = type; this.operation = operation; }
+        public boolean same(Action other) { return other != null && type == other.type && operation == other.operation && label.equals(other.label); }
+    }
+    public static final class Widget
+    {
+        public final int id, child, itemId, quantity;
+        public final String name;
+        public final Rectangle bounds;
+        public final Action[] actions;
+        public Widget(int id, int child, int itemId, int quantity, String name, Rectangle bounds, Action[] actions)
+        {
+            this.id = id; this.child = child; this.itemId = itemId; this.quantity = quantity;
+            this.name = name; this.bounds = bounds; this.actions = actions;
+        }
+        public boolean same(Widget other)
+        {
+            return other != null && id == other.id && child == other.child && itemId == other.itemId
+                && quantity == other.quantity && name.equals(other.name);
+        }
+    }
+}
