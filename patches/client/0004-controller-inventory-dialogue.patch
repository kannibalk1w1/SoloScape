+            {
+                inventory = true; openingUntil = now + 1_000_000_000L; context = null;
+                armed = false; heldDirection = 0;
+                return true;
+            }
+        }
+        if (!inventory) return false;
+        if ((input.buttonsPressed & B) != 0)
+        {
+            if (context != null) context = null;
+            else leave();
+            return true;
+        }
+        if (!state.hasInventory())
+        {
+            context = null;
+            if (now >= openingUntil) { inventory = false; armed = false; heldDirection = 0; repeatAt = 0; }
+            return true;
+        }
+        openingUntil = 0;
+        UiState.Widget widget = focus();
+        if (context != null && !context.same(widget)) context = null;
+        int direction = direction(input, now);
+        if (context != null)
+        {
+            if (direction != 0) contextIndex = clamp(contextIndex + (direction == 11 || direction == 13 ? -1 : 1), context.actions.length);
+            if ((input.buttonsPressed & A) != 0)
+            {
+                if (contextIndex < context.actions.length) gateway.invoke(context, context.actions[contextIndex]);
+                context = null; armed = false;
+            }
+            return true;
+        }
+        if (direction != 0)
+        {
+            slot = moveSlot(slot, direction);
+            widget = focus();
+        }
+        if ((input.buttonsPressed & X) != 0 && widget != null && widget.actions.length > 0)
+        {
+            context = widget; contextIndex = 0;
+        }
+        else if ((input.buttonsPressed & A) != 0 && widget != null && widget.actions.length > 0)
+        {
+            gateway.invoke(widget, widget.actions[0]); armed = false;
+        }
+        return true;
+    }
+
+    private void leave()
+    {
+        inventory = false; context = null; armed = false; gateway.cancelSelection();
+        heldDirection = 0; repeatAt = 0;
+    }
+    private int direction(GamepadState input, long now)
+    {
+        int mask = input.buttonsHeld & DIRECTIONS;
+        if (Integer.bitCount(mask) != 1) { heldDirection = 0; repeatAt = 0; return 0; }
+        int direction = Integer.numberOfTrailingZeros(mask);
+        if (direction != heldDirection)
+        {
+            heldDirection = direction; repeatAt = now + 350_000_000L; return direction;
+        }
+        if (now >= repeatAt) { repeatAt = now + 100_000_000L; return direction; }
+        return 0;
+    }
+    private static int clamp(int index, int size) { return Math.max(0, Math.min(Math.max(0, size - 1), index)); }
+    public static int moveSlot(int slot, int direction)
+    {
+        int row = slot / 4, column = slot % 4;
+        if (direction == 11) row = Math.max(0, row - 1);
+        if (direction == 12) row = Math.min(6, row + 1);
+        if (direction == 13) column = Math.max(0, column - 1);
+        if (direction == 14) column = Math.min(3, column + 1);
+        return row * 4 + column;
+    }
+}
