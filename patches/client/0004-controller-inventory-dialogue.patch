+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class UiControlsTest
+{
+    private static UiState.Widget widget(int slot, int item, String name)
+    {
+        return new UiState.Widget(149 << 16, slot, item, 1, name, new Rectangle(100 + slot % 4 * 42, 100 + slot / 4 * 36, 32, 32),
+            item < 0 ? new UiState.Action[0] : new UiState.Action[] {new UiState.Action("Eat", 18, 1), new UiState.Action("Drop", 1011, 7)});
+    }
+    private static final class Fake implements UiControls.Gateway
+    {
+        UiState state;
+        int opens, actions, cancels, closes;
+        UiState.Widget acted;
+        UiState.Action action;
+        Fake()
+        {
+            UiState.Widget[] slots = new UiState.Widget[28];
+            for (int i = 0; i < 28; i++) slots[i] = widget(i, i == 1 ? -1 : 100, "Fish");
+            state = new UiState(slots, new UiState.Widget[0], -1);
+        }
+        public UiState snapshot() { return state; }
+        public boolean openInventory() { opens++; return true; }
+        public boolean invoke(UiState.Widget widget, UiState.Action action) { actions++; acted = widget; this.action = action; return true; }
+        public void cancelSelection() { cancels++; }
+        public void cancelDialogue() { closes++; }
+    }
+    private static void press(UiControls ui, GamepadState input, int mask, long now)
+    {
+        input.updateButtons(0); ui.update(input, now);
+        input.updateButtons(mask); ui.update(input, now + 1);
+    }
+    private static UiControls enter(Fake game, GamepadState input)
+    {
+        UiControls ui = new UiControls(game);
+        press(ui, input, 8, 1);
+        input.updateButtons(0); ui.update(input, 10);
+        return ui;
+    }
+
+    @Test public void gridStopsAtRowAndColumnEdgesAndIncludesEmptySlots()
+    {
+        assertEquals(0, UiControls.moveSlot(0, 11)); assertEquals(3, UiControls.moveSlot(3, 14));
+        assertEquals(24, UiControls.moveSlot(24, 13)); assertEquals(27, UiControls.moveSlot(27, 12));
+        Fake game = new Fake(); GamepadState input = new GamepadState(); UiControls ui = enter(game, input);
+        press(ui, input, 1 << 14, 20); assertEquals(1, ui.focus().child); assertEquals(-1, ui.focus().itemId);
+        press(ui, input, 1, 30); assertEquals(0, game.actions);
+        press(ui, input, 1 << 12, 40); assertEquals(5, ui.focus().child);
+    }
+
+    @Test public void onlyNavigationRepeatsAndInventoryConsumesWorldInput()
+    {
+        Fake game = new Fake(); GamepadState input = new GamepadState(); UiControls ui = enter(game, input);
+        input.leftY = -1; input.updateButtons(1 << 12);
+        assertTrue(ui.update(input, 100)); assertEquals(4, ui.focus().child);
+        input.updateButtons(1 << 12); ui.update(input, 100_000_100); assertEquals(4, ui.focus().child);
+        ui.update(input, 350_000_100); assertEquals(8, ui.focus().child);
+        ui.update(input, 450_000_100); assertEquals(12, ui.focus().child);
+        press(ui, input, 1, 500_000_100); assertEquals(1, game.actions);
+        input.updateButtons(1); ui.update(input, 900_000_100); assertEquals(1, game.actions);
+    }
+
+    @Test public void contextMenuUsesTheSelectedActionAndBBacksOutOneLevel()
+    {
+        Fake game = new Fake(); GamepadState input = new GamepadState(); UiControls ui = enter(game, input);
+        press(ui, input, 4, 20); assertNotNull(ui.context());
+        press(ui, input, 1 << 12, 30); assertEquals(1, ui.contextIndex());
+        press(ui, input, 1, 40); assertEquals("Drop", game.action.label); assertNull(ui.context());
+        press(ui, input, 4, 50); press(ui, input, 2, 60); assertTrue(ui.active()); assertNull(ui.context());
+        press(ui, input, 2, 70); assertFalse(ui.active()); assertEquals(1, game.cancels);
+    }
+
+    @Test public void changedItemInvalidatesAnOpenContextMenu()
+    {
+        Fake game = new Fake(); GamepadState input = new GamepadState(); UiControls ui = enter(game, input);
+        press(ui, input, 4, 20);
+        game.state.inventory[0] = widget(0, -1, "Empty slot");
+        press(ui, input, 1, 30); assertNull(ui.context()); assertEquals(0, game.actions);
+    }
+
+    @Test public void dialogueTakesPriorityAndHeldACannotAdvanceTheNextPage()
+    {
+        Fake game = new Fake(); GamepadState input = new GamepadState(); UiControls ui = enter(game, input);
+        input.updateButtons(1);
+        game.state = new UiState(new UiState.Widget[28], new UiState.Widget[] {widget(0, 100, "Yes"), widget(1, 100, "No")}, 228);
+        assertTrue(ui.update(input, 20)); assertTrue(ui.inDialogue()); assertEquals(0, game.actions);
+        press(ui, input, 1 << 12, 30); assertEquals("No", ui.focus().name);
+        press(ui, input, 1, 40); assertEquals("No", game.acted.name); assertEquals(1, game.actions);
+        input.updateButtons(1); ui.update(input, 500_000_040); assertEquals(1, game.actions);
+        game.state = new UiState(new UiState.Widget[28], new UiState.Widget[] {widget(0, 100, "Continue")}, 64);
+        ui.update(input, 600_000_040); assertEquals(1, game.actions);
+        press(ui, input, 2, 700_000_040); assertEquals(1, game.closes); assertEquals(1, game.actions);
+    }
+
+    @Test public void reconnectRequiresReleasedButtonsAndHiddenInventoryReturnsToWorld()
+    {
+        Fake game = new Fake(); GamepadState input = new GamepadState(); UiControls ui = enter(game, input);
+        ui.reset(); input.updateButtons(8); assertFalse(ui.update(input, 20)); assertFalse(ui.active());
+        press(ui, input, 8, 30); assertTrue(ui.active());
+        input.updateButtons(0); game.state = UiState.EMPTY;
+        assertTrue(ui.update(input, 2_000_000_000L)); assertFalse(ui.active()); assertEquals(0, game.actions);
+        assertEquals(0, game.cancels); // Hiding a tab must not cancel a mouse-selected item.
+    }
+    @Test public void delayedRedrawDoesNotDropInventoryFocusIntoWorldActions()
+    {
+        Fake game = new Fake(); GamepadState input = new GamepadState(); UiControls ui = enter(game, input);
+        game.state = new UiState(new UiState.Widget[28], new UiState.Widget[0], -1, true);
+        press(ui, input, 1, 2_000_000_000L);
+        assertTrue(ui.active()); assertEquals(0, game.actions);
+        assertTrue(ui.update(input, 3_000_000_000L));
+    }
+}
