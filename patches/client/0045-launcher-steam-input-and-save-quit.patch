+package net.runelite.client.soloscape.launcher;
+import java.awt.event.KeyEvent;
+import javax.swing.JButton;
+import net.runelite.client.input.controller.GamepadState;
+import org.junit.Test;
+import static org.junit.Assert.*;
+public class LauncherControllerInputTest {
+ private KeyEvent event(int type,int key){return new KeyEvent(new JButton(),type,0,0,key,KeyEvent.CHAR_UNDEFINED);}
+ @Test public void steamMappedButtonsWorkWithNeutralOrDisconnectedSdl(){
+  LauncherControllerInput input=new LauncherControllerInput();GamepadState raw=new GamepadState(),out=new GamepadState();
+  input.merge(raw,out,true);assertTrue(out.connected);
+  assertTrue(input.key(event(KeyEvent.KEY_PRESSED,KeyEvent.VK_ENTER)));input.merge(raw,out,true);assertEquals(1,out.buttonsPressed);
+  input.merge(raw,out,true);assertEquals(0,out.buttonsPressed);
+  input.key(event(KeyEvent.KEY_RELEASED,KeyEvent.VK_ENTER));input.merge(raw,out,true);assertEquals(1,out.buttonsReleased);
+ }
+ @Test public void simultaneousSteamAndSdlInputProducesOneActionAndFocusClearReleases(){
+  LauncherControllerInput input=new LauncherControllerInput();GamepadState raw=new GamepadState(),out=new GamepadState();raw.connected=true;raw.buttonsHeld=1;
+  input.key(event(KeyEvent.KEY_PRESSED,KeyEvent.VK_ENTER));input.merge(raw,out,true);assertEquals(1,out.buttonsPressed);
+  input.key(event(KeyEvent.KEY_RELEASED,KeyEvent.VK_ENTER));input.merge(raw,out,true);assertEquals(0,out.buttonsPressed);assertEquals(0,out.buttonsReleased);
+  raw.buttonsHeld=0;input.merge(raw,out,true);assertEquals(1,out.buttonsReleased);
+  input.key(event(KeyEvent.KEY_PRESSED,KeyEvent.VK_RIGHT));input.clear();input.merge(raw,out,true);assertEquals(0,out.buttonsHeld);
+ }
+ @Test public void mappedKeysDoNotLeakWhenSteamEntryOwnsInput(){
+  LauncherControllerInput input=new LauncherControllerInput();GamepadState raw=new GamepadState(),out=new GamepadState();
+  assertFalse(input.key(event(KeyEvent.KEY_PRESSED,KeyEvent.VK_X)));
+  input.key(event(KeyEvent.KEY_PRESSED,KeyEvent.VK_ENTER));input.merge(raw,out,false);assertEquals(0,out.buttonsPressed);
+ }
+}
