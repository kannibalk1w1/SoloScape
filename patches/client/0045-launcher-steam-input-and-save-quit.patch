+package net.runelite.client.input.controller;
+import org.junit.Test;
+import static org.junit.Assert.*;
+public class ControllerQuitTest {
+ @Test public void quitIsLocalRequiresSecondPressAndCancellationClearsIt(){
+  ControllerSettingsModel model=new ControllerSettingsModel(new ControllerSettingsModel.Store(){public String get(String key){return null;}public void set(String key,String value){fail("Quit must not change preferences");}});
+  UiState.Widget quit=model.snapshot(false).panes[3].widgets[3];UiState.Action action=quit.actions[0];
+  assertEquals("Save & Quit",quit.name);assertEquals(4,model.invoke(quit,action,false));
+  PanelConfirmation confirm=new PanelConfirmation();assertFalse(confirm.allow(quit,action,1));assertNotNull(confirm.prompt(quit,2));confirm.clear();assertFalse(confirm.allow(quit,action,3));assertTrue(confirm.allow(quit,action,4));
+  assertEquals(-1,model.invoke(quit,new UiState.Action("Save & Quit",18,0),false));
+ }
+}
