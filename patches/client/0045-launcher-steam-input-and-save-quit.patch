@@ -0,0 +1,30 @@
+package net.runelite.client.soloscape.launcher;
+
+import java.awt.event.KeyEvent;
+import net.runelite.client.input.controller.GamepadState;
+
+/** Merge Steam navigation mappings with SDL before computing edges, so one press has one action. */
+final class LauncherControllerInput {
+ private int mapped;
+ void clear(){mapped=0;}
+ boolean key(KeyEvent event){
+  int bit;
+  switch(event.getKeyCode()){
+   case KeyEvent.VK_ENTER:case KeyEvent.VK_SPACE:bit=1;break;
+   case KeyEvent.VK_ESCAPE:bit=2;break;
+   case KeyEvent.VK_UP:bit=1<<11;break;case KeyEvent.VK_DOWN:bit=1<<12;break;
+   case KeyEvent.VK_LEFT:bit=1<<13;break;case KeyEvent.VK_RIGHT:bit=1<<14;break;
+   default:return event.getID()==KeyEvent.KEY_TYPED&&(event.getKeyChar()=='\n'||event.getKeyChar()==' ');
+  }
+  if(event.getID()==KeyEvent.KEY_PRESSED)mapped|=bit;
+  else if(event.getID()==KeyEvent.KEY_RELEASED)mapped&=~bit;
+  return true;
+ }
+ void merge(GamepadState raw,GamepadState out,boolean steamMappings){
+  out.connected=raw.connected||steamMappings;
+  out.leftX=raw.leftX;out.leftY=raw.leftY;out.rightX=raw.rightX;out.rightY=raw.rightY;
+  out.leftTrigger=raw.leftTrigger;out.rightTrigger=raw.rightTrigger;
+  int held=raw.buttonsHeld|(steamMappings?mapped:0);
+  out.buttonsPressed=held&~out.buttonsHeld;out.buttonsReleased=out.buttonsHeld&~held;out.buttonsHeld=held;
+ }
+}
