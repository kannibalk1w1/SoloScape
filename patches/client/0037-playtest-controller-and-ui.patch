+package net.runelite.client.input.controller;
+
+/** Menu direction shared by inventory, dialogue, panels and world action lists. */
+public final class MenuDirection {
+    private MenuDirection() {}
+    public static int mask(GamepadState input) {
+        int buttons=input.buttonsHeld & (15 << 11);
+        if(buttons!=0)return buttons;
+        float x=input.leftX,y=input.leftY;
+        if(!Float.isFinite(x)||!Float.isFinite(y)||Math.hypot(x,y)<.45)return 0;
+        return 1 << (Math.abs(y)>=Math.abs(x)?(y<0?11:12):(x<0?13:14));
+    }
+    public static boolean neutral(GamepadState input) {
+        return Math.hypot(input.leftX,input.leftY)<.25;
+    }
+}
