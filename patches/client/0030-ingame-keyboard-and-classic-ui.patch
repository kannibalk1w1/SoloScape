@@ -0,0 +1,30 @@
+package net.runelite.client.input.controller;
+
+import java.io.File;
+import java.nio.file.*;
+import java.util.concurrent.*;
+import java.util.function.Consumer;
+
+/** SDL's documented X11 URI transport; visibility requests are not dismissal callbacks. */
+public final class SteamKeyboard {
+    private SteamKeyboard(){}
+    private static final ExecutorService REQUESTS=Executors.newSingleThreadExecutor(task->{Thread thread=new Thread(task,"soloscape-steam-keyboard");thread.setDaemon(true);return thread;});
+    private static final boolean DECK=detectDeck();
+    public static boolean isDeck(){return DECK;}
+    private static boolean detectDeck(){
+        if(Boolean.getBoolean("soloscape.steamDeck")||"1".equals(System.getenv("SteamDeck")))return true;
+        try{String name=new String(Files.readAllBytes(Paths.get("/sys/class/dmi/id/product_name")),"UTF-8").trim();return name.equals("Jupiter")||name.equals("Galileo");}
+        catch(Exception unavailable){return false;}
+    }
+    public static void request(boolean open,boolean numeric,Consumer<String> feedback){
+        REQUESTS.execute(()->{
+            Process process=null;
+            try{
+                String uri=open?"steam://open/keyboard?XPosition=0&YPosition=0&Width=0&Height=0&Mode="+(numeric?3:0):"steam://close/keyboard";
+                process=new ProcessBuilder("xdg-open",uri).redirectOutput(ProcessBuilder.Redirect.to(new File("/dev/null"))).redirectError(ProcessBuilder.Redirect.to(new File("/dev/null"))).start();
+                if(!process.waitFor(3,TimeUnit.SECONDS)){process.destroy();feedback.accept("Steam keyboard request timed out. Use Steam + X or select the controller keyboard.");}
+                else if(process.exitValue()!=0)feedback.accept("Steam keyboard unavailable. Use Steam + X or select the controller keyboard.");
+            }catch(Exception unavailable){feedback.accept("Steam keyboard unavailable. Use Steam + X or select the controller keyboard.");}
+        });
+    }
+}
