+++ b/client/src/net/runelite/client/input/controller/SystemEntryControls.java
@@ -0,0 +1,37 @@
+package net.runelite.client.input.controller;
+
+/** Owns controller input until the native prompt ends, or an explicit manual entry finishes.
+ * Client-thread transitions and AWT observations share one synchronized state; no typed values are edited here. */
+public final class SystemEntryControls {
+    public interface Keyboard {void visible(boolean open,boolean numeric);}
+    private final Keyboard keyboard;
+    private EntryState entry;
+    private boolean manual,active,requested;
+    private long revision;
+    public SystemEntryControls(Keyboard keyboard){this.keyboard=keyboard;}
+    public synchronized boolean update(EntryState next,boolean enabled,boolean available){
+        if(!enabled||!available){reset();return false;}
+        if(next!=null){
+            if(!active||entry==null||!entry.sameSession(next)){
+                if(active&&requested)keyboard.visible(false,false);
+                entry=next;manual=false;active=true;requested=true;revision++;keyboard.visible(true,next.numeric());
+            }else entry=next;
+        }else if(active&&!manual)reset();
+        return active;
+    }
+    public synchronized boolean beginManual(boolean enabled,boolean available){return beginManual(enabled,available,true);}
+    public synchronized boolean beginManual(boolean enabled,boolean available,boolean show){
+        if(!enabled||!available)return false;
+        if(active)return true;
+        entry=null;manual=true;active=true;requested=show;revision++;if(show)keyboard.visible(true,false);return true;
+    }
+    public synchronized boolean finishManual(long expected){if(!active||!manual||revision!=expected)return false;reset();return true;}
+    public synchronized void reopen(long expected){if(active&&revision==expected){requested=true;keyboard.visible(true,entry!=null&&entry.numeric());}}
+    public synchronized void reset(){if(active){active=false;manual=false;entry=null;revision++;if(requested)keyboard.visible(false,false);requested=false;}}
+    public synchronized boolean active(){return active;}
+    public synchronized boolean manual(){return active&&manual;}
+    public synchronized EntryState entry(){return entry;}
+    public synchronized long revision(){return revision;}
+    public synchronized boolean owns(long expected){return active&&revision==expected;}
+    public synchronized boolean sameSession(EntryState candidate){return active&&entry!=null&&entry.sameSession(candidate);}
+}
