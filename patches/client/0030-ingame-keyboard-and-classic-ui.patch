@@ -0,0 +1,14 @@
+package net.runelite.client.input.controller;
+import java.awt.event.KeyEvent;
+/** Mapped edit/navigation keys have one owner; ordinary desktop letters remain native. */
+public final class KeyboardInputPolicy {
+    private KeyboardInputPolicy(){}
+    public static boolean localNavigation(KeyEvent event){
+        int key=event.getKeyCode();char character=event.getKeyChar();
+        return key==KeyEvent.VK_LEFT||key==KeyEvent.VK_RIGHT||key==KeyEvent.VK_UP||key==KeyEvent.VK_DOWN||key==KeyEvent.VK_ENTER||key==KeyEvent.VK_ESCAPE||key==KeyEvent.VK_SPACE||key==KeyEvent.VK_BACK_SPACE||key==KeyEvent.VK_DELETE||key==KeyEvent.VK_HOME||key==KeyEvent.VK_END||character=='\n'||character=='\b'||character==' ';
+    }
+    public static boolean adoptTyped(KeyEvent event,int held,long lastButton,long now){
+        char character=event.getKeyChar();
+        return event.getID()==KeyEvent.KEY_TYPED&&character>32&&character<127&&held==0&&(lastButton==0||now-lastButton>=100000000L);
+    }
+}
