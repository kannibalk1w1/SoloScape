+package net.runelite.client.input.controller;
+
+/** Remember identities, never cached dispatchable actions, for one native selection. */
+public final class SelectionReturn {
+ public static final class Origin {
+  public final int tab,id,child,item,quantity;public final String name;public final boolean home;
+  Origin(UiState.Widget widget,int tab,boolean home){this.tab=tab;this.home=home;id=widget.id;child=widget.child;item=widget.itemId;quantity=widget.quantity;name=widget.name;}
+  public boolean matches(UiState.Widget widget){return widget!=null&&widget.id==id&&widget.child==child&&widget.itemId==item&&widget.quantity==quantity&&widget.name.equals(name);}
+ }
+ private Origin origin;private long token;
+ public void clear(){origin=null;token=0;}
+ public void begin(UiState.Widget widget,int tab,boolean home,long nativeToken){
+  clear();if(widget==null||nativeToken==0||tab<0||tab>=HomeTab.values().length)return;
+  origin=new Origin(widget,tab,home);token=nativeToken;
+ }
+ public Origin observe(long nativeToken){
+  if(origin==null||nativeToken==token)return null;
+  Origin result=nativeToken==0?origin:null;clear();return result;
+ }
+}
