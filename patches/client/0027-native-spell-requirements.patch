@@ -0,0 +1,19 @@
+import org.junit.Test;
+import static org.junit.Assert.*;
+public class ControllerSpellDetailsTest {
+ private Object[] spell(){Object[] information=new Object[16];information[5]=1;information[8]=556;information[9]=1;information[10]=558;information[11]=1;information[12]=-1;information[13]=0;return information;}
+ @Test public void levelAndRunesUseServerInformationPositionsWithoutChangingCache(){
+  Object[] information=spell();ControllerSpellDetails.Detail result=ControllerSpellDetails.read(information,id->id==556?"Air rune":"Mind rune");
+  assertEquals(1,result.level);assertTrue(result.text.contains("Air rune ×1"));assertTrue(result.text.contains("Mind rune ×1"));assertTrue(result.text.contains("Staves"));assertEquals(556,information[8]);
+ }
+ @Test public void malformedOrMissingInformationDoesNotInventRequirements(){
+  assertNull(ControllerSpellDetails.read(null,id->""));assertNull(ControllerSpellDetails.read(new Object[5],id->""));
+  Object[] information=spell();information[5]="1";assertNull(ControllerSpellDetails.read(information,id->""));
+  information=spell();information[10]="Not a rune ID";assertNull(ControllerSpellDetails.read(information,id->""));
+ }
+ @Test public void noRuneHomeSpellAndMissingNamesRemainReadable(){
+  Object[] information=spell();information[5]=0;information[8]=-1;
+  assertEquals("Requires Magic level 0",ControllerSpellDetails.read(information,id->null).text);
+  assertTrue(ControllerSpellDetails.read(spell(),id->null).text.contains("Item 556 ×1"));
+ }
+}
