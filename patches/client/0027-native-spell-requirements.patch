+import java.util.function.IntFunction;
+
+/** Cache information array uses the same level/rune fields as server SpellRunes. */
+final class ControllerSpellDetails {
+ static final class Detail {final int level;final String text;Detail(int level,String text){this.level=level;this.text=text;}}
+ static Detail read(Object[] information,IntFunction<String> name){
+  if(information==null||information.length<16||!(information[5] instanceof Integer))return null;
+  int level=(Integer)information[5];if(level<0||level>120)return null;
+  StringBuilder text=new StringBuilder("Requires Magic level ").append(level);
+  boolean runes=false;
+  for(int i=8;i<=14;i+=2){
+   if(!(information[i] instanceof Integer)||!(information[i+1] instanceof Integer))return null;
+   int id=(Integer)information[i],amount=(Integer)information[i+1];
+   if(id==-1||amount<=0)break;if(id<0||amount>1000000)return null;
+   String label=name.apply(id);if(label==null||label.isEmpty())label="Item "+id;
+   text.append('\n').append(label).append(" ×").append(amount);runes=true;
+  }
+  if(runes)text.append("\nStaves and other equipment may supply required runes.");
+  return new Detail(level,text.toString());
+ }
+ static String itemName(int id){
+  if(Exception_Sub1.aClass255_112==null)return "Item "+id;
+  ObjType definition=Exception_Sub1.aClass255_112.getItemDefinitions(-115,id);
+  return definition==null?"Item "+id:ControllerPanelDetails.plain(definition.name);
+ }
+}
