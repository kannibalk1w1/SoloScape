+package net.runelite.client.input.controller;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ServerCapabilitiesTest
+{
+    @Test public void onlyFreshMatchingProtocolAcknowledgementEnablesCustomPackets()
+    {
+        ServerCapabilities c=new ServerCapabilities();String request=c.request(1);String nonce=request.substring(request.indexOf(' ')+1);
+        assertFalse(c.verified());assertNull(c.request(2));
+        assertTrue(c.receive("SOLOSCAPE|2|"+nonce+"|direct,cancel",3));assertFalse(c.verified());
+        assertTrue(c.receive("SOLOSCAPE|1|wrong|direct,cancel",4));assertFalse(c.verified());
+        assertTrue(c.receive("SOLOSCAPE|1|"+nonce+"|direct,cancel",5));assertTrue(c.verified());
+        c.reset();assertFalse(c.verified());c.request(6);c.receive("SOLOSCAPE|1|"+nonce+"|direct,cancel",7);assertFalse(c.verified());
+    }
+    @Test public void timeoutKeepsCompatibleControlsAndOrdinaryMessagesVisible()
+    {
+        ServerCapabilities c=new ServerCapabilities();String request=c.request(1);String nonce=request.substring(request.indexOf(' ')+1);
+        assertFalse(c.receive("Not enough coins.",2));c.receive("SOLOSCAPE|1|"+nonce+"|direct,cancel",11_000_000_001L);
+        assertFalse(c.verified());assertTrue(c.status(11_000_000_001L).contains("compatible"));
+    }
+}
