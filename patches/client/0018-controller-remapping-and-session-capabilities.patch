diff --git a/client/src/net/runelite/client/input/controller/ServerCapabilities.java b/client/src/net/runelite/client/input/controller/ServerCapabilities.java
new file mode 100644
index 0000000..9d4d32d
--- /dev/null
+++ b/client/src/net/runelite/client/input/controller/ServerCapabilities.java
@@ -0,0 +1,25 @@
+package net.runelite.client.input.controller;
+
+/** Session-bound negotiated extensions. No custom packet is permitted before a fresh acknowledgement. */
+public final class ServerCapabilities
+{
+    private String nonce;
+    private long started;
+    private boolean verified;
+    public void reset(){nonce=null;started=0;verified=false;}
+    public String request(long now)
+    {
+        if(nonce!=null)return null;
+        nonce=java.util.UUID.randomUUID().toString().replace("-","");started=now;
+        return "soloscape_capabilities "+nonce;
+    }
+    public boolean receive(String text,long now)
+    {
+        if(text==null||!text.startsWith("SOLOSCAPE|"))return false;
+        if(nonce!=null && now-started<=10_000_000_000L && text.equals("SOLOSCAPE|1|"+nonce+"|direct,cancel"))verified=true;
+        return true; // Reserved protocol replies do not appear as ordinary game chat.
+    }
+    public boolean verified(){return verified;}
+    public String status(long now)
+    {return verified?"SoloScape server verified":nonce==null?"Waiting for game connection":now-started>10_000_000_000L?"Server features unavailable; using compatible controls":"Checking SoloScape server features";}
+}
