+++ b/client/src/net/runelite/client/input/controller/ActionMap.java
@@ -0,0 +1,31 @@
+package net.runelite.client.input.controller;
+
+/** Maps physical SDL buttons to logical controls without changing the provider's edge history. */
+public final class ActionMap
+{
+    private static final int[] LOGICAL={1,2,4,1<<9,1<<10,8,1<<4,1<<6};
+    private final int[] physical;
+    public ActionMap(int... physical)
+    { if(physical.length!=LOGICAL.length)throw new IllegalArgumentException("Eight bindings required");this.physical=physical.clone(); }
+    public boolean valid()
+    {
+        int used=0;
+        for(int mask:physical){if(Integer.bitCount(mask)!=1 || (mask&~0x7df)!=0 || (used&mask)!=0)return false;used|=mask;}
+        return true;
+    }
+    public boolean same(ActionMap other){return other!=null&&java.util.Arrays.equals(physical,other.physical);}
+    private int translate(int buttons)
+    {
+        int result=buttons & ((1<<11)|(1<<12)|(1<<13)|(1<<14));
+        for(int i=0;i<physical.length;i++)if((buttons&physical[i])!=0)result|=LOGICAL[i];
+        return result;
+    }
+    public void apply(GamepadState raw,GamepadState mapped)
+    {
+        mapped.connected=raw.connected;mapped.leftX=raw.leftX;mapped.leftY=raw.leftY;
+        mapped.rightX=raw.rightX;mapped.rightY=raw.rightY;mapped.leftTrigger=raw.leftTrigger;mapped.rightTrigger=raw.rightTrigger;
+        mapped.buttonsHeld=translate(raw.buttonsHeld);mapped.buttonsPressed=translate(raw.buttonsPressed);mapped.buttonsReleased=translate(raw.buttonsReleased);
+    }
+    public static boolean neutral(GamepadState raw,float deadzone)
+    {return raw.buttonsHeld==0 && raw.leftTrigger<.1f && raw.rightTrigger<.1f && Math.hypot(raw.leftX,raw.leftY)<=deadzone && Math.hypot(raw.rightX,raw.rightY)<=deadzone;}
+}
