@@ -0,0 +1,37 @@
+package net.runelite.client.soloscape.launcher;
+
+import java.awt.*;
+import java.awt.image.BufferedImage;
+import java.io.IOException;
+import java.nio.file.Path;
+import javax.imageio.ImageIO;
+import javax.swing.JPanel;
+
+/** The original login art is a mirrored half-scene, supplied locally. */
+final class LauncherScene extends JPanel
+{
+    private final BufferedImage scene;
+    LauncherScene(Path artwork)
+    {
+        BufferedImage loaded=null;
+        try { if(java.nio.file.Files.isRegularFile(artwork)) loaded=ImageIO.read(artwork.toFile()); }
+        catch(IOException ex) { System.err.println("Launcher artwork unavailable: "+ex.getMessage()); }
+        scene=loaded;
+        setBackground(new Color(29,26,22));
+    }
+    @Override protected void paintComponent(Graphics graphics)
+    {
+        super.paintComponent(graphics);
+        if(scene==null)return;
+        Graphics2D g=(Graphics2D)graphics.create();
+        try
+        {
+            g.setRenderingHint(RenderingHints.KEY_INTERPOLATION,RenderingHints.VALUE_INTERPOLATION_BILINEAR);
+            int half=(getWidth()+1)/2;
+            g.drawImage(scene,0,0,half,getHeight(),null);
+            g.drawImage(scene,getWidth(),0,half-getWidth(),getHeight(),null);
+            g.setColor(new Color(0,0,0,65));g.fillRect(0,0,getWidth(),getHeight());
+        }
+        finally {g.dispose();}
+    }
+}
