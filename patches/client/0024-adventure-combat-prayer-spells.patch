diff --git a/client/test/ControllerAdventureDetailsTest.java b/client/test/ControllerAdventureDetailsTest.java
new file mode 100644
index 0000000..6c87c80
--- /dev/null
+++ b/client/test/ControllerAdventureDetailsTest.java
@@ -0,0 +1,27 @@
+import org.junit.Test;
+import static org.junit.Assert.*;
+public class ControllerAdventureDetailsTest {
+ @Test public void prayerChildOrderDoesNotAssumeMaskBitOrder() {
+  int[] vars=new int[1600];vars[1395]=1<<18;
+  ControllerAdventureDetails.Detail sharp=ControllerAdventureDetails.describe(271,8,3,vars);
+  assertEquals("Sharp Eye",sharp.name);assertEquals("Active",sharp.status);assertTrue(sharp.detail.contains("8"));
+  assertEquals("Inactive",ControllerAdventureDetails.describe(271,8,18,vars).status);
+  vars[1397]=1<<18;assertEquals("Selected",ControllerAdventureDetails.describe(271,42,3,vars).status);
+  vars[1584]=1;vars[1582]=1<<19;assertEquals("Turmoil",ControllerAdventureDetails.describe(271,8,19,vars).name);
+  assertEquals("Active",ControllerAdventureDetails.describe(271,8,19,vars).status);
+  assertNull(ControllerAdventureDetails.describe(271,8,30,vars));
+ }
+ @Test public void combatAndMissingStateRemainReadOnly() {
+  int[] vars=new int[1600];vars[43]=2;vars[172]=1;vars[300]=750;vars[301]=1;
+  assertEquals("Selected",ControllerAdventureDetails.describe(884,13,-1,vars).status);
+  assertEquals("Off",ControllerAdventureDetails.describe(884,15,-1,vars).status);
+  assertTrue(ControllerAdventureDetails.describe(884,4,-1,vars).detail.contains("75.0%"));assertEquals(750,vars[300]);
+  assertEquals("",ControllerAdventureDetails.describe(884,4,-1,null).status);
+  assertNull(ControllerAdventureDetails.describe(271,8,0,null));
+ }
+ @Test public void spellLabelsRequirePinnedKnownComponents() {
+  assertEquals("Wind Strike",ControllerAdventureDetails.describe(192,25,-1,null).name);
+  assertNull(ControllerAdventureDetails.describe(192,7,-1,null));
+  assertNull(ControllerAdventureDetails.describe(192,900,-1,null));
+ }
+}
