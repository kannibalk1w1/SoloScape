@@ -0,0 +1,49 @@
+package net.runelite.client.input.controller;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class EntryControlsTest
+{
+    private static class Fake implements UiControls.Gateway
+    {
+        EntryState state=new EntryState(7,1,"Amount","");
+        int edits,submits,cancels;
+        public UiState snapshot(){return UiState.EMPTY;}
+        public boolean openInventory(){return false;}
+        public boolean invoke(UiState.Widget w,UiState.Action a){return false;}
+        public void cancelSelection(){}
+        public void cancelDialogue(){}
+        public boolean editEntry(EntryState e,String value){edits++;state=new EntryState(e.type,e.revision,e.prompt,value);return true;}
+        public boolean submitEntry(EntryState e){submits++;return true;}
+        public void cancelEntry(EntryState e){cancels++;}
+    }
+    private static void press(EntryControls ui,Fake game,GamepadState input,int mask,long time)
+    {
+        input.updateButtons(0);ui.update(game.state,input,time);
+        input.updateButtons(mask);ui.update(game.state,input,time+1);
+    }
+    @Test public void enteringDoesNotReuseHeldAAndEditsUseEdgesWithDeleteSubmitCancel()
+    {
+        Fake game=new Fake();EntryControls ui=new EntryControls(game);GamepadState input=new GamepadState();
+        input.updateButtons(1);ui.update(game.state,input,1);assertEquals(0,game.edits);
+        press(ui,game,input,1,10);input.updateButtons(1);ui.update(game.state,input,12);assertEquals("1",game.state.value);assertEquals(1,game.edits);
+        press(ui,game,input,1<<14,20);press(ui,game,input,1,30);assertEquals("12",game.state.value);
+        press(ui,game,input,4,40);assertEquals("1",game.state.value);
+        press(ui,game,input,8,50);assertEquals(1,game.submits);
+        press(ui,game,input,2,60);assertEquals(1,game.cancels);
+    }
+    @Test public void replacingPromptRequiresReleaseAndTextEntryHasLetterGrid()
+    {
+        Fake game=new Fake();EntryControls ui=new EntryControls(game);GamepadState input=new GamepadState();
+        ui.update(game.state,input,1);press(ui,game,input,1,10);
+        game.state=new EntryState(11,2,"Search","");ui.update(game.state,input,20);assertEquals(1,game.edits);
+        assertEquals(6,ui.columns());assertEquals("a",ui.keys()[0]);
+        press(ui,game,input,1,30);assertEquals("a",game.state.value);
+    }
+    @Test public void boundsRejectOverflowControlCharactersAndProtocolLength()
+    {
+        assertTrue(EntryState.valid(7,"2147483647"));assertFalse(EntryState.valid(7,"2147483648"));
+        assertFalse(EntryState.valid(7,"-1"));assertFalse(EntryState.valid(9,"bad\ntext"));
+        assertFalse(EntryState.valid(8,"abcdefghijklmnop"));assertFalse(EntryState.valid(11,new String(new char[81]).replace('\0','a')));
+    }
+}
