+package net.runelite.client.input.controller;
+
+/** Compact controller keyboard; press edges edit, direction alone repeats. */
+public final class EntryControls
+{
+    private final UiControls.Gateway gateway;
+    private EntryState state;
+    private int index, heldDirection;
+    private long repeatAt;
+    private boolean armed;
+    public EntryControls(UiControls.Gateway gateway) { this.gateway = gateway; }
+    public void reset() { state = null; index = heldDirection = 0; repeatAt = 0; armed = false; }
+    public boolean active() { return state != null; }
+    public EntryState state() { return state; }
+    public int index() { return index; }
+    public int columns() { return state != null && state.numeric() ? 4 : 6; }
+    public String[] keys()
+    {
+        String symbols = state != null && state.numeric() ? "1234567890" : "abcdefghijklmnopqrstuvwxyz0123456789 -'";
+        String[] keys = new String[symbols.length() + 3];
+        for (int i = 0; i < symbols.length(); i++) keys[i] = String.valueOf(symbols.charAt(i));
+        keys[symbols.length()] = "Delete"; keys[symbols.length()+1] = "Clear"; keys[symbols.length()+2] = "Done";
+        return keys;
+    }
+    public String prompt() { return state == null ? null : "A: key · X: delete · Y: submit · B: cancel · D-pad: move"; }
+    public boolean update(EntryState snapshot, GamepadState input, long now)
+    {
+        if (snapshot == null) { reset(); return false; }
+        if (state == null || !state.sameSession(snapshot)) { reset(); state = snapshot; }
+        state = snapshot;
+        if (!armed)
+        {
+            if ((input.buttonsHeld & (15 | (15 << 11))) == 0 && Math.hypot(input.leftX,input.leftY) < .25) armed = true;
+            else return true;
+        }
+        if ((input.buttonsPressed & 2) != 0) { gateway.cancelEntry(state); armed = false; return true; }
+        if ((input.buttonsPressed & 8) != 0) { gateway.submitEntry(state); armed = false; return true; }
+        if ((input.buttonsPressed & 4) != 0) { delete(); return true; }
+        int direction = direction(input,now), columns = columns();
+        String[] keys = keys();
+        if (direction == 11) index = Math.max(0,index-columns);
+        if (direction == 12) index = Math.min(keys.length-1,index+columns);
+        if (direction == 13 && index%columns > 0) index--;
+        if (direction == 14 && index%columns < columns-1) index = Math.min(keys.length-1,index+1);
+        if ((input.buttonsPressed & 1) != 0)
+        {
+            String key = keys[index];
+            if (key.equals("Done")) { gateway.submitEntry(state); armed = false; }
+            else if (key.equals("Delete")) delete();
+            else if (key.equals("Clear")) gateway.editEntry(state,"");
+            else
+            {
+                String value = state.value+key;
+                if (EntryState.valid(state.type,value)) gateway.editEntry(state,value);
+            }
+        }
+        return true;
+    }
+    private void delete()
+    {
+        if (!state.value.isEmpty()) gateway.editEntry(state,state.value.substring(0,state.value.length()-1));
+    }
+    private int direction(GamepadState input,long now)
+    {
+        int mask = input.buttonsHeld & (15 << 11);
+        if (Integer.bitCount(mask) != 1) { heldDirection = 0; repeatAt = 0; return 0; }
+        int direction = Integer.numberOfTrailingZeros(mask);
+        if (direction != heldDirection) { heldDirection = direction; repeatAt = now+350_000_000L; return direction; }
+        if (now >= repeatAt) { repeatAt = now+100_000_000L; return direction; }
+        return 0;
+    }
+}
