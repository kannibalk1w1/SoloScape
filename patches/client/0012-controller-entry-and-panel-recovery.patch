+package net.runelite.client.input.controller;
+
+/** Native amount/name/search prompt; revision prevents reuse after a replacement prompt. */
+public final class EntryState
+{
+    public final int type;
+    public final long revision;
+    public final String prompt, value;
+    public EntryState(int type, long revision, String prompt, String value)
+    { this.type = type; this.revision = revision; this.prompt = prompt; this.value = value; }
+    public boolean sameSession(EntryState other) { return other != null && type == other.type && revision == other.revision && prompt.equals(other.prompt); }
+    public boolean numeric() { return type == 7; }
+    public static boolean valid(int type, String value)
+    {
+        if (value == null || value.length() > (type == 7 ? 10 : type == 8 ? 12 : 80)) return false;
+        for (int i = 0; i < value.length(); i++)
+        {
+            char c = value.charAt(i);
+            if (type == 7 ? c < '0' || c > '9' : c < 32 || c > 126) return false;
+        }
+        if (type == 7 && !value.isEmpty())
+        {
+            try { if (Long.parseLong(value) > Integer.MAX_VALUE) return false; }
+            catch (NumberFormatException ex) { return false; }
+        }
+        return type == 7 || type == 8 || type == 9 || type == 11;
+    }
+}
