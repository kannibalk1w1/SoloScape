+package net.runelite.client.input.controller;
+import org.junit.Test;
+import static org.junit.Assert.*;
+public class StickScrollTest
+{
+    @Test public void heldOpeningStickRequiresNeutralAndOnlyVerticalIntentScrolls()
+    {
+        StickScroll scroll=new StickScroll();assertEquals(0,scroll.update(0,1,1));
+        assertEquals(0,scroll.update(0,0,2));assertEquals(0,scroll.update(1,.5f,3));
+        assertEquals(12,scroll.update(0,1,4));assertEquals(0,scroll.update(0,1,5));
+        assertEquals(11,scroll.update(0,-1,6));
+    }
+    @Test public void strongerTiltRepeatsFasterAndLongGapsNeverReplayBurst()
+    {
+        StickScroll slow=new StickScroll(),fast=new StickScroll();slow.update(0,0,0);fast.update(0,0,0);
+        assertEquals(12,slow.update(0,.4f,1));assertEquals(12,fast.update(0,1,1));
+        assertEquals(0,slow.update(0,.4f,100_000_001));assertEquals(12,fast.update(0,1,100_000_001));
+        assertEquals(12,fast.update(0,1,10_000_000_000L));assertEquals(0,fast.update(0,1,10_000_000_001L));
+        fast.reset();assertEquals(0,fast.update(0,1,20_000_000_000L));
+    }
+}
