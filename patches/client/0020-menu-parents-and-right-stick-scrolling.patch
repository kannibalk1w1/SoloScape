+package net.runelite.client.input.controller;
+
+import java.util.ArrayDeque;
+
+/** Parent identities only. Saved navigation must never retain dispatchable stale actions. */
+public final class MenuNavigation
+{
+    public static final class Parent
+    {
+        public final int tab,panel;
+        public final boolean inventory;
+        public Parent(int tab,int panel,boolean inventory){this.tab=tab;this.panel=panel;this.inventory=inventory;}
+    }
+    private final ArrayDeque<Parent> parents=new ArrayDeque<>();
+    private int home=-1,returnedHome=-1;
+    public void reset(){parents.clear();home=returnedHome=-1;}
+    public void fromHome(int tab){reset();home=tab;}
+    public void push(int tab,int panel,boolean inventory)
+    {if(parents.size()==16)parents.removeFirst();parents.addLast(new Parent(tab,panel,inventory));}
+    public Parent pop(){return parents.pollLast();}
+    public boolean hasParent(){return !parents.isEmpty();}
+    public void homeBack(){if(home>=0){returnedHome=home;home=-1;}parents.clear();}
+    public int takeHomeBack(){int tab=returnedHome;returnedHome=-1;return tab;}
+}
