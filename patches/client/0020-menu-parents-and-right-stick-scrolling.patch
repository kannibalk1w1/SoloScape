@@ -0,0 +1,22 @@
+package net.runelite.client.input.controller;
+
+/** Menu-local vertical scrolling, bounded repeat with no catch-up after an interruption. */
+public final class StickScroll
+{
+    private boolean armed;
+    private int held;
+    private long next;
+    public void reset(){armed=false;held=0;next=0;}
+    public int update(float x,float y,long now)
+    {
+        if(!Float.isFinite(x)||!Float.isFinite(y)){reset();return 0;}
+        if(Math.hypot(x,y)<.25){armed=true;held=0;next=0;return 0;}
+        if(!armed || Math.abs(y)<.3 || Math.abs(y)<Math.abs(x))return 0;
+        int direction=y<0?11:12;
+        if(direction!=held){held=direction;next=0;}
+        if(now<next)return 0;
+        double amount=Math.min(1,(Math.abs(y)-.3)/.7);
+        next=now+(long)((350-270*amount)*1_000_000);
+        return direction;
+    }
+}
