+    /** Text drawn the classic way: bitmap face, no antialiasing, a black shadow one pixel per 16 px. */
+    static void text(Graphics2D g,String text,int x,int y,Color colour)
+    {
+        g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING,RenderingHints.VALUE_TEXT_ANTIALIAS_OFF);
+        int offset=Math.max(1,g.getFont().getSize()/16);
