+        CharacterCell(){setOpaque(false);}
+        @Override public Component getListCellRendererComponent(JList<?> list,Object value,int index,boolean selected,boolean focus)
+        {
+            String text=String.valueOf(value);int split=text.lastIndexOf(" • ");
+            name=split<0?text:text.substring(0,split);state=split<0?"":text.substring(split+3);
+            stateColour=state.equals("Continue")?GREEN:state.equals("New")?YELLOW:RED;
+            this.selected=selected;this.focused=list.isFocusOwner();return this;
+        }
+        @Override protected void paintComponent(Graphics graphics)
+        {
+            Graphics2D g=(Graphics2D)graphics.create();
+            try
+            {
+                Rectangle box=new Rectangle(2,2,getWidth()-4,getHeight()-4);
+                ControllerTheme.cell(g,box,selected&&focused);
