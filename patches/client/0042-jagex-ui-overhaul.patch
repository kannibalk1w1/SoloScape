+package net.runelite.client.plugins.soloscapecontroller;
+
+import java.awt.*;
+import java.awt.image.BufferedImage;
+import java.lang.reflect.Field;
+import java.lang.reflect.Modifier;
+import org.junit.After;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ControllerThemeTest {
+    @After public void restoreDefault(){ControllerTheme.classic(true);}
+
+    @Test public void everyPaletteColourIsInitialisedInBothPalettes() throws Exception {
+        for(boolean classic:new boolean[]{true,false,true}) {
+            ControllerTheme.classic(classic);
+            for(Field field:ControllerTheme.class.getFields())
+                if(Modifier.isStatic(field.getModifiers())&&field.getType()==Color.class)
+                    assertNotNull(field.getName()+" unset in "+(classic?"classic":"modern"),field.get(null));
+        }
+    }
+    @Test public void classicUsesRuneScapeFacesAndModernKeepsSansSerif() {
+        ControllerTheme.classic(true);
+        assertTrue(ControllerTheme.body(1).getFontName().startsWith("RuneScape"));
+        assertTrue(ControllerTheme.heading(1).getFontName().startsWith("RuneScape"));
+        assertEquals(16,ControllerTheme.body(1).getSize());
+        assertEquals(32,ControllerTheme.body(2).getSize());
+        ControllerTheme.classic(false);
+        assertEquals(new Font(Font.SANS_SERIF,Font.PLAIN,14),ControllerTheme.body(1));
+        assertEquals(new Font(Font.SANS_SERIF,Font.BOLD,22),ControllerTheme.heading(1));
+    }
+    @Test public void classicStackAndQuestColoursFollowTheOriginalRules() {
+        ControllerTheme.classic(true);
+        assertEquals(ControllerTheme.JAGEX_YELLOW,ControllerTheme.quantity(99_999));
+        assertEquals(Color.WHITE,ControllerTheme.quantity(100_000));
+        assertEquals(ControllerTheme.JAGEX_GREEN,ControllerTheme.quantity(10_000_000));
+        assertEquals("99999",ControllerTheme.quantityLabel(99_999));
+        assertEquals("184K",ControllerTheme.quantityLabel(184_520));
+        assertEquals("12M",ControllerTheme.quantityLabel(12_480_000));
+        assertEquals(ControllerTheme.JAGEX_GREEN,ControllerTheme.status("Completed"));
+        assertEquals(ControllerTheme.JAGEX_YELLOW,ControllerTheme.status("In progress"));
+        assertEquals(ControllerTheme.JAGEX_RED,ControllerTheme.status("Not started"));
+        assertEquals(ControllerTheme.JAGEX_YELLOW,ControllerTheme.targetName(1));
+        assertEquals(ControllerTheme.JAGEX_CYAN,ControllerTheme.targetName(2));
+        ControllerTheme.classic(false);
+        assertEquals("184520",ControllerTheme.quantityLabel(184_520));
+        assertEquals(ControllerTheme.MUTED,ControllerTheme.status("Not started"));
+    }
+    @Test public void helpersDrawOnlyInsideTheirBounds() {
+        BufferedImage canvas=new BufferedImage(200,120,BufferedImage.TYPE_INT_ARGB);
+        Graphics2D g=canvas.createGraphics();
+        try {
+            Rectangle box=new Rectangle(40,30,100,50);
+            ControllerTheme.frame(g,box,0);ControllerTheme.well(g,box);ControllerTheme.cell(g,box,true);
+            ControllerTheme.button(g,box,false,true);ControllerTheme.action(g,box,true);ControllerTheme.parchment(g,box);
+        } finally {g.dispose();}
+        for(int y=0;y<canvas.getHeight();y++)for(int x=0;x<canvas.getWidth();x++)
+            if(x<40||x>=140||y<30||y>=80)assertEquals("pixel outside bounds at "+x+","+y,0,canvas.getRGB(x,y)>>>24);
+    }
+}
