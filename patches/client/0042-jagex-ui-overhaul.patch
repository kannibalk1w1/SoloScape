+        @Override protected void paintComponent(Graphics graphics)
+        {
+            Graphics2D g=(Graphics2D)graphics.create();
+            try
+            {
+                FontMetrics metrics=g.getFontMetrics(getFont());g.setFont(getFont());
+                String value=getText();
+                int x=(getWidth()-metrics.stringWidth(value))/2,y=(getHeight()+metrics.getAscent()-metrics.getDescent())/2;
+                text(g,value,x,y,getForeground());
+            }
+            finally{g.dispose();}
+        }
+    }
