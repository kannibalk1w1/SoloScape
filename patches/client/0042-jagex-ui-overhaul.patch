+    /** Deterministic mottled stone generated once per colour; tiles seamlessly at 64 px. */
+    static TexturePaint texture(Color base)
+    {
+        return TEXTURES.computeIfAbsent(base.getRGB(),key->{
+            int size=64;BufferedImage tile=new BufferedImage(size,size,BufferedImage.TYPE_INT_ARGB);
+            java.util.Random random=new java.util.Random(0x5A1E5CA9L);
+            float[] noise=new float[size*size];
+            // Two octaves of wrapped value noise give soft blotches rather than television static.
+            for(int octave=8,weight=6;octave<=32;octave*=4,weight/=2)
+            {
+                float[] grid=new float[octave*octave];for(int i=0;i<grid.length;i++)grid[i]=random.nextFloat()*2-1;
+                int cell=size/octave;
+                for(int y=0;y<size;y++)for(int x=0;x<size;x++)
+                {
+                    int gx=x/cell,gy=y/cell;float fx=(x%cell)/(float)cell,fy=(y%cell)/(float)cell;
+                    float a=grid[gy*octave+gx],b=grid[gy*octave+(gx+1)%octave],c=grid[((gy+1)%octave)*octave+gx],d=grid[((gy+1)%octave)*octave+(gx+1)%octave];
+                    noise[y*size+x]+=weight*((a*(1-fx)+b*fx)*(1-fy)+(c*(1-fx)+d*fx)*fy);
+                }
+            }
+            for(int i=0;i<noise.length;i++)
+            {
+                int shift=Math.round(noise[i])+(random.nextInt(9)==0?random.nextInt(7)-3:0);
+                tile.setRGB(i%size,i/size,new Color(clamp(base.getRed()+shift),clamp(base.getGreen()+shift),clamp(base.getBlue()+shift),base.getAlpha()).getRGB());
+            }
+            return new TexturePaint(tile,new Rectangle(0,0,size,size));
+        });
     }
