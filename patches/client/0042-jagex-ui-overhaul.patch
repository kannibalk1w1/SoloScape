@@ -0,0 +1,59 @@
+package net.runelite.client.plugins.soloscapecontroller;
+
+import java.awt.*;
+
+/**
+ * The classic "Choose Option" menu shared by inventory context actions and world/loot menus:
+ * black title strip, brown body, white option text followed by the coloured target name, and
+ * the selected row lit yellow. Only presentation; callers own selection and native actions.
+ */
+public final class ControllerMenu
+{
+    private ControllerMenu(){}
+    /**
+     * Paints rows {@code start..start+shown-1} at {@code (x,y)} and returns the menu size.
+     * {@code more} adds scroll arrows when rows exist above or below the visible window.
+     */
+    public static Dimension paint(Graphics2D g,int x,int y,int maxWidth,String header,String[] options,String[] targets,Color[] targetColours,int selected,int start,int shown)
+    {
+        FontMetrics metrics=g.getFontMetrics();
+        int pad=5,space=metrics.stringWidth(" "),width=metrics.stringWidth(header)+pad*2;
+        for(int i=start;i<start+shown;i++)width=Math.max(width,metrics.stringWidth(options[i])+(targets[i].isEmpty()?0:space+metrics.stringWidth(targets[i]))+pad*2+metrics.stringWidth(" ↓"));
+        width=Math.min(width,Math.max(60,maxWidth));
+        int row=metrics.getHeight()+4,headerHeight=metrics.getHeight()+2;
+        int height=headerHeight+1+shown*row+3;
+        Rectangle box=new Rectangle(x,y,width,height);
+        int top=y+ControllerTheme.menu(g,box,header,headerHeight);
+        if(!ControllerTheme.classic())top=y+3;
+        for(int i=start;i<start+shown;i++)
+        {
+            int r=i-start,baseline=top+r*row+(row+metrics.getAscent()-metrics.getDescent())/2;
+            boolean chosen=i==selected;
+            if(chosen)
+            {
+                g.setColor(ControllerTheme.classic()?new Color(0,0,0,70):new Color(110,90,35));
+                g.fillRect(x+2,top+r*row,width-4,row);
+                if(ControllerTheme.classic()){g.setColor(ControllerTheme.FOCUS);g.fillRect(x+2,top+r*row+2,2,row-4);}
+            }
+            String arrow=r==0&&start>0?" ↑":r==shown-1&&start+shown<options.length?" ↓":"";
+            int room=width-pad*2-metrics.stringWidth(arrow),cx=x+pad+(ControllerTheme.classic()?2:0);
+            String option=fit(metrics,options[i],room);
+            g.setColor(chosen?ControllerTheme.FOCUS:ControllerTheme.TEXT);ControllerTheme.text(g,option,cx,baseline);
+            cx+=metrics.stringWidth(option);room-=metrics.stringWidth(option);
+            if(!targets[i].isEmpty()&&room>space+metrics.stringWidth("…"))
+            {
+                String target=fit(metrics,targets[i],room-space);
+                g.setColor(chosen&&!ControllerTheme.classic()?ControllerTheme.FOCUS:targetColours[i]);
+                ControllerTheme.text(g,target,cx+space,baseline);cx+=space+metrics.stringWidth(target);
+            }
+            if(!arrow.isEmpty()){g.setColor(ControllerTheme.MUTED);ControllerTheme.text(g,arrow,cx,baseline);}
+        }
+        return new Dimension(width,height);
+    }
+    static String fit(FontMetrics metrics,String value,int width)
+    {
+        if(metrics.stringWidth(value)<=width)return value;
+        while(!value.isEmpty()&&metrics.stringWidth(value+"…")>width)value=value.substring(0,value.length()-1);
+        return value+"…";
+    }
+}
