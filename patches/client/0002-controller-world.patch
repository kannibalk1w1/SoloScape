+package net.runelite.client.input.controller;
+
+import com.GameClient.ControllerTarget;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class WorldControlsTest
+{
+    private static final class Fake implements WorldControls.Gateway
+    {
+        boolean ready = true, valid = true;
+        int walks, actions, finds, yaw;
+        double x, y;
+        ControllerTarget selected = new ControllerTarget("Tree", "Chop", 3, 100, 5, 6, 0, 1000, 1000);
+        public boolean ready() { return ready; }
+        public int yaw() { return yaw; }
+        public void resetWalk() {}
+        public void walk(double x, double y) { walks++; this.x = x; this.y = y; }
+        public ControllerTarget find(double x, double y, ControllerTarget previous) { finds++; return selected; }
+        public boolean interact(ControllerTarget target) { if (!valid) return false; actions++; return true; }
+    }
+
+    @Test public void throttlesMovementAndReleasingStickStopsNewRequests()
+    {
+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState state = new GamepadState();
+        controls.update(state, .18f, 1);
+        state.leftY = -1;
+        controls.update(state, .18f, 150_000_001);
+        assertEquals(1, game.walks); assertEquals(1, game.y, 1e-6);
+        controls.update(state, .18f, 160_000_001);
+        assertEquals(1, game.walks);
+        controls.update(state, .18f, 300_000_001);
+        assertEquals(2, game.walks);
+        state.leftY = 0;
+        controls.update(state, .18f, 450_000_001);
+        assertEquals(2, game.walks);
+    }
+
+    @Test public void heldInputsCannotResumeAfterFocusLossOrReconnect()
+    {
+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState state = new GamepadState();
+        controls.update(state, .18f, 1); controls.reset();
+        state.leftX = 1; state.updateButtons(1);
+        controls.update(state, .18f, 200_000_001);
+        assertEquals(0, game.walks); assertEquals(0, game.actions); assertNull(controls.getTarget());
+        state.leftX = 0; state.updateButtons(0);
+        controls.update(state, .18f, 400_000_001);
+        state.leftX = 1;
+        controls.update(state, .18f, 600_000_001);
+        assertEquals(1, game.walks);
+    }
+
+    @Test public void aActsOnceOnShownFocusAndRequiresNeutralBeforeWalkingAgain()
+    {
+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState state = new GamepadState();
+        controls.update(state, .18f, 1);
+        ControllerTarget shown = controls.getTarget();
+        game.selected = new ControllerTarget("Door", "Open", 3, 200, 5, 7, 0, 1000, 1000);
+        state.leftX = 1; state.updateButtons(1);
+        controls.update(state, .18f, 20_000_001);
+        assertEquals(1, game.actions); assertSame(shown, controls.getTarget()); assertEquals(1, game.finds);
+        state.updateButtons(1);
+        controls.update(state, .18f, 200_000_001);
+        assertEquals(1, game.actions); assertEquals(0, game.walks);
+        state.updateButtons(0);
+        controls.update(state, .18f, 400_000_001);
+        assertEquals(0, game.walks);
+        state.leftX = 0;
+        controls.update(state, .18f, 600_000_001);
+        state.leftX = 1;
+        controls.update(state, .18f, 800_000_001);
+        assertEquals(1, game.walks);
+    }
+
+    @Test public void invalidTargetAndScriptedStateDispatchNothing()
+    {
+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState state = new GamepadState();
+        controls.update(state, .18f, 1); game.valid = false;
+        state.updateButtons(1);
+        controls.update(state, .18f, 20_000_001);
+        assertEquals(0, game.actions);
+        game.ready = false; state.leftY = -1;
+        controls.update(state, .18f, 200_000_001);
+        assertNull(controls.getTarget()); assertEquals(0, game.walks);
+    }
+}
