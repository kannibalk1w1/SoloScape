@@ -0,0 +1,52 @@
+package net.runelite.client.input.controller;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class WorldInputTest
+{
+    @Test public void cameraRelativeDirectionsMatchProjectionAtCardinalAngles()
+    {
+        assertEquals(0, WorldInput.worldX(0, -1, 0), 1e-6);
+        assertEquals(1, WorldInput.worldY(0, -1, 0), 1e-6);
+        assertEquals(-1, WorldInput.worldX(0, -1, 4096), 1e-6);
+        assertEquals(0, WorldInput.worldY(0, -1, 4096), 1e-6);
+        assertEquals(-1, WorldInput.worldY(0, -1, 8192), 1e-6);
+        assertEquals(1, WorldInput.worldX(0, -1, 12288), 1e-6);
+        assertEquals(1, WorldInput.worldY(1, 0, 4096), 1e-6);
+    }
+
+    @Test public void projectionStopsAtWallsAndSceneEdges()
+    {
+        int[][] map = new int[12][12];
+        assertEquals(WorldInput.pack(9, 5), WorldInput.destination(map, 5, 5, 1, 0));
+        map[7][5] = 0x20000000; // west-facing wall on east destination
+        assertEquals(WorldInput.pack(6, 5), WorldInput.destination(map, 5, 5, 1, 0));
+        assertEquals(WorldInput.pack(11, 5), WorldInput.destination(map, 10, 5, 1, 0));
+        assertEquals(WorldInput.pack(5, 5), WorldInput.destination(map, 5, 5, Double.NaN, 1));
+    }
+
+    @Test public void diagonalsNeverCutCornersAndCheckAllDirections()
+    {
+        for (int dx : new int[] {-1, 1}) for (int dy : new int[] {-1, 1})
+        {
+            int[][] map = new int[12][12];
+            assertTrue(WorldInput.canStep(map, 5, 5, dx, dy));
+            map[5 + dx][5] = 0x40000000;
+            assertFalse(WorldInput.canStep(map, 5, 5, dx, dy));
+            map[5 + dx][5] = 0;
+            map[5][5 + dy] = 0x40000000;
+            assertFalse(WorldInput.canStep(map, 5, 5, dx, dy));
+            map[5][5 + dy] = 0;
+            map[5 + dx][5 + dy] = 0x40000000;
+            assertFalse(WorldInput.canStep(map, 5, 5, dx, dy));
+        }
+    }
+
+    @Test public void focusRejectsBehindAndFarAwayTargetsAndRetainsCloseCompetition()
+    {
+        assertTrue(Double.isInfinite(WorldInput.targetScore(0, -1, 0, 1, false)));
+        assertTrue(Double.isInfinite(WorldInput.targetScore(0, 4, 0, 1, false)));
+        assertTrue(WorldInput.targetScore(.3, 2, 0, 1, true) < WorldInput.targetScore(0, 2, 0, 1, false));
+    }
+}
