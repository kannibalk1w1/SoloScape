+package net.runelite.client.plugins.soloscapecontroller;
+
+import com.GameClient;
+import java.awt.Color;
+import java.awt.Dimension;
+import java.awt.Graphics2D;
+import javax.inject.Inject;
+import net.runelite.client.ui.overlay.Overlay;
+import net.runelite.client.ui.overlay.OverlayPosition;
+import net.runelite.client.ui.overlay.OverlayLayer;
+
+/** Explicit focus feedback before A invokes an action. */
+public final class SoloScapeControllerOverlay extends Overlay
+{
+    private final SoloScapeControllerPlugin plugin;
+    @Inject
+    SoloScapeControllerOverlay(SoloScapeControllerPlugin plugin)
+    {
+        super(plugin);
+        this.plugin = plugin;
+        setPosition(OverlayPosition.TOP_LEFT);
+        setLayer(OverlayLayer.ABOVE_WIDGETS);
+    }
+
+    @Override
+    public Dimension render(Graphics2D graphics)
+    {
+        GameClient.ControllerTarget target = plugin.getTarget();
+        if (target == null) return null;
+        String label = "A: " + target.option + " " + target.name;
+        int width = graphics.getFontMetrics().stringWidth(label) + 12;
+        graphics.setColor(new Color(0, 0, 0, 180));
+        graphics.fillRect(0, 0, width, 24);
+        graphics.setColor(Color.WHITE);
+        graphics.drawString(label, 6, 17);
+        return new Dimension(width, 24);
+    }
+}
