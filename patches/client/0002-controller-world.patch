+package net.runelite.client.input.controller;
+
+/** Camera-relative movement and revision-634 collision rules, independent of the client. */
+public final class WorldInput
+{
+    private WorldInput() {}
+
+    public static double worldX(float right, float down, int yaw)
+    {
+        double angle = yaw * (Math.PI * 2 / 16384);
+        return right * Math.cos(angle) + down * Math.sin(angle);
+    }
+
+    public static double worldY(float right, float down, int yaw)
+    {
+        double angle = yaw * (Math.PI * 2 / 16384);
+        return right * Math.sin(angle) - down * Math.cos(angle);
+    }
+
+    private static boolean clear(int[][] flags, int x, int y, int mask)
+    {
+        return flags != null && x >= 0 && x < flags.length && flags[x] != null
+            && y >= 0 && y < flags[x].length && (flags[x][y] & mask) == 0;
+    }
+
+    public static boolean canStep(int[][] flags, int x, int y, int dx, int dy)
+    {
+        if (Math.abs(dx) > 1 || Math.abs(dy) > 1 || (dx == 0 && dy == 0)) return false;
+        // Same destination masks and diagonal side checks as Class5_Sub1.method187.
+        if (dx != 0 && !clear(flags, x + dx, y, dx < 0 ? 0x42240000 : 0x60240000)) return false;
+        if (dy != 0 && !clear(flags, x, y + dy, dy < 0 ? 0x40a40000 : 0x48240000)) return false;
+        if (dx != 0 && dy != 0)
+        {
+            int mask = dx < 0 ? (dy < 0 ? 0x43a40000 : 0x4e240000)
+                : (dy < 0 ? 0x60e40000 : 0x78240000);
+            return clear(flags, x + dx, y + dy, mask);
+        }
+        return true;
+    }
+
+    /** Returns the last directly reachable tile, packed as x/y, without corner cutting. */
+    public static long destination(int[][] flags, int x, int y, double dx, double dy)
+    {
+        if (!Double.isFinite(dx) || !Double.isFinite(dy)) return pack(x, y);
+        double length = Math.hypot(dx, dy);
+        if (length == 0) return pack(x, y);
+        int originX = x, originY = y;
+        int distance = Math.max(2, Math.min(4, (int) Math.ceil(length * 4)));
+        for (int step = 1; step <= distance; step++)
+        {
+            int nextX = originX + (int) Math.round(dx / length * step);
+            int nextY = originY + (int) Math.round(dy / length * step);
+            if (nextX == x && nextY == y) continue;
+            if (!canStep(flags, x, y, nextX - x, nextY - y)) break;
+            x = nextX; y = nextY;
+        }
+        return pack(x, y);
+    }
+
+    public static long pack(int x, int y) { return ((long) x << 32) | (y & 0xffffffffL); }
+    public static int x(long tile) { return (int) (tile >> 32); }
+    public static int y(long tile) { return (int) tile; }
+
+    /** Nearby forward cone, with hysteresis so similarly ranked targets do not flicker. */
+    public static double targetScore(double dx, double dy, double facingX, double facingY, boolean retained)
+    {
+        double distance = Math.hypot(dx, dy);
+        if (distance > 3.5) return Double.POSITIVE_INFINITY;
+        double dot = distance < 0.001 ? 1 : (dx * facingX + dy * facingY) / distance;
+        if (dot < 0.35) return Double.POSITIVE_INFINITY;
+        return distance + (1 - dot) * 1.5 - (retained ? 0.65 : 0);
+    }
+}
