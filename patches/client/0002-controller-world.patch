+        int yaw();
+        void resetWalk();
+        void walk(double x, double y);
+        ControllerTarget find(double x, double y, ControllerTarget previous);
+        boolean interact(ControllerTarget target);
+    }
+
+    private final Gateway gateway;
+    private volatile ControllerTarget target;
+    private boolean armed;
+    private long lastUpdate;
+    private float aimX, aimY = -1;
+
+    public WorldControls(Gateway gateway) { this.gateway = gateway; }
+    public ControllerTarget getTarget() { return target; }
+
+    public void reset()
+    {
+        target = null; armed = false; lastUpdate = 0; aimX = 0; aimY = -1;
+        gateway.resetWalk();
+    }
+
+    public void update(GamepadState state, float deadzone, long now)
+    {
+        if (!gateway.ready()) { reset(); return; }
+        float scale = StickMath.deadzoneScale(state.leftX, state.leftY, deadzone);
+        float x = state.leftX * scale, y = state.leftY * scale;
+        boolean neutral = x == 0 && y == 0;
+        if (!armed)
+        {
+            // Never resume held movement/A after reconnect, focus regain or interaction.
+            if (neutral && (state.buttonsHeld & 1) == 0) armed = true;
+            else return;
+        }
+        int yaw = gateway.yaw();
+        double dx = WorldInput.worldX(x, y, yaw), dy = WorldInput.worldY(x, y, yaw);
+        if (!neutral)
+        {
+            float length = (float) Math.hypot(x, y);
+            aimX = x / length; aimY = y / length;
+        }
+        else gateway.resetWalk();
+        if ((state.buttonsPressed & 1) != 0)
+        {
+            // Act only on the focus already shown; native code revalidates it immediately.
+            if (target != null && gateway.interact(target)) armed = false;
+            lastUpdate = now;
+            return;
+        }
+        if (lastUpdate == 0 || now - lastUpdate >= 150_000_000L)
+        {
+            lastUpdate = now;
+            target = gateway.find(WorldInput.worldX(aimX, aimY, yaw), WorldInput.worldY(aimX, aimY, yaw), target);
+            if (!neutral) gateway.walk(dx, dy);
+        }
+    }
+}
