new file mode 100644
index 0000000..9ae04ed
--- /dev/null
+++ b/client/src/net/runelite/client/plugins/soloscapecontroller/ControllerHints.java
@@ -0,0 +1,37 @@
+package net.runelite.client.plugins.soloscapecontroller;
+
+import java.util.regex.*;
+
+/** One-pass logical-to-physical labels; replacements cannot remap each other. */
+public final class ControllerHints
+{
+    private static final Pattern TOKENS=Pattern.compile("\\b(A|B|X|Y|LB|RB|View|Start)\\b(?=[: /])");
+    private ControllerHints(){}
+    public static String text(String text,ControllerGlyphs glyphs,ControllerButton... buttons)
+    {
+        if(text==null)return null;
+        if(buttons.length!=8)throw new IllegalArgumentException("Eight hint bindings required");
+        String[] logical={"A","B","X","LB","RB","Y","View","Start"};
+        Matcher matcher=TOKENS.matcher(text);StringBuffer result=new StringBuffer();
+        while(matcher.find())
+        {
+            int index=0;while(!logical[index].equals(matcher.group()))index++;
+            ControllerButton physical=buttons[index];String label;
+            switch(physical)
+            {
+                case A:label=glyphs==ControllerGlyphs.PLAYSTATION?"Cross":"[A]";break;
+                case B:label=glyphs==ControllerGlyphs.PLAYSTATION?"Circle":"[B]";break;
+                case X:label=glyphs==ControllerGlyphs.PLAYSTATION?"Square":"[X]";break;
+                case Y:label=glyphs==ControllerGlyphs.PLAYSTATION?"Triangle":"[Y]";break;
+                case LEFT_BUMPER:label=glyphs==ControllerGlyphs.PLAYSTATION?"L1":"LB";break;
+                case RIGHT_BUMPER:label=glyphs==ControllerGlyphs.PLAYSTATION?"R1":"RB";break;
+                case LEFT_STICK:label="LS click";break;
+                case RIGHT_STICK:label="RS click";break;
+                case VIEW:label=glyphs==ControllerGlyphs.PLAYSTATION?"Share":"View";break;
+                default:label=glyphs==ControllerGlyphs.PLAYSTATION?"Options":"Start";
+            }
+            matcher.appendReplacement(result,Matcher.quoteReplacement(label));
+        }
+        matcher.appendTail(result);return result.toString();
+    }
+}
