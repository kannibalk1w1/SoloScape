+import java.awt.image.BufferedImage;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/** Copies native item sprite pixels; does not render models or load assets from overlay threads. */
+final class ControllerItemImages
+{
+    private static final Map<Long,BufferedImage> images=new LinkedHashMap<Long,BufferedImage>(128,.75f,true)
+    {protected boolean removeEldestEntry(Map.Entry<Long,BufferedImage> eldest){return size()>128;}};
+    private static long key(int item,int amount){return ((long)item<<32)|(amount&0xffffffffL);}
+    static synchronized void capture(int item,int amount,int[] pixels)
+    {
+        if(item<0||pixels==null||pixels.length!=36*32)return;
+        BufferedImage image=new BufferedImage(36,32,BufferedImage.TYPE_INT_ARGB);
+        int[] copy=pixels.clone();for(int i=0;i<copy.length;i++)if(copy[i]!=0)copy[i]|=0xff000000;
+        image.setRGB(0,0,36,32,copy,0,36);images.put(key(item,amount),image);
+    }
+    static synchronized BufferedImage get(int item,int amount)
+    {return images.get(key(item,amount));}
+    static synchronized void clear(){images.clear();}
+}
