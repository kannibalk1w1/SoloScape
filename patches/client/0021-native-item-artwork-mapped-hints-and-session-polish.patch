+import org.junit.Test;
+import static org.junit.Assert.*;
+public class ControllerItemImagesTest
+{
+    @Test public void nativePixelsAreCopiedWithTransparentBackgroundAndExactQuantityKey()
+    {
+        ControllerItemImages.clear();int[] pixels=new int[36*32];pixels[0]=0x123456;
+        ControllerItemImages.capture(100,2,pixels);pixels[0]=0;
+        assertEquals(0xff123456,ControllerItemImages.get(100,2).getRGB(0,0));assertEquals(0,ControllerItemImages.get(100,2).getRGB(1,0));
+        assertNull(ControllerItemImages.get(100,1));ControllerItemImages.clear();assertNull(ControllerItemImages.get(100,2));
+    }
+    @Test public void capturedSpriteCacheIsBoundedAndInvalidImagesAreIgnored()
+    {
+        ControllerItemImages.clear();for(int i=0;i<130;i++)ControllerItemImages.capture(i,1,new int[36*32]);
+        assertNull(ControllerItemImages.get(0,1));assertNotNull(ControllerItemImages.get(129,1));
+        ControllerItemImages.capture(200,1,new int[2]);assertNull(ControllerItemImages.get(200,1));ControllerItemImages.clear();
+    }
+}
