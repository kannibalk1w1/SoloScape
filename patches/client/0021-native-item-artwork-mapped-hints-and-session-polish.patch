+package net.runelite.client.plugins.soloscapecontroller;
+
+import java.awt.*;
+import java.awt.image.BufferedImage;
+import net.runelite.client.input.controller.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class PanelOverlayTest {
+    @Test public void longActionListKeepsSelectedNativeActionVisibleAndHitMapped() {
+        UiState.Action[] actions=new UiState.Action[24];
+        for(int i=0;i<actions.length;i++)actions[i]=new UiState.Action("Action "+i,18,i);
+        UiState.Widget item=new UiState.Widget(149<<16,0,100,12,"Long native item name",new Rectangle(0,0,32,32),actions);
+        PanelPresentation view=new PanelPresentation(765,503,1);
+        UiState shown=view.present(new UiState(new UiState.Widget[]{item},new UiState.Widget[0],-1),item,true,false,false,false);
+        BufferedImage canvas=new BufferedImage(765,503,BufferedImage.TYPE_INT_ARGB);
+        Graphics2D g=canvas.createGraphics();
+        try {
+            Rectangle[] hits=SoloScapePanelOverlay.paint(g,view,"Inventory",shown.inventory,shown.inventory[0],null,ControllerGlyphs.XBOX,23,s->s,w->new BufferedImage(36,32,BufferedImage.TYPE_INT_ARGB));
+            assertEquals(24,hits.length);
+            assertNull(hits[0]);
+            assertNotNull(hits[23]);
+            assertTrue(view.bounds.contains(hits[23]));
+            for(int i=0;i<hits.length;i++)if(hits[i]!=null) {
+                assertTrue(view.bounds.contains(hits[i]));
+                for(int j=i+1;j<hits.length;j++)if(hits[j]!=null)assertFalse(hits[i].intersects(hits[j]));
+            }
+        } finally {g.dispose();}
+    }
+}
