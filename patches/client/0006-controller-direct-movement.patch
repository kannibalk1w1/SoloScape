+package net.runelite.client.input.controller;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class DirectInputTest
+{
+    @Test public void allEightDirectionsKeepUnitSteps()
+    {
+        for (int d = 0; d < 8; d++)
+        {
+            int x = DirectInput.dx(d), y = DirectInput.dy(d);
+            assertEquals(d, DirectInput.direction(x, y, -1));
+            assertEquals(1, Math.max(Math.abs(x), Math.abs(y)));
+        }
+    }
+    @Test public void sectorBoundariesHaveHysteresis()
+    {
+        assertEquals(0, DirectInput.direction(Math.cos(Math.toRadians(25)), Math.sin(Math.toRadians(25)), 0));
+        assertEquals(1, DirectInput.direction(Math.cos(Math.toRadians(31)), Math.sin(Math.toRadians(31)), 0));
+        assertEquals(0, DirectInput.direction(Math.cos(Math.toRadians(-25)), Math.sin(Math.toRadians(-25)), 0));
+        assertEquals(7, DirectInput.direction(Math.cos(Math.toRadians(-31)), Math.sin(Math.toRadians(-31)), 0));
+    }
+    @Test public void neutralAndInvalidInputStop()
+    {
+        assertEquals(-1, DirectInput.direction(0, 0, 2));
+        assertEquals(-1, DirectInput.direction(Double.NaN, 1, 2));
+        assertEquals(0, DirectInput.dx(-1)); assertEquals(0, DirectInput.dy(-1));
+    }
+}
