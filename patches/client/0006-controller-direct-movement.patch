+import net.runelite.client.input.controller.DirectInput;
+
+/** SoloScape protocol extension: directional intent, not a menu action or predicted position. */
+final class ControllerDirectMovement
+{
+    private static final Class351 PACKET = new Class351(85, 3);
+    private static int direction = -1;
+    private static boolean run, blocked;
+    private static long lastSent;
+
+    static void update(double x, double y, boolean running)
+    {
+        int next = DirectInput.direction(x, y, direction);
+        if (next < 0) { stop(); blocked = false; return; }
+        if (!ControllerWorld.ready() || blocked) { stop(); return; }
+        long now = System.nanoTime();
+        if (next != direction || running != run || now - lastSent >= 200_000_000L)
+        {
+            send(DirectInput.dx(next), DirectInput.dy(next), running);
+            lastSent = now;
+        }
+        direction = next; run = running;
+        ControllerWorld.markDirectDestination(DirectInput.dx(direction), DirectInput.dy(direction));
+    }
+
+    static void stop()
+    {
+        if (direction >= 0)
+        {
+            if (Class240.anInt4674 == 10 && Class348_Sub23_Sub2.aClass77_9029 != null) send(0, 0, false);
+            ControllerWorld.clearWalkMarker();
+        }
+        direction = -1; lastSent = 0; run = false;
+    }
+
+    static void menuAction()
+    {
+        if (direction >= 0) { stop(); blocked = true; }
+    }
+
+    private static void send(int x, int y, boolean running)
+    {
+        Class348_Sub47 packet = Class286_Sub3.method2148(PACKET, Class348_Sub23_Sub2.aClass77_9029, -100);
+        packet.aClass348_Sub49_Sub2_7116.writeByte(false, x);
+        packet.aClass348_Sub49_Sub2_7116.writeByte(false, y);
+        packet.aClass348_Sub49_Sub2_7116.writeByte(false, running ? 1 : 0);
+        Class348_Sub42_Sub14.method3243(123, packet);
+    }
+}
