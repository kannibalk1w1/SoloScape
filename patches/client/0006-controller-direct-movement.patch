@@ -0,0 +1,22 @@
+package net.runelite.client.input.controller;
+
+/** Eight-way directional intent; angular hysteresis avoids toggling at sector boundaries. */
+public final class DirectInput
+{
+    private static final double SECTOR = Math.PI / 4;
+    private DirectInput() {}
+
+    public static int direction(double x, double y, int previous)
+    {
+        if (!Double.isFinite(x) || !Double.isFinite(y) || Math.hypot(x, y) < .001) return -1;
+        double angle = Math.atan2(y, x);
+        if (previous >= 0 && previous < 8)
+        {
+            double difference = Math.atan2(Math.sin(angle - previous * SECTOR), Math.cos(angle - previous * SECTOR));
+            if (Math.abs(difference) <= SECTOR / 2 + Math.toRadians(7)) return previous;
+        }
+        return Math.floorMod((int) Math.round(angle / SECTOR), 8);
+    }
+    public static int dx(int direction) { return direction < 0 ? 0 : (int) Math.round(Math.cos(direction * SECTOR)); }
+    public static int dy(int direction) { return direction < 0 ? 0 : (int) Math.round(Math.sin(direction * SECTOR)); }
+}
