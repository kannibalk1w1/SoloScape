+    /** Two server ticks: long enough for an accepted walk to move the player at least one tile. */
+    public static final long WALK_RETRY_NANOS = 1_200_000_000L;
+
+    /**
+     * A repeated walk to the current destination is normally redundant. The server silently drops walks
+     * while a script holds the player (cutscene fades, stuns), so resend once the player has stalled.
+     */
+    public static boolean sendWalk(boolean sameDestination, long nanosWithoutProgress)
+    {
+        return !sameDestination || nanosWithoutProgress >= WALK_RETRY_NANOS;
+    }
+
     public static long pack(int x, int y) { return ((long) x << 32) | (y & 0xffffffffL); }
     public static int x(long tile) { return (int) (tile >> 32); }
     public static int y(long tile) { return (int) tile; }
