+                draw.setColor(Color.WHITE);
+                for(int i=0;i<focus.actions.length;i++)
+                {
+                    if(y>view.content.y+view.content.height-line)break;
+                    Rectangle actionBox=new Rectangle(x,y,width,line+3);actionBounds.add(actionBox);
+                    draw.setColor(i==selectedAction?new Color(75,97,110):new Color(34,47,59));draw.fill(actionBox);
+                    draw.setColor(i==selectedAction?new Color(245,203,98):Color.WHITE);
+                    draw.drawString(fit(draw,focus.actions[i].label,width-8),x+4,y+draw.getFontMetrics().getAscent());y+=line+5;
+                }
+            }
+            draw.setColor(confirmation==null?new Color(190,207,218):new Color(245,203,98));
+            String hint=confirmation==null?"D-pad: move/page · A: use · X / right click: actions · LB/RB: pane · B: back":confirmation;
+            draw.clipRect(box.x,box.y,box.width,box.height-(int)(8*scale));
+            text(draw,glyphs.text(hint),box.x+(int)(16*scale),box.y+box.height-(int)(48*scale),box.width-(int)(32*scale),line);
+        }
+        finally{draw.dispose();}
+        return actionBounds.toArray(new Rectangle[0]);
+    }
+    private static int text(Graphics2D draw,String text,int x,int y,int width,int line)
+    {
+        String current="";
+        for(String word:text.split(" "))
+        {
+            String candidate=current.isEmpty()?word:current+" "+word;
+            if(!current.isEmpty()&&draw.getFontMetrics().stringWidth(candidate)>width){draw.drawString(fit(draw,current,width),x,y+draw.getFontMetrics().getAscent());y+=line;current=word;}
+            else current=candidate;
+        }
+        if(!current.isEmpty()){draw.drawString(fit(draw,current,width),x,y+draw.getFontMetrics().getAscent());y+=line;}
+        return y;
+    }
+    private static String fit(Graphics2D draw,String text,int width)
+    { if(draw.getFontMetrics().stringWidth(text)<=width)return text;while(!text.isEmpty()&&draw.getFontMetrics().stringWidth(text+"…")>width)text=text.substring(0,text.length()-1);return text+"…"; }
+    private static final class HitMap
+    {
+        static final HitMap EMPTY=new HitMap(new Rectangle(),new Rectangle(),new UiState.Widget[0],null,new Rectangle[0],0);
+        final Rectangle bounds,content;final UiState.Widget[] widgets;final UiState.Widget focus;final Rectangle[] actions;final long time;
+        HitMap(Rectangle bounds,Rectangle content,UiState.Widget[] widgets,UiState.Widget focus,Rectangle[] actions,long time)
+        {this.bounds=new Rectangle(bounds);this.content=new Rectangle(content);this.widgets=widgets;this.focus=focus;this.actions=actions;this.time=time;}
+    }
+    @Override public MouseEvent mousePressed(MouseEvent event)
+    {
+        HitMap current=hit;captured=plugin.customPanelActive()&&current.bounds.contains(event.getPoint());clicked=captured;
+        if(!captured)return event;
+        if(System.nanoTime()-current.time>=150_000_000L){event.consume();return event;}
+        if(event.getButton()==MouseEvent.BUTTON1 && current.focus!=null)
+            for(int i=0;i<current.actions.length;i++)if(current.actions[i].contains(event.getPoint()))
+            {
+                final UiState.Action action=current.focus.actions[i];
+                clientThread.invokeLater(()->{if(plugin.customPanelActive())plugin.getUi().mouseInvoke(current.focus,action,System.nanoTime());});
+                event.consume();return event;
+            }
+        if(event.getButton()==MouseEvent.BUTTON1||event.getButton()==MouseEvent.BUTTON3)
+            for(UiState.Widget widget:current.widgets)if(widget!=null&&current.content.contains(widget.bounds)&&widget.bounds.contains(event.getPoint()))
+            { final boolean menu=event.getButton()==MouseEvent.BUTTON3;clientThread.invokeLater(()->{if(plugin.customPanelActive())plugin.customMouse(widget,menu);});break; }
+        event.consume();return event;
+    }
+    @Override public MouseWheelEvent mouseWheelMoved(MouseWheelEvent event)
+    {
+        HitMap current=hit;
+        if(plugin.customPanelActive()&&current.bounds.contains(event.getPoint()))
+        {
+            if(System.nanoTime()-current.time<150_000_000L)
+                clientThread.invokeLater(()->{if(plugin.customPanelActive())plugin.getUi().mouseScroll(event.getWheelRotation()<0?11:12);});
+            event.consume();
+        }
+        return event;
+    }
+    @Override public MouseEvent mouseReleased(MouseEvent event){if(captured){event.consume();captured=false;}return event;}
+    @Override public MouseEvent mouseClicked(MouseEvent event){if(clicked){event.consume();clicked=false;}return event;}
+    @Override public MouseEvent mouseDragged(MouseEvent event){if(captured)event.consume();return event;}
+    @Override public MouseEvent mouseMoved(MouseEvent event){return event;}
+    @Override public MouseEvent mouseEntered(MouseEvent event){return event;}
+    @Override public MouseEvent mouseExited(MouseEvent event){return event;}
+}
