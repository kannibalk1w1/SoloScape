+	/** Toggle on the Swing thread; keep fullscreen geometry out of remembered window bounds. */
+	public void toggleFullscreen()
+	{
+		if (!SwingUtilities.isEventDispatchThread())
+		{
+			SwingUtilities.invokeLater(this::toggleFullscreen);
+			return;
+		}
+		if (frame == null)
+		{
+			return;
+		}
+		if (fullscreenDevice != null)
+		{
+			restoreWindowedMode();
+			return;
+		}
+
+		saveClientBoundsConfig();
+		windowedBounds = frame.getBounds();
+		windowedState = frame.getExtendedState();
+		windowedDecorationStyle = frame.getRootPane().getWindowDecorationStyle();
+		windowedBorder = frame.getRootPane().getBorder();
+		windowedUndecorated = frame.isUndecorated();
+		fullscreenDevice = frame.getGraphicsConfiguration().getDevice();
+		// Gamescope already owns the display. Java's exclusive fullscreen handoff
+		// loses XWayland focus on a software canvas; fill its screen without that handoff.
+		exclusiveFullscreen = !"gamescope".equalsIgnoreCase(System.getenv("XDG_CURRENT_DESKTOP"));
+		try
+		{
+			frame.setFullscreen(true);
+			frame.setContainedInScreen(ContainableFrame.Mode.NEVER);
+			frame.setExtendedState(JFrame.NORMAL);
+			frame.setOpacity(1.0f);
+			// Native decorations require recreating the peer; custom chrome does not.
+			if (!windowedUndecorated)
+			{
+				frame.dispose();
+				frame.setUndecorated(true);
+			}
+			frame.getRootPane().setWindowDecorationStyle(JRootPane.NONE);
+			frame.getRootPane().setBorder(null);
+			if (exclusiveFullscreen)
+			{
+				fullscreenDevice.setFullScreenWindow(frame);
+			}
+			else
+			{
+				frame.setBounds(fullscreenDevice.getDefaultConfiguration().getBounds());
+			}
+			frame.validate();
+			focusAfterFullscreenChange();
+		}
+		catch (RuntimeException ex)
+		{
+			log.warn("Unable to enter fullscreen", ex);
+			restoreWindowedMode();
+		}
+	}
+
+	public boolean isFullscreen()
+	{
+		return fullscreenDevice != null;
+	}
+
+	private void restoreWindowedMode()
+	{
+		if (exclusiveFullscreen)
+		{
+			fullscreenDevice.setFullScreenWindow(null);
+		}
+		if (!windowedUndecorated)
+		{
+			frame.dispose();
+			frame.setUndecorated(false);
+		}
+		frame.getRootPane().setWindowDecorationStyle(windowedDecorationStyle);
+		if (withTitleBar)
+		{
+			JComponent titleBar = SubstanceCoreUtilities.getTitlePaneComponent(frame);
+			if (titleBar != null && titleToolbar.getParent() != titleBar)
+			{
+				installTitleToolbar(titleBar);
+			}
+		}
+		frame.getRootPane().setBorder(windowedBorder);
+		frame.setBounds(windowedBounds);
+		frame.setExtendedState(windowedState);
+		fullscreenDevice = null;
+		frame.setFullscreen(false);
+		updateFrameConfig(true);
+		frame.revalidateMinimumSize();
+		frame.setVisible(true);
+		frame.validate();
+		focusAfterFullscreenChange();
+	}
+
+	private void focusAfterFullscreenChange()
+	{
+		frame.toFront();
+		requestFocus();
+		// The game thread may replace its native canvas after the window resize.
+		// Focus that replacement once Swing and the native peer have settled.
+		Timer focusTimer = new Timer(150, null);
+		final int[] attempts = {0};
+		focusTimer.addActionListener(event ->
+		{
+			if (frame.isActive())
+			{
+				giveClientFocus();
+			}
+			if (++attempts[0] == 5 || !frame.isVisible())
+			{
+				focusTimer.stop();
+			}
+		});
+		focusTimer.start();
+	}
