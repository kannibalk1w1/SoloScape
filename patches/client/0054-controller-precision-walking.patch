diff --git a/client/test/net/runelite/client/input/controller/WorldControlsTest.java b/client/test/net/runelite/client/input/controller/WorldControlsTest.java
--- a/client/test/net/runelite/client/input/controller/WorldControlsTest.java
+++ b/client/test/net/runelite/client/input/controller/WorldControlsTest.java
@@ -6,6 +6,31 @@
 
 public class WorldControlsTest
 {
+    @Test public void rightTriggerWalksAtFullTiltAndReleaseRestoresRunWithoutChangingTheThreshold()
+    {
+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState input = new GamepadState();
+        controls.update(input,.18f,1,true);
+        input.leftX=1; input.rightTrigger=1;
+        controls.update(input,.18f,200_000_000L,true);
+        assertEquals(1,game.directUpdates); assertFalse(game.running);
+        input.rightTrigger=0;
+        controls.update(input,.18f,400_000_000L,true);
+        assertEquals(2,game.directUpdates); assertTrue(game.running);
+    }
+
+    @Test public void precisionWalkingCanBeDisabledAndDoesNotStealAimOrInteract()
+    {
+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState input = new GamepadState();
+        controls.update(input,.18f,1,true); input.leftX=1; input.rightTrigger=1;
+        controls.precisionTrigger(false); controls.update(input,.18f,200_000_000L,true);
+        assertTrue(game.running);
+        controls.precisionTrigger(true); input.leftTrigger=1;
+        controls.update(input,.18f,400_000_000L,true);
+        assertEquals(1,game.directUpdates);
+        input.updateButtons(1); controls.update(input,.18f,600_000_000L,true);
+        assertEquals(1,game.actions); assertEquals(1,game.directUpdates);
+    }
+
     private static final class Fake implements WorldControls.Gateway
     {
         boolean ready = true, valid = true, targeting;
