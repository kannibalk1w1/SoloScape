diff --git a/client/src/net/runelite/client/plugins/soloscapecontroller/ControllerArtwork.java b/client/src/net/runelite/client/plugins/soloscapecontroller/ControllerArtwork.java
new file mode 100644
--- /dev/null
+++ b/client/src/net/runelite/client/plugins/soloscapecontroller/ControllerArtwork.java
@@ -0,0 +1,28 @@
+package net.runelite.client.plugins.soloscapecontroller;
+
+import java.awt.image.BufferedImage;
+import java.util.function.Function;
+import net.runelite.client.input.controller.UiState;
+import net.runelite.client.util.ImageUtil;
+
+/** Native item pixels and the bundled, original skill icons; no substitute artwork. */
+public final class ControllerArtwork
+{
+    private static final int[] COMPONENTS={200,28,11,193,52,76,93,68,165,101,44,172,84,179,186,36,19,60,118,126,110,142,134,150,158};
+    private static final String[] SKILLS={"attack","defence","strength","constitution","ranged","prayer","magic","cooking","woodcutting","fletching","fishing","firemaking","crafting","smithing","mining","herblore","agility","thieving","slayer","farming","runecrafting","hunter","construction","summoning","dungeoneering"};
+    private static final BufferedImage[] icons=new BufferedImage[SKILLS.length];
+    private ControllerArtwork() {}
+    public static int skillIndex(int component) {
+        for(int i=0;i<COMPONENTS.length;i++)if(COMPONENTS[i]==component)return i;
+        return -1;
+    }
+    public static BufferedImage skillIcon(UiState.Widget widget) {
+        if(widget==null||widget.id>>>16!=320)return null;
+        int index=skillIndex(widget.id&65535);if(index<0)return null;
+        if(icons[index]==null)icons[index]=ImageUtil.getResourceStreamFromClass(ControllerArtwork.class,"/skill_icons/"+SKILLS[index]+".png");
+        return icons[index];
+    }
+    public static BufferedImage image(UiState.Widget widget,Function<UiState.Widget,BufferedImage> items) {
+        return widget==null?null:widget.itemId>=0?items.apply(widget):skillIcon(widget);
+    }
+}
diff --git a/client/test/net/runelite/client/plugins/soloscapecontroller/ControllerArtworkTest.java b/client/test/net/runelite/client/plugins/soloscapecontroller/ControllerArtworkTest.java
new file mode 100644
--- /dev/null
+++ b/client/test/net/runelite/client/plugins/soloscapecontroller/ControllerArtworkTest.java
@@ -0,0 +1,27 @@
+package net.runelite.client.plugins.soloscapecontroller;
+
+import java.awt.Rectangle;
+import java.awt.image.BufferedImage;
+import net.runelite.client.input.controller.UiState;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ControllerArtworkTest {
+    private UiState.Widget widget(int id,int item){return new UiState.Widget(id,-1,item,1,"",new Rectangle(0,0,36,32),new UiState.Action[0]);}
+    @Test public void everyNativeSkillUsesTheBundledIconIncludingRevision634Skills() {
+        for(int component:new int[]{200,28,11,193,52,76,93,68,165,101,44,172,84,179,186,36,19,60,118,126,110,142,134,150,158}) {
+            UiState.Widget skill=widget(320<<16|component,-1);
+            BufferedImage icon=ControllerArtwork.image(skill,w->{fail("Skill asked for item artwork");return null;});
+            assertNotNull(icon);assertTrue(icon.getWidth()>0&&icon.getHeight()>0);
+            assertSame(icon,ControllerArtwork.skillIcon(skill));
+        }
+        assertNotSame(ControllerArtwork.skillIcon(widget(320<<16|200,-1)),ControllerArtwork.skillIcon(widget(320<<16|193,-1)));
+    }
+    @Test public void itemsKeepExactNativeSpriteAndUnknownWidgetsHaveNoInventedPicture() {
+        BufferedImage item=new BufferedImage(36,32,BufferedImage.TYPE_INT_ARGB);
+        assertSame(item,ControllerArtwork.image(widget(149<<16,590),w->item));
+        assertNull(ControllerArtwork.image(widget(320<<16|999,-1),w->item));
+        assertNull(ControllerArtwork.image(widget(190<<16|200,-1),w->item));
+        assertNull(ControllerArtwork.image(widget(149<<16,590),w->null));
+    }
+}
