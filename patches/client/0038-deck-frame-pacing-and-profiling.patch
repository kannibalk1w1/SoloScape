+/** Pixel layout conversion for the reusable native OpenGL overlay texture. */
+final class OverlayPixels {
+    private OverlayPixels() {}
+    static void flipRows(int[] source,int width,int height,int[] destination){
+        if(source==destination || width<=0 || height<=0 || (long)width*height>source.length || (long)width*height>destination.length)
