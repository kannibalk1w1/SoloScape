+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class OverlayPixelsTest {
+    @Test public void updateLayoutKeepsColoursAlphaAndVerticalOrientation(){
+        int[] source={0x00aabbcc,0x40112233,0xffabcdef,0x80010203,0xff123456,0x00000000};
+        int[] upload=new int[6];OverlayPixels.flipRows(source,3,2,upload);
+        assertArrayEquals(new int[]{0x80010203,0xff123456,0,0x00aabbcc,0x40112233,0xffabcdef},upload);
+        int[] restored=new int[6];OverlayPixels.flipRows(upload,3,2,restored);assertArrayEquals(source,restored);
+        java.util.Arrays.fill(source,0);OverlayPixels.flipRows(source,3,2,upload);assertArrayEquals(new int[6],upload);
+    }
+    @Test(expected=IllegalArgumentException.class) public void wrongSizedUpdateCannotReadPastBuffer(){OverlayPixels.flipRows(new int[5],3,2,new int[6]);}
+    @Test(expected=IllegalArgumentException.class) public void inPlaceUpdateCannotCorruptOppositeRows(){int[] pixels=new int[6];OverlayPixels.flipRows(pixels,3,2,pixels);}
+}
