--- /dev/null
+++ b/client/test/DetachedRendererTest.java
@@ -0,0 +1,36 @@
+import org.junit.After;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class DetachedRendererTest {
+    @After public void reset(){DetachedRenderer.setFpsTarget(180);DetachedRenderer.requestActive(false);}
+    @Test public void renderingTimeConsumesTheFrameBudget(){
+        DetachedRenderer.setFpsTarget(60);DetachedRenderer.requestActive(true);
+        long start=1_000_000_000L;DetachedRenderer.frameDrawn(start);
+        assertEquals(17,DetachedRenderer.millisUntilNextFrame(start));
+        assertEquals(9,DetachedRenderer.millisUntilNextFrame(start+8_000_000L));
+        assertEquals(0,DetachedRenderer.millisUntilNextFrame(start+20_000_000L));
+        assertTrue(DetachedRenderer.frameDue(start+20_000_000L));
+    }
+    @Test public void overrunsDiscardBacklogAndUncappedHasNoWait(){
+        DetachedRenderer.setFpsTarget(60);DetachedRenderer.requestActive(true);
+        long start=1_000_000_000L;DetachedRenderer.frameDrawn(start);
+        DetachedRenderer.frameDrawn(start+500_000_000L);
+        assertFalse(DetachedRenderer.frameDue(start+500_000_000L));
+        assertEquals(17,DetachedRenderer.millisUntilNextFrame(start+500_000_000L));
+        DetachedRenderer.setFpsTarget(0);assertEquals(0,DetachedRenderer.millisUntilNextFrame(start));assertTrue(DetachedRenderer.frameDue(start));
+    }
+    @Test public void fractionalDeadlineAndEarlierLogicCycleArePreserved(){
+        DetachedRenderer.setFpsTarget(60);DetachedRenderer.requestActive(true);
+        long start=1_000_000_000L;DetachedRenderer.frameDrawn(start);
+        assertEquals(666_666L,DetachedRenderer.nanosUntilNextPass(start+16_000_000L,20_000_000L));
+        assertEquals(120_000L,DetachedRenderer.nanosUntilNextPass(start+16_000_000L,120_000L));
+        assertEquals(0L,DetachedRenderer.nanosUntilNextPass(start+17_000_000L,20_000_000L));
+        assertEquals(0L,DetachedRenderer.nanosUntilNextPass(start,0L));
+    }
+    @Test public void uncappedRetainsYieldWithoutDelayingDueLogic(){
+        DetachedRenderer.setFpsTarget(0);DetachedRenderer.requestActive(true);
+        assertEquals(1_000_000L,DetachedRenderer.nanosUntilNextPass(1L,20_000_000L));
+        assertEquals(0L,DetachedRenderer.nanosUntilNextPass(1L,0L));
+    }
+}
diff --git a/client/test/NativeGraphicsLibraryTest.java b/client/test/NativeGraphicsLibraryTest.java
new file mode 100644
index 0000000..8d1f494
--- /dev/null
+++ b/client/test/NativeGraphicsLibraryTest.java
@@ -0,0 +1,45 @@
+import com.NativeGraphicsLibrary;
+import com.sun.jna.NativeLibrary;
+import com.sun.jna.Pointer;
+import com.sun.jna.Platform;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.io.*;
+import java.util.*;
+import org.junit.Test;
+import org.junit.Assume;
+import static org.junit.Assert.*;
+
+public class NativeGraphicsLibraryTest {
+    @Test public void protectsLegacyDataSlotsAgainstPreloadedGlFunctions() throws Exception {
+        Assume.assumeTrue(Platform.isLinux());
+        try { Assume.assumeTrue(new ProcessBuilder("cc","--version").redirectErrorStream(true).start().waitFor()==0); }
+        catch(IOException unavailable) { Assume.assumeNoException(unavailable); }
+        Path root=Files.createTempDirectory("soloscape-gl-symbols-");
+        try {
+            Path provider=root.resolve("provider.c"),bridge=root.resolve("bridge.c");
+            Files.write(provider,Arrays.asList("void glGenBuffersARB(void) {}"),StandardCharsets.UTF_8);
+            Files.write(bridge,Arrays.asList("void *glGenBuffersARB;", "void **slot_address(void) { return &glGenBuffersARB; }", "void initialise_slot(void) { glGenBuffersARB=(void*)0x1234; }"),StandardCharsets.UTF_8);
+            for(String name:Arrays.asList("provider","bridge"))assertEquals(0,new ProcessBuilder("cc","-shared","-fPIC","-o",root.resolve(name+".so").toString(),root.resolve(name+".c").toString()).inheritIO().start().waitFor());
+            String cp=String.join(File.pathSeparator,location(NativeGraphicsLibraryTest.class),location(NativeGraphicsLibrary.class),location(NativeLibrary.class));
+            for(String mode:Arrays.asList("ordinary","protected")) {
+                ProcessBuilder run=new ProcessBuilder(System.getProperty("java.home")+"/bin/java","-cp",cp,"NativeGraphicsLibraryTest",root.resolve("bridge.so").toString(),mode);
+                run.environment().put("LD_PRELOAD",root.resolve("provider.so").toString());run.redirectErrorStream(true);
+                Process child=run.start();ByteArrayOutputStream bytes=new ByteArrayOutputStream();byte[] buffer=new byte[4096];int count;
+                while((count=child.getInputStream().read(buffer))!=-1)bytes.write(buffer,0,count);
+                String output=new String(bytes.toByteArray(),StandardCharsets.UTF_8);
+                assertEquals(output,0,child.waitFor());assertTrue(output,output.contains(mode.equals("ordinary")?"preempted":"private slot updated"));
+            }
+        } finally {try(java.util.stream.Stream<Path> files=Files.walk(root)){files.sorted(Comparator.reverseOrder()).forEach(p->{try{Files.delete(p);}catch(IOException ignored){}});}}
+    }
+    private static String location(Class<?> type)throws Exception{return Paths.get(type.getProtectionDomain().getCodeSource().getLocation().toURI()).toString();}
+    public static void main(String[] args)throws Exception {
+        File file=new File(args[0]);if(args[1].equals("protected"))NativeGraphicsLibrary.preload(file,"jaggl");
+        NativeLibrary bridge=NativeLibrary.getInstance(file.getAbsolutePath());
+        Pointer slot=(Pointer)bridge.getFunction("slot_address").invoke(Pointer.class,new Object[0]);
+        if(!slot.equals(bridge.getGlobalVariableAddress("glGenBuffersARB"))){System.out.println("preempted");return;}
+        bridge.getFunction("initialise_slot").invokeVoid(new Object[0]);
+        if(Pointer.nativeValue(slot.getPointer(0))!=0x1234)throw new AssertionError("Wrong private GL pointer");
+        System.out.println("private slot updated");
+    }
+}
