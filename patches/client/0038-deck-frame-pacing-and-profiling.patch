@@ -0,0 +1,15 @@
+package com;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.function.Supplier;
+
+/** Client-thread snapshot, invalidated around native logic updates. Callers own their list. */
+public final class CycleListSnapshot<T> {
+    private List<T> snapshot;
+    public void invalidate() { snapshot=null; }
+    public List<T> get(Supplier<List<T>> read) {
+        if(snapshot==null)snapshot=new ArrayList<>(read.get());
+        return new ArrayList<>(snapshot);
+    }
+}
