+package com;
+
+import java.util.*;
+
+/** Opt-in, bounded client-thread timing. Disabled runs allocate no sample buffers. */
+public final class FrameTimings {
+    public static final boolean ENABLED=Boolean.getBoolean("soloscape.performance.timings");
+    public static final int LOGIC=0, PLUGINS=1, OVERLAY_PAINT=2, OVERLAY_UPLOAD=3, FRAME=4, EVENT_QUEUE=5, PRESENT=6;
+    private static final String[] NAMES={"logic","plugins","overlay_paint","overlay_upload","frame_including_overlays","event_queue","present"};
+    private static final int CAPACITY=120000;
+    private static final long[][] samples=ENABLED?new long[NAMES.length][CAPACITY]:null;
+    private static final long[] counts=ENABLED?new long[NAMES.length]:null, totals=ENABLED?new long[NAMES.length]:null;
+    private static long frames,cycles;
+    private FrameTimings() {}
+    public static long start(){return ENABLED?System.nanoTime():0;}
+    public static void cycles(int count){if(ENABLED)cycles+=count;}
+    public static void end(int phase,long started){
+        if(!ENABLED||started==0)return;
+        long elapsed=System.nanoTime()-started,count=counts[phase]++;
+        totals[phase]+=elapsed;
+        if(count<CAPACITY)samples[phase][(int)count]=elapsed;
+        if(phase==FRAME)frames++;
+    }
+    public static Map<String,Object> snapshotAndReset(){
+        Map<String,Object> result=new LinkedHashMap<>();
+        result.put("enabled",ENABLED);if(!ENABLED)return result;
+        result.put("frames",frames);result.put("logic_cycles",cycles);
+        for(int phase=0;phase<NAMES.length;phase++){
+            int size=(int)Math.min(counts[phase],CAPACITY);
+            long[] sorted=Arrays.copyOf(samples[phase],size);Arrays.sort(sorted);
+            Map<String,Object> value=new LinkedHashMap<>();value.put("calls",counts[phase]);value.put("truncated",counts[phase]>CAPACITY);
+            value.put("ms_per_frame",frames==0?0:totals[phase]/1e6/frames);
+            if(size>0){value.put("median_call_ms",sorted[size/2]/1e6);value.put("p99_call_ms",sorted[(size-1)*99/100]/1e6);value.put("max_call_ms",sorted[size-1]/1e6);}
+            result.put(NAMES[phase],value);counts[phase]=totals[phase]=0;
+        }
+        frames=cycles=0;return result;
+    }
+}
