+package com;
+
+import com.sun.jna.Library;
+import com.sun.jna.NativeLibrary;
+import com.sun.jna.Platform;
+import java.io.File;
+import java.io.IOException;
+import java.util.Collections;
+
+/** The legacy GL bridge exports writable slots with OpenGL function names. */
+public final class NativeGraphicsLibrary {
+    private static NativeLibrary jaggl;
+    private NativeGraphicsLibrary() {}
+    public static synchronized void preload(File file,String name) throws IOException {
+        if(!Platform.isLinux() || !"jaggl".equals(name) || jaggl!=null)return;
+        // Resolve the bridge's own slots before global symbols from Steam/libGL.
+        // Otherwise its initialisation writes a function pointer into libGL's
+        // executable glGenBuffersARB symbol and faults before the first frame.
+        // Linux RTLD_NOW=2, RTLD_DEEPBIND=8. Keep the handle alive alongside JNI.
+        jaggl=NativeLibrary.getInstance(file.getCanonicalPath(),Collections.singletonMap(Library.OPTION_OPEN_FLAGS,2|8));
+    }
+}
