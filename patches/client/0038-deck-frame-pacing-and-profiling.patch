@@ -0,0 +1,22 @@
+import com.CycleListSnapshot;
+import java.util.*;
+import java.util.concurrent.atomic.AtomicInteger;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class CycleListSnapshotTest {
+    @Test public void multipleConsumersShareOneNativeReadButOwnTheirLists() {
+        CycleListSnapshot<String> cache=new CycleListSnapshot<>();AtomicInteger reads=new AtomicInteger();
+        java.util.function.Supplier<List<String>> source=()->{reads.incrementAndGet();return Arrays.asList("Bones");};
+        List<String> first=cache.get(source);first.clear();
+        assertEquals(Arrays.asList("Bones"),cache.get(source));assertEquals(1,reads.get());
+    }
+    @Test public void NextNativeCycleRefreshesQuantityDespawnAndRegionChanges() {
+        CycleListSnapshot<String> cache=new CycleListSnapshot<>();ArrayList<String> nativeItems=new ArrayList<>(Arrays.asList("Coins x1"));
+        assertEquals(Arrays.asList("Coins x1"),cache.get(()->nativeItems));
+        nativeItems.set(0,"Coins x2");cache.invalidate();
+        assertEquals(Arrays.asList("Coins x2"),cache.get(()->nativeItems));
+        nativeItems.clear();cache.invalidate();assertTrue(cache.get(()->nativeItems).isEmpty());
+        nativeItems.add("New region pot");cache.invalidate();assertEquals(nativeItems,cache.get(()->nativeItems));
+    }
+}
