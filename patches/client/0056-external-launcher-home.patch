+package net.runelite.client.soloscape.launcher;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.Paths;
+
+/** Only settings/art are shared; world ownership and build locks belong to their code version. */
+final class LauncherPaths
+{
+    static Path directory(Path root, String value) throws IOException
+    {
+        if (value == null) return root.resolve(".runtime");
+        if (value.isEmpty() || value.indexOf('\0') >= 0 || !Paths.get(value).isAbsolute())
+            throw new IOException("SOLOSCAPE_LAUNCHER_HOME must be a nonempty absolute directory path.");
+        Path directory = Paths.get(value);
+        if (Files.isSymbolicLink(directory) || (Files.exists(directory) && !Files.isDirectory(directory)))
+            throw new IOException("SOLOSCAPE_LAUNCHER_HOME must name a directory, not a file or symbolic link.");
+        return directory;
+    }
+}
