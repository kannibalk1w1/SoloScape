+package net.runelite.client.soloscape.launcher;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import org.junit.Test;
+import org.junit.Rule;
+import org.junit.rules.TemporaryFolder;
+import static org.junit.Assert.*;
+
+public class LauncherPathsTest
+{
+    @Rule public TemporaryFolder temporary = new TemporaryFolder();
+
+    @Test public void defaultBelongsToTheSuppliedCodeVersion() throws Exception
+    {
+        Path root = temporary.getRoot().toPath();
+        assertEquals(root.resolve(".runtime"), LauncherPaths.directory(root, null));
+        assertFalse(Files.exists(root.resolve(".runtime")));
+    }
+
+    @Test public void explicitHomeSurvivesCodeVersionChangeWithoutCreation() throws Exception
+    {
+        Path root = temporary.getRoot().toPath(), shared = root.resolve("shared launcher");
+        assertEquals(shared, LauncherPaths.directory(root.resolve("version-a"), shared.toString()));
+        assertEquals(shared, LauncherPaths.directory(root.resolve("version-b"), shared.toString()));
+        assertFalse(Files.exists(shared));
+    }
+
+    @Test public void selectedHomeSuppliesTheActualSceneArtwork() throws Exception
+    {
+        Path root = temporary.getRoot().toPath(), shared = root.resolve("shared");
+        Path art = shared.resolve("launcher-art/brazier.jpg"); Files.createDirectories(art.getParent());
+        java.awt.image.BufferedImage original = new java.awt.image.BufferedImage(8, 8, java.awt.image.BufferedImage.TYPE_INT_RGB);
+        java.awt.Graphics2D paint = original.createGraphics();
+        paint.setColor(java.awt.Color.GREEN); paint.fillRect(0, 0, 8, 8); paint.dispose();
+        javax.imageio.ImageIO.write(original, "png", art.toFile());
+        LauncherScene scene = new LauncherScene(LauncherPaths.directory(root.resolve("new-version"), shared.toString()).resolve("launcher-art/brazier.jpg"));
+        scene.setSize(100, 100);
+        java.awt.image.BufferedImage frame = new java.awt.image.BufferedImage(100, 100, java.awt.image.BufferedImage.TYPE_INT_RGB);
+        java.awt.Graphics2D output = frame.createGraphics(); scene.paint(output); output.dispose();
+        java.awt.Color center = new java.awt.Color(frame.getRGB(50, 50));
+        assertTrue("Original green fixture was rendered from external artwork", center.getGreen() > center.getRed() + 50);
+        assertFalse(Files.exists(root.resolve("new-version")));
+    }
+
+    @Test public void invalidExplicitHomesAreRefused() throws Exception
+    {
+        Path root = temporary.getRoot().toPath(), file = Files.createFile(root.resolve("file"));
+        Path link = root.resolve("link"); Files.createSymbolicLink(link, root.resolve("missing"));
+        for (String value : new String[]{"", ".", "relative", "bad\0path", file.toString(), link.toString()})
+        {
+            try { LauncherPaths.directory(root, value); fail("Accepted invalid launcher home"); }
+            catch (IOException expected) { }
+        }
+        assertTrue(Files.exists(file)); assertTrue(Files.isSymbolicLink(link));
+    }
+}
