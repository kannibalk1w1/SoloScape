@@ -0,0 +1,99 @@
+package net.runelite.client.input.controller;
+
+/** Separate eight-slot quick wheel; one native action per explicit confirmation. */
+public final class QuickRadialControls
+{
+    public interface Gateway
+    {
+        boolean allowed();
+        UiState snapshot();
+        boolean openTab(int index);
+        boolean invoke(UiState.Widget widget,UiState.Action action);
+        QuickBinding binding(int slot);
+        void bind(int slot,QuickBinding binding);
+        void restore(int slot);
+    }
+    private final Gateway gateway;
+    private boolean active, armed, openingArmed, stickArmed, selectedSpell;
+    private int selected, trigger=1<<6;
+    private long deadline;
+    private QuickBinding pending,captured;
+    private String message;
+    public QuickRadialControls(Gateway gateway) { this.gateway=gateway; }
+    public void trigger(int button) { if (trigger!=button) { reset();trigger=button; } }
+    public void reset() { active=armed=openingArmed=stickArmed=selectedSpell=false;pending=captured=null;deadline=0;message=null;selected=0; }
+    public boolean active() { return active; }
+    public int selected() { return selected; }
+    public String message() { return message; }
+    public boolean canBind() { return captured!=null; }
+    public boolean selectedSpell() { return selectedSpell; }
+    public String label(int slot) { QuickBinding b=gateway.binding(slot);return b==null ? (slot==0?"Assign food":slot==1?"Assign potion":"Empty slot "+(slot+1)) : b.displayName(); }
+    public boolean update(GamepadState input,long now,UiState.Widget focus,UiState.Action action)
+    {
+        selectedSpell=false;
+        if (!openingArmed) { if ((input.buttonsHeld&trigger)==0) openingArmed=true; else return false; }
+        if (!active)
+        {
+            if ((input.buttonsPressed&trigger)==0 || !gateway.allowed()) return false;
+            active=true;armed=false;stickArmed=Math.hypot(input.leftX,input.leftY)<.35;
+            captured=QuickBinding.capture(focus,action);message=null;return true;
+        }
+        if (!gateway.allowed()) { reset();return true; }
+        if ((input.buttonsPressed&(2|trigger))!=0) { active=false;pending=null;return true; }
+        if (pending!=null)
+        {
+            if (now>=deadline) { pending=null;armed=false;message="Unavailable: missing item, spell or permission";return true; }
+            UiState state=gateway.snapshot();
+            UiState.Widget[] widgets=pending.group==149 ? state.inventory : panelWidgets(state.panel);
+            UiState.Widget chosen=null;UiState.Action chosenAction=null;int priority=Integer.MAX_VALUE;
+            for (UiState.Widget w:widgets)
+            {
+                UiState.Action nativeAction=pending.match(w);
+                if (nativeAction!=null && pending.priority(w)<priority)
+                { chosen=w;chosenAction=nativeAction;priority=pending.priority(w); }
+            }
+            if (chosen!=null)
+            {
+                boolean sent=gateway.invoke(chosen,chosenAction);
+                pending=null;armed=false;
+                if (sent) { selectedSpell=chosenAction.type==13;active=false; }
+                else message="Action changed or unavailable";
+                return true;
+            }
+            return true;
+        }
+        if (!armed) { if ((input.buttonsHeld&(1|4|8|(1<<9)|(1<<10)|(15<<11)))==0) armed=true;else return true; }
+        if (Math.hypot(input.leftX,input.leftY)<.35) stickArmed=true;
+        if (stickArmed && Math.hypot(input.leftX,input.leftY)>=.45)
+        {
+            double angle=Math.atan2(input.leftX,-input.leftY),step=Math.PI/4;
+            double distance=Math.abs(Math.atan2(Math.sin(angle-selected*step),Math.cos(angle-selected*step)));
+            if (distance>step/2+Math.toRadians(3)) { selected=Math.floorMod((int)Math.floor(angle/step+.5),8);message=null; }
+        }
+        int prev=input.buttonsPressed&((1<<9)|(1<<11)|(1<<13)),next=input.buttonsPressed&((1<<10)|(1<<12)|(1<<14));
+        if (prev!=0 && next==0) { selected=(selected+7)%8;message=null; }
+        if (next!=0 && prev==0) { selected=(selected+1)%8;message=null; }
+        if ((input.buttonsPressed&4)!=0)
+        {
+            if (captured!=null) { gateway.bind(selected,captured);message="Assigned "+captured.name; }
+            else message="Focus food, potion, prayer or spell first";
+            armed=false;
+        }
+        else if ((input.buttonsPressed&8)!=0) { gateway.restore(selected);message="Slot restored to default";armed=false; }
+        else if ((input.buttonsPressed&1)!=0)
+        {
+            pending=gateway.binding(selected);armed=false;
+            if (pending==null) message="Empty: focus an action, reopen wheel, press X";
+            else if (!gateway.openTab(pending.tab)) { pending=null;message="Tab unavailable here"; }
+            else { deadline=now+1_000_000_000L;message="Opening native action…"; }
+        }
+        return true;
+    }
+    private static UiState.Widget[] panelWidgets(UiState.Panel panel)
+    {
+        if (panel==null || panel.modal) return new UiState.Widget[0];
+        java.util.List<UiState.Widget> all=new java.util.ArrayList<>();
+        for (UiState.Pane pane:panel.panes) java.util.Collections.addAll(all,pane.widgets);
+        return all.toArray(new UiState.Widget[0]);
+    }
+}
