diff --git a/client/src/net/runelite/client/input/controller/QuickBinding.java b/client/src/net/runelite/client/input/controller/QuickBinding.java
new file mode 100644
index 0000000..153edf4
--- /dev/null
+++ b/client/src/net/runelite/client/input/controller/QuickBinding.java
@@ -0,0 +1,74 @@
+package net.runelite.client.input.controller;
+
+import java.nio.charset.StandardCharsets;
+import java.util.Base64;
+
+/** A user-selected native action, never a packet or a cached widget reference. */
+public final class QuickBinding
+{
+    public final int tab, group, item, type, operation;
+    public final String name, action;
+    private QuickBinding(int tab,int group,int item,int type,int operation,String name,String action)
+    { this.tab=tab; this.group=group; this.item=item; this.type=type;this.operation=operation; this.name=name; this.action=action; }
+    public static QuickBinding capture(UiState.Widget w,UiState.Action a)
+    {
+        if (w==null || a==null || a.selection!=0) return null;
+        int group=w.id>>>16;
+        if (group==149 && w.itemId>=0 && (a.type==18 || a.type==1011)
+            && (a.label.equalsIgnoreCase("Eat") || a.label.equalsIgnoreCase("Drink")))
+            return new QuickBinding(0,group,w.itemId,a.type,a.operation,w.name,a.label);
+        if (group==271 && (a.type==18 || a.type==1011) && prayer(a.label))
+            return new QuickBinding(HomeTab.PRAYER.ordinal(),group,w.id,a.type,a.operation,w.name,"Toggle");
+        if ((group==192 || group==193 || group==430) && (a.type==13 || a.type==18 || a.type==1011))
+            return new QuickBinding(HomeTab.SPELLBOOK.ordinal(),group,w.id,a.type,a.operation,w.name,a.label);
+        return null;
+    }
+    private static boolean prayer(String label)
+    { return label.equalsIgnoreCase("Activate") || label.equalsIgnoreCase("Deactivate"); }
+    public UiState.Action match(UiState.Widget w)
+    {
+        if (w==null || w.id>>>16!=group) return null;
+        if (group==149)
+        {
+            if (w.itemId<0) return null;
+            if (item>=0 && w.itemId!=item && !(action.equalsIgnoreCase("Drink") && family(w.name).equals(family(name)))) return null;
+        }
+        else if (w.id!=item || !w.name.equals(name)) return null;
+        for (UiState.Action a:w.actions)
+        {
+            if (a.selection!=0 || a.type!=type) continue;
+            if (action.equals("Toggle") && prayer(a.label) && (a.type==18 || a.type==1011)) return a;
+            if (a.operation==operation && a.label.equalsIgnoreCase(action) && (a.type==13 || a.type==18 || a.type==1011)) return a;
+        }
+        return null;
+    }
+    /** Prefer finishing a lower dose within the explicitly assigned potion family. */
+    public int priority(UiState.Widget w)
+    {
+        if (!action.equalsIgnoreCase("Drink")) return w.itemId==item?0:10;
+        java.util.regex.Matcher m=java.util.regex.Pattern.compile("\\(([1-9])\\)$").matcher(w.name);
+        return m.find()?Integer.parseInt(m.group(1)):10;
+    }
+    private static String family(String value) { return value.replaceAll("\\([1-9]\\)$", "").trim(); }
+    public String displayName() { return action.equalsIgnoreCase("Drink")?family(name):name; }
+    public String encode()
+    {
+        return "2:"+tab+":"+group+":"+item+":"+type+":"+operation+":"+encode(name)+":"+encode(action);
+    }
+    private static String encode(String s) { return Base64.getUrlEncoder().withoutPadding().encodeToString(s.getBytes(StandardCharsets.UTF_8)); }
+    private static String decodeText(String s) { return new String(Base64.getUrlDecoder().decode(s),StandardCharsets.UTF_8); }
+    public static QuickBinding decode(String value)
+    {
+        try
+        {
+            String[] parts=value.split(":",-1); if (parts.length!=8 || !parts[0].equals("2")) return null;
+            QuickBinding b=new QuickBinding(Integer.parseInt(parts[1]),Integer.parseInt(parts[2]),Integer.parseInt(parts[3]),Integer.parseInt(parts[4]),Integer.parseInt(parts[5]),decodeText(parts[6]),decodeText(parts[7]));
+            if (b.name.length()>120 || b.action.length()>120 || (b.type!=13 && b.type!=18 && b.type!=1011) || b.operation<0 || b.operation>10) return null;
+            if (b.group==149 && b.tab==0 && b.item>=0 && (b.type==18 || b.type==1011) && (b.action.equalsIgnoreCase("Eat") || b.action.equalsIgnoreCase("Drink"))) return b;
+            if (b.group==271 && b.tab==HomeTab.PRAYER.ordinal() && b.item>>>16==271 && (b.type==18 || b.type==1011) && b.action.equals("Toggle")) return b;
+            if ((b.group==192 || b.group==193 || b.group==430) && b.tab==HomeTab.SPELLBOOK.ordinal() && b.item>>>16==b.group && !b.action.isEmpty()) return b;
+        }
+        catch (RuntimeException malformed) { /* An invalid preference is an empty slot. */ }
+        return null;
+    }
+}
