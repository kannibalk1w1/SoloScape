+        return null;
+    }
+    private void guide(Graphics2D graphics)
+    {
+        Graphics2D g=(Graphics2D)graphics.create();
+        try
+        {
+            g.setFont(new Font(Font.SANS_SERIF,Font.PLAIN,(int)(13*plugin.config().overlayScale()/100.0)));
+            String[] lines=plugin.bindingWarning()!=null?new String[]{plugin.bindingWarning()}:new String[]{
+                "CONTROLLER GUIDE — hide in SoloScape Controller settings",
+                "Left stick: move / aim · Right stick: camera · LT: aim · Full tilt: direct-mode run",
+                "A: interact · X: actions · LB/RB: targets / panes · B: back / cancel",
+                plugin.config().homeButton()+": home tabs · "+plugin.config().quickButton()+": quick actions · "+plugin.config().inventoryButton()+": inventory",
+                "D-pad: UI focus / scroll · Production LB/RB: amount · A: make recipe",
+                "Quick slots: focus food, potion, prayer or spell; open quick wheel; X: assign · Y: restore",
+                "All slots start empty · Potion bindings use the lowest available dose · Plugin Reset restores controls"};
+            int max=Math.max(100,client.getCanvas().getWidth()-32),w=0,lineHeight=g.getFontMetrics().getHeight()+5;
+            for(String line:lines) w=Math.max(w,Math.min(max,g.getFontMetrics().stringWidth(plugin.config().glyphs().text(line))+20));
+            int y=Math.max(8,client.getCanvas().getHeight()-lines.length*lineHeight-20);
+            g.setColor(new Color(0,0,0,225));g.fillRoundRect(8,y,w,lines.length*lineHeight+12,10,10);g.setColor(Color.WHITE);
+            for(int i=0;i<lines.length;i++) centreFit(g,plugin.config().glyphs().text(lines[i]),18,y+lineHeight*(i+1),w-20,false);
+        }
+        finally { g.dispose(); }
+    }
+    public static void paint(Graphics2D graphics,int width,int height,QuickRadialControls quick,double scale,ControllerGlyphs glyphs)
+    {
+        Graphics2D g=(Graphics2D)graphics.create();
+        try
+        {
+            g.setRenderingHint(RenderingHints.KEY_ANTIALIASING,RenderingHints.VALUE_ANTIALIAS_ON);
+            g.setColor(new Color(0,0,0,115));g.fillRect(0,0,width,height);
+            double radius=Math.min(210*scale,Math.min(width/2.0-18,height/2.0-48));if(radius<80)return;
+            double cx=width/2.0,cy=height/2.0,inner=radius*.50,s=Math.min(scale,radius/210);
+            g.setFont(new Font(Font.SANS_SERIF,Font.BOLD,Math.max(10,(int)(13*s))));
+            for(int i=0;i<8;i++)
+            {
+                boolean selected=i==quick.selected();
+                Area wedge=new Area(new Arc2D.Double(cx-radius,cy-radius,2*radius,2*radius,90-i*45-21.5,43,Arc2D.PIE));
+                wedge.subtract(new Area(new Ellipse2D.Double(cx-inner,cy-inner,2*inner,2*inner)));
+                g.setColor(selected?new Color(137,105,39,245):new Color(31,29,26,240));g.fill(wedge);
+                g.setColor(selected?new Color(255,218,105):new Color(111,91,55));g.draw(wedge);
+                double angle=Math.toRadians(i*45);int x=(int)(cx+Math.sin(angle)*radius*.76),y=(int)(cy-Math.cos(angle)*radius*.76);
+                g.setColor(Color.WHITE);centreFit(g,quick.label(i),x,y,(int)(radius*.52),true);
+            }
+            g.setFont(new Font(Font.SANS_SERIF,Font.BOLD,Math.max(12,(int)(16*s))));g.setColor(new Color(255,218,105));
+            centreFit(g,quick.label(quick.selected()),(int)cx,(int)cy-16,(int)(inner*1.8),true);
+            g.setFont(new Font(Font.SANS_SERIF,Font.PLAIN,Math.max(10,(int)(12*s))));g.setColor(Color.WHITE);
+            centreFit(g,glyphs.text("A: use · B: back"),(int)cx,(int)cy+8,(int)(inner*1.8),true);
+            centreFit(g,glyphs.text("X: assign · Y: restore"),(int)cx,(int)cy+30,(int)(inner*1.8),true);
+            centreFit(g,"QUICK ACTIONS",(int)cx,(int)(cy-radius-14),width-30,true);
+            centreFit(g,quick.message()==null?(quick.canBind()?"Current action ready to assign":"Focus food, potion, prayer or spell to assign"):quick.message(),(int)cx,(int)(cy+radius+23),width-30,true);
+        }
