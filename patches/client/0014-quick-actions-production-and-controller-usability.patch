+package net.runelite.client.plugins.soloscapecontroller;
+
+/** The same face-button labels across controller overlays. */
+public enum ControllerGlyphs
+{
+    XBOX, PLAYSTATION;
+    public String text(String text)
+    {
+        if (text==null) return null;
+        String[] from={"A","B","X","Y"};
+        String[] to=this==PLAYSTATION?new String[]{"Cross","Circle","Square","Triangle"}:new String[]{"[A]","[B]","[X]","[Y]"};
+        for (int i=0;i<4;i++) text=text.replaceAll("\\b"+from[i]+"(?=[: ])",java.util.regex.Matcher.quoteReplacement(to[i]));
+        return text;
+    }
+}
