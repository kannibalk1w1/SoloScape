+
+public final class SoloScapeQuickRadialOverlay extends Overlay
+{
+    private final SoloScapeControllerPlugin plugin;
+    private final GameClient client;
+    @Inject SoloScapeQuickRadialOverlay(GameClient client,SoloScapeControllerPlugin plugin)
+    {
