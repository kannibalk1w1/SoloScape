+        setPosition(OverlayPosition.DYNAMIC);setLayer(OverlayLayer.ABOVE_WIDGETS);setPriority(OverlayPriority.HIGHEST);
+    }
+    @Override public Dimension render(Graphics2D g)
+    {
+        if (!plugin.isActive() || client.getCanvas()==null) return null;
+        if (plugin.getQuick().active()) paint(g,client.getCanvas().getWidth(),client.getCanvas().getHeight(),plugin.getQuick(),plugin.config().overlayScale()/100.0,plugin.config().glyphs());
