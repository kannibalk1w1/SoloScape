+++ b/client/src/net/runelite/client/plugins/soloscapecontroller/SoloScapeMovementOverlay.java
@@ -0,0 +1,68 @@
+package net.runelite.client.plugins.soloscapecontroller;
+
+import com.GameClient;
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.Dimension;
+import java.awt.Graphics2D;
+import java.awt.Polygon;
+import javax.inject.Inject;
+import net.runelite.api.Perspective;
+import net.runelite.api.coords.LocalPoint;
+import net.runelite.api.coords.WorldPoint;
+import net.runelite.client.ui.overlay.Overlay;
+import net.runelite.client.ui.overlay.OverlayLayer;
+import net.runelite.client.ui.overlay.OverlayPosition;
+import net.runelite.client.ui.overlay.OverlayUtil;
+
+/** Ground tiles stay anchored in the scene as the camera moves. */
+public final class SoloScapeMovementOverlay extends Overlay
+{
+    private static final Color DESTINATION = new Color(90, 255, 135);
+    private static final Color DESTINATION_FILL = new Color(90, 255, 135, 65);
+    private static final Color PLAYER = new Color(110, 210, 255, 180);
+    private static final Color PLAYER_FILL = new Color(110, 210, 255, 20);
+    private static final BasicStroke BORDER = new BasicStroke(2);
+    private final SoloScapeControllerPlugin plugin;
+    private final GameClient client;
+    private final SoloScapeControllerConfig config;
+
+    @Inject
+    SoloScapeMovementOverlay(SoloScapeControllerPlugin plugin, GameClient client, SoloScapeControllerConfig config)
+    {
+        super(plugin);
+        this.plugin = plugin;
+        this.client = client;
+        this.config = config;
+        setPosition(OverlayPosition.DYNAMIC);
+        setLayer(OverlayLayer.UNDER_WIDGETS);
+    }
+
+    @Override
+    public Dimension render(Graphics2D graphics)
+    {
+        if (!plugin.isActive() || !config.showMovementTiles() || !client.isControllerWorldReady()
+            || client.getCanvas() == null || !client.getCanvas().isFocusOwner()) return null;
+        // This is the validated destination from the native walk adapter, not stick prediction.
+        WorldPoint destination = client.getControllerWalkDestination();
+        if (destination == null) return null;
+        LocalPoint local = LocalPoint.fromWorld(client, destination);
+        if (local == null) return null;
+        Graphics2D draw = (Graphics2D) graphics.create();
+        try
+        {
+            // Native player coordinates use 512 units per tile; RuneLite uses 128.
+            LocalPoint player = LocalPoint.fromScene(client.getLocalPlayerLocalX() >> 9, client.getLocalPlayerLocalY() >> 9);
+            renderTile(draw, player, PLAYER, PLAYER_FILL);
+            renderTile(draw, local, DESTINATION, DESTINATION_FILL);
+        }
+        finally { draw.dispose(); }
+        return null;
+    }
+
+    private void renderTile(Graphics2D graphics, LocalPoint tile, Color outline, Color fill)
+    {
+        Polygon polygon = Perspective.getCanvasTilePoly(client, tile);
+        if (polygon != null) OverlayUtil.renderPolygon(graphics, polygon, outline, fill, BORDER);
+    }
+}
