+    private static void centre(Graphics2D draw, String text, int x, int y, int max)
+    {
+        String value = text;
+        if (draw.getFontMetrics().stringWidth(value) > max)
+        {
+            while (!value.isEmpty() && draw.getFontMetrics().stringWidth(value + "…") > max) value = value.substring(0, value.length() - 1);
+            value += "…";
+        }
+        ControllerTheme.text(draw, value, x - draw.getFontMetrics().stringWidth(value) / 2, y);
+    }
+    /** Largest size from {@code size} down to 10 that fits {@code max}; centre() ellipsizes anything still wider. */
+    private static void fitFont(Graphics2D draw, String text, int style, int size, int max)
+    {
+        for (int candidate = size; ; candidate--)
+        {
+            draw.setFont(new Font(Font.SANS_SERIF, style, candidate));
+            if (candidate <= 10 || draw.getFontMetrics().stringWidth(text) <= max) return;
+        }
+    }
 }
