new file mode 100644
--- /dev/null
+++ b/client/src/net/runelite/client/input/controller/TabBarControls.java
@@ -0,0 +1,128 @@
+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+
+/**
+ * D-pad left/right focus for the native bottom-right tab bar. From idle world input the first
+ * left/right press highlights a slot; further presses move the highlight in native visual order
+ * without opening anything. A fresh A press (never one held through a direction press) opens the
+ * highlighted tab; B leaves the bar. While focused the bar owns A, so A cannot act on the world.
+ */
+public final class TabBarControls
+{
+    public interface Gateway
+    {
+        int availableTabs();
+        /** Rendered bounds per {@link HomeTab} ordinal; null for slots not currently drawn. */
+        Rectangle[] tabBounds();
+        boolean openTab(int index);
+    }
+    private static final int A = 1, B = 2, UP = 1 << 11, DOWN = 1 << 12, LEFT = 1 << 13, RIGHT = 1 << 14;
+    private static final int DIRECTIONS = UP | DOWN | LEFT | RIGHT;
+    /** The revision-634 bar: top row left to right, then the bottom row. Used when bounds are missing. */
+    private static final HomeTab[] NATIVE_ORDER = {
+        HomeTab.COMBAT, HomeTab.TASKS, HomeTab.SKILLS, HomeTab.QUESTS, HomeTab.INVENTORY, HomeTab.EQUIPMENT, HomeTab.PRAYER, HomeTab.SPELLBOOK,
+        HomeTab.OBJECTIVES, HomeTab.FRIENDS, HomeTab.IGNORE, HomeTab.CLAN, HomeTab.SETTINGS, HomeTab.EMOTES, HomeTab.MUSIC, HomeTab.NOTES};
+    private final Gateway gateway;
+    private boolean active, confirmArmed;
+    private int selected = -1, opened = -1;
+    private int[] order = new int[0];
+    private volatile Rectangle highlight;
+    private long refreshAt;
+    private String message;
+
+    public TabBarControls(Gateway gateway) { this.gateway = gateway; }
+    public boolean active() { return active; }
+    /** The highlighted {@link HomeTab} ordinal, or -1. */
+    public int selected() { return active ? selected : -1; }
+    /** Bounds of the highlighted slot as last rendered, for the overlay; null when unknown or inactive. */
+    public Rectangle highlight() { return active ? highlight : null; }
+    public String message() { return message; }
+    /** The tab opened by the last confirm, consumed once so the caller can focus its controller UI. */
+    public int takeOpened() { int tab = opened; opened = -1; return tab; }
+    public void reset() { active = confirmArmed = false; selected = opened = -1; order = new int[0]; highlight = null; refreshAt = 0; message = null; }
+
+    /**
+     * @param idle true only when world input owns the controller: no UI focus, world menu, item
+     *             selection, radial or keyboard. Entry is refused otherwise; an active bar exits.
+     * @return true when the bar consumed this tick's input.
+     */
+    public boolean update(GamepadState input, long now, boolean idle)
+    {
+        int pressed = input.buttonsPressed, horizontal = pressed & (LEFT | RIGHT);
+        boolean single = horizontal == LEFT || horizontal == RIGHT;
+        if (!active)
+        {
+            // Only an unambiguous fresh left/right press from idle world input enters the bar.
+            if (!idle || !single || (input.buttonsHeld & (UP | DOWN)) != 0) return false;
+            if (!refresh(now)) return false;
+            int start = indexOf(HomeTab.INVENTORY.ordinal());
+            if (start < 0) start = horizontal == RIGHT ? 0 : order.length - 1;
+            selected = order[start]; active = true; message = null; opened = -1;
+            confirmArmed = false; // A held with the entering press must be released first.
+            highlight = bounds(selected);
+            return true;
+        }
+        if (!idle) { reset(); return false; }
+        if (now >= refreshAt && !refresh(now)) { reset(); return false; }
+        if ((pressed & B) != 0) { reset(); return true; }
+        if ((input.buttonsHeld & A) == 0) confirmArmed = true;
+        if (single)
+        {
+            int at = indexOf(selected);
+            at = at < 0 ? 0 : Math.floorMod(at + (horizontal == RIGHT ? 1 : -1), order.length);
+            selected = order[at]; highlight = bounds(selected); message = null;
+            // A pressed or still held together with a direction never confirms the new slot.
+            if ((input.buttonsHeld & A) != 0) confirmArmed = false;
+            return true;
+        }
+        if ((pressed & DIRECTIONS) == 0 && (pressed & A) != 0 && confirmArmed)
+        {
+            confirmArmed = false;
+            if (gateway.openTab(selected)) { int tab = selected; reset(); opened = tab; }
+            else message = "Tab unavailable here";
+        }
+        return true;
+    }
+
+    private boolean refresh(long now)
+    {
+        refreshAt = now + 100_000_000L;
+        int available = gateway.availableTabs();
+        Rectangle[] bounds = gateway.tabBounds();
+        int count = 0;
+        int[] candidates = new int[NATIVE_ORDER.length];
+        boolean measured = true;
+        for (HomeTab tab : NATIVE_ORDER)
+        {
+            int index = tab.ordinal();
+            if ((available & (1 << index)) == 0) continue;
+            candidates[count++] = index;
+            if (bounds == null || index >= bounds.length || bounds[index] == null) measured = false;
+        }
+        int[] next = java.util.Arrays.copyOf(candidates, count);
+        if (measured && count > 1)
+        {
+            // Native visual order: rows top to bottom (slots within half a slot height share a row), then left to right.
+            Integer[] boxed = new Integer[count];
+            for (int i = 0; i < count; i++) boxed[i] = next[i];
+            java.util.Arrays.sort(boxed, (a, b) -> {
+                Rectangle p = bounds[a], q = bounds[b];
+                int row = Math.max(1, Math.min(p.height, q.height) / 2);
+                if (Math.abs(p.getCenterY() - q.getCenterY()) >= row) return Double.compare(p.getCenterY(), q.getCenterY());
+                return Double.compare(p.getCenterX(), q.getCenterX());
+            });
+            for (int i = 0; i < count; i++) next[i] = boxed[i];
+        }
+        order = next;
+        if (active && count > 0 && indexOf(selected) < 0) selected = order[0];
+        if (active) highlight = bounds(selected, bounds);
+        return count > 0;
+    }
+    private int indexOf(int tab) { for (int i = 0; i < order.length; i++) if (order[i] == tab) return i; return -1; }
+    private Rectangle bounds(int tab) { return bounds(tab, gateway.tabBounds()); }
+    private static Rectangle bounds(int tab, Rectangle[] all)
+    { return all == null || tab < 0 || tab >= all.length || all[tab] == null ? null : new Rectangle(all[tab]); }
+    /** Visible order for tests and diagnostics. */
+    public int[] order() { return order.clone(); }
+}
