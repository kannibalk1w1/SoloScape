+package net.runelite.client.plugins.soloscapecontroller;
+
+import com.GameClient;
+import java.awt.*;
+import javax.inject.Inject;
+import net.runelite.client.input.controller.HomeTab;
+import net.runelite.client.input.controller.TabBarControls;
+import net.runelite.client.ui.overlay.*;
+
+/** Highlights the native tab slot that D-pad focus has selected, with a classic tooltip naming it. */
+public final class SoloScapeTabBarOverlay extends Overlay
+{
+    private final SoloScapeControllerPlugin plugin;
+    private final GameClient client;
+    @Inject SoloScapeTabBarOverlay(SoloScapeControllerPlugin plugin,GameClient client)
+    {
+        super(plugin);this.plugin=plugin;this.client=client;
+        setPosition(OverlayPosition.DYNAMIC);setLayer(OverlayLayer.ABOVE_WIDGETS);setPriority(OverlayPriority.HIGH);
+    }
+    @Override public Dimension render(Graphics2D graphics)
+    {
+        TabBarControls bar=plugin.getTabBar();
+        if(!plugin.isActive()||!bar.active()||client.getCanvas()==null)return null;
+        int tab=bar.selected();
+        paint(graphics,bar.highlight(),tab<0?"":HomeTab.values()[tab].label,client.getCanvas().getWidth(),client.getCanvas().getHeight(),plugin.config().overlayScale()/100.0);
+        return null;
+    }
+    /** Static so renderer fixtures can draw it; {@code slot} is the native widget's rendered bounds. */
+    public static void paint(Graphics2D graphics,Rectangle slot,String label,int canvasWidth,int canvasHeight,double scale)
+    {
+        if(slot==null)return;
+        Graphics2D g=(Graphics2D)graphics.create();
+        try
+        {
+            g.setColor(new Color(255,255,0,45));g.fill(slot);
+            g.setStroke(new BasicStroke(3));g.setColor(Color.BLACK);g.drawRect(slot.x-1,slot.y-1,slot.width+1,slot.height+1);
+            g.setStroke(new BasicStroke(1));g.setColor(ControllerTheme.FOCUS);g.drawRect(slot.x-1,slot.y-1,slot.width+1,slot.height+1);
+            if(label.isEmpty())return;
+            g.setFont(ControllerTheme.body(scale));FontMetrics metrics=g.getFontMetrics();
+            int width=metrics.stringWidth(label)+10,height=metrics.getHeight()+4;
+            // Above the slot like a native hover tooltip, kept on the canvas.
+            int x=Math.max(2,Math.min(slot.x+(slot.width-width)/2,canvasWidth-width-2));
+            int y=slot.y-height-4<2?Math.min(canvasHeight-height-2,slot.y+slot.height+4):slot.y-height-4;
+            ControllerTheme.label(g,x,y,width,height);
+            if(ControllerTheme.classic())g.setRenderingHint(RenderingHints.KEY_TEXT_ANTIALIASING,RenderingHints.VALUE_TEXT_ANTIALIAS_OFF);
+            g.setColor(ControllerTheme.TOOLTIP_TEXT);g.drawString(label,x+5,y+2+metrics.getAscent());
+        }
+        finally{g.dispose();}
+    }
+}
diff --git a/client/test/net/runelite/client/input/controller/TabBarControlsTest.java b/client/test/net/runelite/client/input/controller/TabBarControlsTest.java
new file mode 100644
