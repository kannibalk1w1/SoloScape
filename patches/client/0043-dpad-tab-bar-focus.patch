+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+import java.util.ArrayList;
+import java.util.List;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class TabBarControlsTest {
+    private static final int A=1,B=2,UP=1<<11,LEFT=1<<13,RIGHT=1<<14;
+    private static final class Fake implements TabBarControls.Gateway {
+        int available=~0;Rectangle[] bounds=bar();final List<Integer> opened=new ArrayList<>();boolean accept=true;
+        public int availableTabs(){return available;}
+        public Rectangle[] tabBounds(){return bounds;}
+        public boolean openTab(int index){opened.add(index);return accept;}
+    }
+    /** The resized 634 bar: two rows of eight; the map orb and logout sit elsewhere on screen. */
+    private static Rectangle[] bar() {
+        Rectangle[] bounds=new Rectangle[HomeTab.values().length];
+        HomeTab[] top={HomeTab.COMBAT,HomeTab.TASKS,HomeTab.SKILLS,HomeTab.QUESTS,HomeTab.INVENTORY,HomeTab.EQUIPMENT,HomeTab.PRAYER,HomeTab.SPELLBOOK};
+        HomeTab[] bottom={HomeTab.OBJECTIVES,HomeTab.FRIENDS,HomeTab.IGNORE,HomeTab.CLAN,HomeTab.SETTINGS,HomeTab.EMOTES,HomeTab.MUSIC,HomeTab.NOTES};
+        for(int i=0;i<8;i++){bounds[top[i].ordinal()]=new Rectangle(1000+i*30,700,30,36);bounds[bottom[i].ordinal()]=new Rectangle(1000+i*30,738,30,36);}
+        bounds[HomeTab.MAP.ordinal()]=new Rectangle(1200,40,40,40);bounds[HomeTab.LOGOUT.ordinal()]=new Rectangle(1240,0,20,20);
+        return bounds;
+    }
+    private static GamepadState input(int held,int pressed){GamepadState s=new GamepadState();s.buttonsHeld=held;s.buttonsPressed=pressed;return s;}
+    private static boolean tick(TabBarControls bar,int held,int pressed,boolean idle){return bar.update(input(held,pressed),System.nanoTime(),idle);}
+
+    @Test public void onlyAFreshLeftRightPressFromIdleWorldInputEnters() {
+        Fake fake=new Fake();TabBarControls bar=new TabBarControls(fake);
+        assertFalse(tick(bar,RIGHT,RIGHT,false));assertFalse(bar.active());
+        assertFalse(tick(bar,UP,UP,true));assertFalse(bar.active());
+        assertFalse(tick(bar,LEFT|RIGHT,LEFT|RIGHT,true));assertFalse(bar.active());
+        assertFalse(tick(bar,RIGHT,0,true));assertFalse("a held direction is not a fresh press",bar.active());
+        fake.available=0;assertFalse(tick(bar,RIGHT,RIGHT,true));assertFalse("hidden bar (dialogue/modal) refuses entry",bar.active());
+        fake.available=~0;assertTrue(tick(bar,RIGHT,RIGHT,true));
+        assertTrue(bar.active());assertEquals(HomeTab.INVENTORY.ordinal(),bar.selected());
+        assertEquals(new Rectangle(1120,700,30,36),bar.highlight());
+        assertTrue("entering never opens a tab",fake.opened.isEmpty());
+    }
+    @Test public void cyclesInNativeVisualOrderSkippingUnavailableAndOffBarSlots() {
+        Fake fake=new Fake();fake.available=~(1<<HomeTab.EQUIPMENT.ordinal());TabBarControls bar=new TabBarControls(fake);
+        tick(bar,RIGHT,RIGHT,true);tick(bar,0,0,true);
+        int[] order=bar.order();
+        assertEquals(15,order.length);
+        assertEquals(HomeTab.COMBAT.ordinal(),order[0]);assertEquals(HomeTab.SPELLBOOK.ordinal(),order[6]);
+        assertEquals(HomeTab.OBJECTIVES.ordinal(),order[7]);assertEquals(HomeTab.NOTES.ordinal(),order[14]);
+        for(int tab:order){assertNotEquals(HomeTab.MAP.ordinal(),tab);assertNotEquals(HomeTab.LOGOUT.ordinal(),tab);}
+        tick(bar,RIGHT,RIGHT,true);assertEquals("unavailable equipment skipped",HomeTab.PRAYER.ordinal(),bar.selected());
+        tick(bar,0,0,true);tick(bar,LEFT,LEFT,true);tick(bar,0,0,true);tick(bar,LEFT,LEFT,true);
+        assertEquals(HomeTab.QUESTS.ordinal(),bar.selected());
+        for(int i=0;i<4;i++){tick(bar,0,0,true);tick(bar,LEFT,LEFT,true);}
+        assertEquals("wraps from the first slot to the last",HomeTab.NOTES.ordinal(),bar.selected());
+        assertTrue(fake.opened.isEmpty());
+    }
+    @Test public void heldOrSimultaneousAIsIgnoredAndOnlyAFreshConfirmOpens() {
+        Fake fake=new Fake();TabBarControls bar=new TabBarControls(fake);
+        assertTrue(tick(bar,RIGHT|A,RIGHT|A,true));
+        assertTrue(tick(bar,A,0,true));
+        assertTrue(fake.opened.isEmpty());
+        tick(bar,A|RIGHT,RIGHT,true);assertEquals(HomeTab.EQUIPMENT.ordinal(),bar.selected());
+        tick(bar,A,A,true);assertTrue("A held through cycling never confirms",fake.opened.isEmpty());
+        tick(bar,0,0,true);
+        tick(bar,A|LEFT,A|LEFT,true);assertTrue("A with a direction never confirms",fake.opened.isEmpty());
+        tick(bar,0,0,true);
+        assertTrue(tick(bar,A,A,true));
+        assertEquals(java.util.Collections.singletonList(HomeTab.INVENTORY.ordinal()),fake.opened);
+        assertFalse(bar.active());assertEquals(HomeTab.INVENTORY.ordinal(),bar.takeOpened());assertEquals(-1,bar.takeOpened());
+    }
+    @Test public void bExitsAndForeignFocusOrHiddenBarReleasesWithoutConsuming() {
+        Fake fake=new Fake();TabBarControls bar=new TabBarControls(fake);
+        tick(bar,RIGHT,RIGHT,true);
+        assertTrue("B belongs to the bar, not a world cancel",tick(bar,B,B,true));assertFalse(bar.active());
+        assertFalse("held B after leaving is not re-consumed",tick(bar,B,0,true));
+        tick(bar,LEFT,LEFT,true);assertTrue(bar.active());
+        assertFalse("another UI owner takes over the same tick",tick(bar,8,8,false));assertFalse(bar.active());
+        tick(bar,LEFT,LEFT,true);fake.available=0;
+        assertFalse(bar.update(input(0,0),System.nanoTime()+200_000_000L,true));assertFalse(bar.active());
+    }
+    @Test public void refusedOpenKeepsFocusWithFeedbackAndFallbackOrderWithoutBounds() {
+        Fake fake=new Fake();fake.accept=false;fake.bounds=new Rectangle[0];TabBarControls bar=new TabBarControls(fake);
+        tick(bar,LEFT,LEFT,true);tick(bar,0,0,true);
+        assertEquals(HomeTab.COMBAT.ordinal(),bar.order()[0]);assertNull(bar.highlight());
+        tick(bar,A,A,true);
+        assertTrue(bar.active());assertEquals("Tab unavailable here",bar.message());assertEquals(-1,bar.takeOpened());
+    }
+}
