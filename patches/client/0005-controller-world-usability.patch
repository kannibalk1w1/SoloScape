+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState state = new GamepadState();
+        controls.update(state, .18f, 1);
+        state.updateButtons(1 << 10); controls.update(state, .18f, 20_000_001);
+        assertEquals(1, game.cycles); assertEquals(1, game.direction);
+        state.updateButtons(1 << 10); controls.update(state, .18f, 30_000_001);
+        assertEquals(1, game.cycles);
+        state.updateButtons(1 << 9); controls.update(state, .18f, 40_000_001);
+        assertEquals(2, game.cycles); assertEquals(-1, game.direction);
+    }
+
+    @Test public void newDirectionResumesWalkingWithoutNeedingNeutralAfterAction()
+    {
+        Fake game = new Fake(); WorldControls controls = new WorldControls(game); GamepadState state = new GamepadState();
+        controls.update(state, .18f, 1); state.leftX = 1; state.updateButtons(1);
+        controls.update(state, .18f, 20_000_001);
+        state.updateButtons(0); controls.update(state, .18f, 200_000_001);
+        assertEquals(0, game.walks);
+        state.leftX = 0; state.leftY = -1;
+        controls.update(state, .18f, 210_000_001);
+        assertEquals(1, game.walks);
+    }
+
+    @Test public void entityIdentitySurvivesNpcMovementButNotRegionOrSpawnChanges()
+    {
+        ControllerTarget npc = new ControllerTarget("Guide", "Talk-to", 25, 2, 5, 6, 0, 1000, 1000);
+        ControllerTarget moved = new ControllerTarget("Guide", "Talk-to", 25, 2, 6, 6, 0, 1000, 1000);
+        assertTrue(npc.sameEntity(moved)); assertFalse(npc.same(moved));
+        assertFalse(npc.sameEntity(new ControllerTarget("Guide", "Talk-to", 25, 3, 6, 6, 0, 1000, 1000)));
+        assertFalse(npc.sameEntity(new ControllerTarget("Guide", "Talk-to", 25, 2, 6, 6, 0, 1100, 1000)));
+    }
 }
