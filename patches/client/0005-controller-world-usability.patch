diff --git a/client/src/net/runelite/client/plugins/soloscapecontroller/SoloScapeTargetOverlay.java b/client/src/net/runelite/client/plugins/soloscapecontroller/SoloScapeTargetOverlay.java
new file mode 100644
--- /dev/null
+++ b/client/src/net/runelite/client/plugins/soloscapecontroller/SoloScapeTargetOverlay.java
@@ -0,0 +1,62 @@
+package net.runelite.client.plugins.soloscapecontroller;
+
+import com.GameClient;
+import com.GameClient.ControllerTarget;
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.Dimension;
+import java.awt.Graphics2D;
+import java.awt.Polygon;
+import java.awt.Rectangle;
+import javax.inject.Inject;
+import net.runelite.api.Perspective;
+import net.runelite.api.coords.LocalPoint;
+import net.runelite.client.ui.overlay.Overlay;
+import net.runelite.client.ui.overlay.OverlayLayer;
+import net.runelite.client.ui.overlay.OverlayPosition;
+import net.runelite.client.ui.overlay.OverlayUtil;
+
+/** The highlighted footprint is the entity that the next A press will act on. */
+public final class SoloScapeTargetOverlay extends Overlay
+{
+    private final SoloScapeControllerPlugin plugin;
+    private final GameClient client;
+
+    @Inject
+    SoloScapeTargetOverlay(SoloScapeControllerPlugin plugin, GameClient client)
+    {
+        super(plugin);
+        this.plugin = plugin;
+        this.client = client;
+        setPosition(OverlayPosition.DYNAMIC);
+        setLayer(OverlayLayer.UNDER_WIDGETS);
+    }
+
+    @Override
+    public Dimension render(Graphics2D graphics)
+    {
+        ControllerTarget target = plugin.getTarget();
+        if (target == null || !client.isControllerWorldReady() || client.getCanvas() == null
+            || !client.getCanvas().isFocusOwner() || target.plane != client.getPlane()
+            || target.baseX != client.getBaseX() || target.baseY != client.getBaseY()) return null;
+        LocalPoint center = new LocalPoint(target.x * 128 + target.width * 64, target.y * 128 + target.height * 64);
+        Polygon footprint = Perspective.getCanvasTileAreaPoly(client, center, target.width, target.height, target.plane, 0);
+        if (footprint == null) return null;
+        Graphics2D draw = (Graphics2D) graphics.create();
+        try
+        {
+            Color gold = new Color(255, 215, 75);
+            OverlayUtil.renderPolygon(draw, footprint, gold, new Color(255, 215, 75, 55), new BasicStroke(3));
+            String label = "A: " + target.option + " " + target.name;
+            Rectangle bounds = footprint.getBounds();
+            int width = draw.getFontMetrics().stringWidth(label), height = draw.getFontMetrics().getHeight();
+            int x = bounds.x + (bounds.width - width) / 2, y = bounds.y - 8;
+            draw.setColor(new Color(0, 0, 0, 190));
+            draw.fillRoundRect(x - 5, y - draw.getFontMetrics().getAscent() - 3, width + 10, height + 4, 6, 6);
+            draw.setColor(gold);
+            draw.drawString(label, x, y);
+        }
+        finally { draw.dispose(); }
+        return null;
+    }
+}
