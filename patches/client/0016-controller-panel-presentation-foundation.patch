+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+
+/** Presentation-only bounds. Native identity, quantities, actions and selection tokens survive unchanged. */
+public final class PanelPresentation
+{
+    public final Rectangle bounds, content;
+    public final int columns, rows, pageSize;
+    public final double scale;
+    public PanelPresentation(int width, int height, double requestedScale)
+    {
+        scale = Math.max(.5, Math.min(requestedScale, Math.min((width-24.0)/720, (height-24.0)/460)));
+        bounds = new Rectangle((width-(int)(720*scale))/2, (height-(int)(460*scale))/2, (int)(720*scale), (int)(460*scale));
+        content = new Rectangle(bounds.x+(int)(16*scale), bounds.y+(int)(58*scale), (int)(500*scale), (int)(336*scale));
+        columns = 4; rows = 7; pageSize = columns*rows;
+    }
+    public UiState present(UiState nativeState, UiState.Widget selected, boolean inventory, boolean equipment, boolean bank, boolean shop)
+    {
+        UiState.Widget[] items = inventory ? grid(nativeState.inventory, 0) : nativeState.inventory;
+        UiState.Panel panel = nativeState.panel;
+        if (panel != null && supported(panel.id,equipment,bank,shop))
+        {
+            UiState.Pane[] panes = new UiState.Pane[panel.panes.length];
+            for (int p=0;p<panes.length;p++)
+            {
+                UiState.Widget[] widgets = panel.panes[p].widgets;
+                int page = page(widgets, selected);
+                panes[p] = new UiState.Pane(panel.panes[p].name,grid(widgets,page));
+            }
+            panel = new UiState.Panel(panel.id,panel.frame,panel.name,panes,panel.modal);
+        }
+        return new UiState(items,nativeState.dialogue,nativeState.dialogueId,nativeState.inventoryVisible,panel,nativeState.entry,nativeState.amounts,nativeState.amount);
+    }
+    public static boolean supported(int id, boolean equipment, boolean bank, boolean shop)
+    { return equipment&&(id==387||id==667) || bank&&(id==762||id==11) || shop&&id==620; }
+    public int page(UiState.Widget[] widgets, UiState.Widget selected)
+    {
+        if (selected != null) for (int i=0;i<widgets.length;i++) if (selected.same(widgets[i])) return i/pageSize;
+        return 0;
+    }
+    private UiState.Widget[] grid(UiState.Widget[] widgets,int page)
+    {
+        UiState.Widget[] result = new UiState.Widget[widgets.length];
+        int cellWidth = content.width/columns, cellHeight=content.height/rows;
+        for (int i=0;i<widgets.length;i++)
+        {
+            UiState.Widget widget=widgets[i]; if (widget==null) continue;
+            // Off-page rows remain in the spatial model so navigation crosses pages naturally.
+            Rectangle position=new Rectangle(content.x+i%columns*cellWidth,content.y+(i/columns-page*rows)*cellHeight,cellWidth-4,cellHeight-4);
+            result[i]=new UiState.Widget(widget.id,widget.child,widget.itemId,widget.quantity,widget.name,position,widget.actions);
+        }
+        return result;
+    }
+    public boolean visible(UiState.Widget widget) { return widget!=null && content.contains(widget.bounds); }
+}
