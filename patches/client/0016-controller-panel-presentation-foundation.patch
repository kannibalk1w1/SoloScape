+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class PanelPresentationTest
+{
+    private UiState.Widget item(int index,int amount)
+    { return new UiState.Widget(149<<16,index,100+index,amount,"Item "+index,new Rectangle(1,2,32,32),new UiState.Action[]{new UiState.Action("Drop",18,5,77)}); }
+    @Test public void presentationFitsSmallAndDeckCanvasesWithoutChangingNativeIntent()
+    {
+        for(int[] size:new int[][]{{765,503},{1280,800},{1024,600}})
+        {
+            UiState.Widget[] inventory=new UiState.Widget[28]; for(int i=0;i<28;i++)inventory[i]=item(i,1);
+            PanelPresentation view=new PanelPresentation(size[0],size[1],1.75);
+            assertTrue(new Rectangle(0,0,size[0],size[1]).contains(view.bounds));
+            UiState translated=view.present(new UiState(inventory,new UiState.Widget[0],-1),null,true,false,false,false);
+            for(int i=0;i<28;i++){assertTrue(view.visible(translated.inventory[i]));assertTrue(inventory[i].same(translated.inventory[i]));assertSame(inventory[i].actions,translated.inventory[i].actions);}
+            assertEquals(new Rectangle(1,2,32,32),inventory[0].bounds);
+        }
+    }
+    @Test public void bankFocusCrossesCustomPagesAndFallbackKeepsNativeBounds()
+    {
+        UiState.Widget[] widgets=new UiState.Widget[60];for(int i=0;i<60;i++)widgets[i]=item(i,10);
+        UiState nativeState=new UiState(new UiState.Widget[28],new UiState.Widget[0],-1,true,new UiState.Panel(762,123,"Bank",new UiState.Pane[]{new UiState.Pane("Stored",widgets)}));
+        PanelPresentation view=new PanelPresentation(765,503,1);
+        UiState presented=view.present(nativeState,widgets[35],false,false,true,false);
+        assertEquals(123,presented.panel.frame);assertTrue(view.visible(presented.panel.panes[0].widgets[35]));assertFalse(view.visible(presented.panel.panes[0].widgets[0]));
+        assertSame(nativeState.panel,view.present(nativeState,widgets[35],false,false,false,false).panel);
+    }
+    @Test public void changedItemOrQuantityAndExpiredConfirmationCannotDropTheOldIntent()
+    {
+        PanelConfirmation confirmation=new PanelConfirmation();UiState.Widget one=item(1,1),changed=item(1,2);
+        assertFalse(confirmation.allow(one,one.actions[0],0));
+        assertFalse(confirmation.allow(changed,changed.actions[0],10));
+        assertTrue(confirmation.allow(changed,changed.actions[0],20));
+        assertFalse(confirmation.allow(one,one.actions[0],30));
+        assertFalse(confirmation.allow(one,one.actions[0],4_000_000_000L));
+        confirmation.clear();assertNull(confirmation.prompt(one,4_000_000_001L));
+    }
+}
