+package net.runelite.client.input.controller;
+
+/** A second distinct press confirms destructive item actions against the same native token. */
+public final class PanelConfirmation
+{
+    private UiState.Widget widget;
+    private UiState.Action action;
+    private long until;
+    public void clear() { widget=null;action=null;until=0; }
+    public boolean allow(UiState.Widget expected,UiState.Action requested,long now)
+    {
+        boolean destructive=requested.label.equalsIgnoreCase("Drop") || requested.label.toLowerCase(java.util.Locale.ROOT).startsWith("destroy");
+        if (!destructive) { clear();return true; }
+        if (now<until && expected.same(widget) && requested.same(action)) { clear();return true; }
+        widget=expected;action=requested;until=now+3_000_000_000L;return false;
+    }
+    public String prompt(UiState.Widget focused,long now)
+    {
+        if (widget==null || now>=until || !widget.same(focused)) { clear();return null; }
+        return "A: confirm "+action.label+" "+widget.name+" · B: cancel";
+    }
+}
