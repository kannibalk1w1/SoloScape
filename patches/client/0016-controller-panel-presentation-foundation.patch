+import java.io.File;
+import java.lang.reflect.Field;
+import java.nio.file.*;
+import java.util.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class OwnedCacheTest
+{
+    @Test public void ownedCachePreservesNativeSectorZeroSentinelAndNeverFallsBack() throws Exception
+    {
+        Path root=Files.createTempDirectory("soloscape-owned-cache-"); String old=System.getProperty("soloscape.cache.root");
+        Field tableField=Class201.class.getDeclaredField("aHashtable2642");tableField.setAccessible(true);
+        Hashtable table=(Hashtable)tableField.get(null); Hashtable previous=(Hashtable)table.clone();
+        try
+        {
+            table.clear();System.setProperty("soloscape.cache.root",root.toString());Class201.method1465((byte)-121,"fixture",1);
+            File cache=Class201.method1464(0,1,"main_file_cache.dat2","fixture");
+            assertTrue(cache.toPath().startsWith(root));assertEquals(1,cache.length());assertEquals(255,Files.readAllBytes(cache.toPath())[0]&255);
+            try { Class201.method1464(0,1,"../escape",null);fail("Unsafe file path accepted"); } catch(IllegalArgumentException expected) { }
+            Path outside=Files.createTempDirectory("soloscape-cache-outside-");
+            try
+            {
+                Files.createSymbolicLink(root.resolve("store-2"),outside);
+                try { Class201.method1464(0,2,"other.dat",null);fail("Linked store accepted"); } catch(IllegalStateException expected) { }
+                assertEquals(0,outside.toFile().list() .length);
+            } finally { Files.deleteIfExists(root.resolve("store-2"));Files.deleteIfExists(outside); }
+        }
+        finally
+        {
+            table.clear();table.putAll(previous);if(old==null)System.clearProperty("soloscape.cache.root");else System.setProperty("soloscape.cache.root",old);
+            try(java.util.stream.Stream<Path> files=Files.walk(root)) { files.sorted(Comparator.reverseOrder()).forEach(path->{try{Files.delete(path);}catch(Exception ex){throw new RuntimeException(ex);}}); }
+        }
+    }
+}
