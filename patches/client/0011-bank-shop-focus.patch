+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class PanelControlsTest
+{
+    private static UiState.Widget item(int id, int slot, int x, int y, int quantity, String... labels)
+    {
+        UiState.Action[] actions = new UiState.Action[labels.length];
+        for (int i = 0; i < labels.length; i++) actions[i] = new UiState.Action(labels[i], 18, i + 1);
+        return new UiState.Widget(id, slot, 100 + slot, quantity, "Item", new Rectangle(x,y,32,32), actions);
+    }
+    private static class Fake implements UiControls.Gateway
+    {
+        int invoked, closed, scrolled;
+        UiState.Action action;
+        public UiState snapshot() { return UiState.EMPTY; }
+        public boolean openInventory() { return false; }
+        public boolean invoke(UiState.Widget w, UiState.Action a) { invoked++; action = a; return true; }
+        public void cancelSelection() {}
+        public void cancelDialogue() { closed++; }
+        public boolean scroll(UiState.Widget w, int d) { scrolled++; return true; }
+    }
+    private static UiState.Panel shop(UiState.Widget... widgets)
+    {
+        return new UiState.Panel(620,"Shop",new UiState.Pane[]{new UiState.Pane("Stock",widgets),
+            new UiState.Pane("Inventory",new UiState.Widget[]{item(621<<16,0,600,100,1,"Value","Sell 1")})});
+    }
+    private static void press(PanelControls ui, UiState.Panel panel, GamepadState input, int mask, long now)
+    {
+        input.updateButtons(0); ui.update(panel,input,now);
+        input.updateButtons(mask); ui.update(panel,input,now+1);
+    }
+    @Test public void openingConsumesHeldWorldAAndShopDefaultsBuyOrSellInsteadOfInfo()
+    {
+        Fake game=new Fake(); PanelControls ui=new PanelControls(game); GamepadState input=new GamepadState();
+        UiState.Panel state=shop(item(620<<16|25,0,100,100,10,"Info","Buy 1","Buy 5"));
+        input.updateButtons(1); ui.update(state,input,1); assertEquals(0,game.invoked);
+        press(ui,state,input,1,10); assertEquals("Buy 1",game.action.label);
+        press(ui,state,input,1<<10,20); assertEquals(621<<16,ui.focus().id);
+        press(ui,state,input,1,30); assertEquals("Sell 1",game.action.label);
+    }
+    @Test public void changedQuantityInvalidatesOpenActionMenuAndBFirstBackThenCloses()
+    {
+        Fake game=new Fake(); PanelControls ui=new PanelControls(game); GamepadState input=new GamepadState();
+        UiState.Panel state=shop(item(620<<16|25,0,100,100,10,"Info","Buy 1","Buy 5"));
+        ui.update(state,input,1); press(ui,state,input,4,10); assertNotNull(ui.context());
+        UiState.Panel changed=shop(item(620<<16|25,0,100,100,9,"Info","Buy 1","Buy 5"));
+        input.updateButtons(0); ui.update(changed,input,20); assertNull(ui.context());
+        press(ui,changed,input,4,30); press(ui,changed,input,2,40); assertNull(ui.context()); assertEquals(0,game.closed);
+        press(ui,changed,input,2,50); assertEquals(1,game.closed);
+        press(ui,changed,input,1,60); assertEquals(0,game.invoked);
+        assertFalse(ui.update(null,input,70));
+    }
+    @Test public void spatialNavigationStaysInColumnAndUsesActualBounds()
+    {
+        UiState.Widget origin=item(1,0,100,100,1,"A");
+        UiState.Widget diagonal=item(1,1,140,130,1,"A"), below=item(1,2,100,145,1,"A");
+        assertSame(below,PanelControls.neighbor(origin,new UiState.Widget[]{origin,diagonal,below},12));
+        assertNull(PanelControls.neighbor(origin,new UiState.Widget[]{origin,below},11));
+    }
+    @Test public void edgeScrollTransfersFocusToNewlyVisibleRowAndDoesNotInvokeHeldA()
+    {
+        Fake game=new Fake(); PanelControls ui=new PanelControls(game); GamepadState input=new GamepadState();
+        UiState.Panel first=shop(item(620<<16|25,0,100,100,10,"Info","Buy 1"));
+        ui.update(first,input,1); press(ui,first,input,1<<12,10); assertEquals(1,game.scrolled);
+        UiState.Panel next=shop(item(620<<16|25,1,100,100,10,"Info","Buy 1"));
+        input.updateButtons(0); ui.update(next,input,100_000_000); assertEquals(1,ui.focus().child);
+        press(ui,next,input,1,200_000_000); ui.update(next,input,300_000_000); assertEquals(1,game.invoked);
+    }
