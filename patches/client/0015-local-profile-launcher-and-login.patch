+package net.runelite.client.soloscape.launcher;
+
+import com.google.gson.*;
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.*;
+import java.nio.file.attribute.PosixFilePermission;
+import java.util.Set;
+
+/** Explicit local-only credential bridge. Values never enter argv or diagnostics. */
+public final class LocalCredentials
+{
+    public final String account, password;
+    private LocalCredentials(String account, String password) { this.account = account; this.password = password; }
+    public static LocalCredentials read(Path file, String address) throws IOException
+    {
+        if (!"127.0.0.1".equals(address)) throw new IOException("Automatic login requires IPv4 loopback.");
+        if (!Files.isRegularFile(file, LinkOption.NOFOLLOW_LINKS) || Files.size(file) > 4096)
+            throw new IOException("Invalid local credentials file.");
+        Set<PosixFilePermission> permissions = Files.getPosixFilePermissions(file, LinkOption.NOFOLLOW_LINKS);
+        if (permissions.contains(PosixFilePermission.GROUP_READ) || permissions.contains(PosixFilePermission.OTHERS_READ)
+            || permissions.contains(PosixFilePermission.GROUP_WRITE) || permissions.contains(PosixFilePermission.OTHERS_WRITE))
+            throw new IOException("Local credentials must be private to their owner.");
+        try
+        {
+            JsonObject data = new Gson().fromJson(new String(Files.readAllBytes(file), StandardCharsets.UTF_8), JsonObject.class);
+            String account = data.get("account").getAsString(), password = data.get("password").getAsString();
+            if (!account.matches("[A-Za-z0-9 _]{1,12}") || account.trim().isEmpty()
+                || password.length() > 20 || !password.matches("[ -~]*")) throw new IOException("Invalid local login fields.");
+            return new LocalCredentials(account, password);
+        }
+        catch (RuntimeException ex) { throw new IOException("Invalid local credentials format."); }
+    }
+}
