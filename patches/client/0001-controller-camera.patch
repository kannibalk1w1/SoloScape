+import org.junit.After;
+import org.junit.Before;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+/** Exercises the actual adapter into the client's normal camera intent fields. */
+public class ControllerCameraTest
+{
+	private int gameState, cameraMode;
+	private float yaw, pitch, mouseYaw, mousePitch;
+	private boolean activity;
+
+	@Before public void setup()
+	{
+		gameState = Class240.anInt4674;
+		cameraMode = Class348_Sub40_Sub21.anInt9282;
+		yaw = Class314.aFloat3938;
+		pitch = Class76.aFloat1287;
+		mouseYaw = Class205.aFloat2687;
+		mousePitch = Class348_Sub27.aFloat6898;
+		activity = Class369_Sub3_Sub1.aBoolean10174;
+		Class240.anInt4674 = 10;
+		Class348_Sub40_Sub21.anInt9282 = 1;
+		Class314.aFloat3938 = 1000;
+		Class76.aFloat1287 = 2000;
+		Class205.aFloat2687 = 7;
+		Class348_Sub27.aFloat6898 = -3;
+		Class369_Sub3_Sub1.aBoolean10174 = false;
+	}
+
+	@After public void restore()
+	{
+		ControllerCamera.setInput(0, 0);
+		Class240.anInt4674 = gameState;
+		Class348_Sub40_Sub21.anInt9282 = cameraMode;
+		Class314.aFloat3938 = yaw;
+		Class76.aFloat1287 = pitch;
+		Class205.aFloat2687 = mouseYaw;
+		Class348_Sub27.aFloat6898 = mousePitch;
+		Class369_Sub3_Sub1.aBoolean10174 = activity;
+	}
+
+	@Test public void addsControllerInputWithoutChangingExistingInputVelocities()
+	{
+		ControllerCamera.setInput(120, 70);
+		ControllerCamera.apply(20);
+		assertEquals(1000 + 120 * 16384f / 360 / 50, Class314.aFloat3938, 0.001);
+		assertEquals(2000 + 70 * 16384f / 360 / 50, Class76.aFloat1287, 0.001);
+		assertEquals(7, Class205.aFloat2687, 0);
+		assertEquals(-3, Class348_Sub27.aFloat6898, 0);
+		assertTrue(Class369_Sub3_Sub1.aBoolean10174);
+		ControllerCamera.setInput(0, 0);
+		float after = Class314.aFloat3938;
+		ControllerCamera.apply(20);
+		assertEquals(after, Class314.aFloat3938, 0);
+	}
+
+	@Test public void doesNotChangeLoginOrScriptedCamera()
+	{
+		ControllerCamera.setInput(120, 70);
+		Class240.anInt4674 = 0;
+		ControllerCamera.apply(20);
+		assertEquals(1000, Class314.aFloat3938, 0);
+		Class240.anInt4674 = 10;
+		for (int mode : new int[] {0, 2, 3, 4})
+		{
+			Class348_Sub40_Sub21.anInt9282 = mode;
+			ControllerCamera.apply(20);
+			assertEquals(1000, Class314.aFloat3938, 0);
+			assertEquals(2000, Class76.aFloat1287, 0);
+		}
+	}
+}
