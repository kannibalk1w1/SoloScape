@@ -0,0 +1,42 @@
+package net.runelite.client.input.controller;
+
+/** Controller contribution only: never writes or resets mouse/keyboard velocities. */
+public final class CameraIntent
+{
+	private static final float ANGLE_UNITS_PER_DEGREE = 16384f / 360f;
+	private static final long INPUT_TIMEOUT_NANOS = 100_000_000L;
+	private static final long MAX_FRAME_MILLIS = 50;
+	private float yawRate, pitchRate;
+	private long updated;
+
+	public void set(float yawDegreesPerSecond, float pitchDegreesPerSecond, long now)
+	{
+		yawRate = Float.isFinite(yawDegreesPerSecond) ? yawDegreesPerSecond : 0;
+		pitchRate = Float.isFinite(pitchDegreesPerSecond) ? pitchDegreesPerSecond : 0;
+		updated = now;
+	}
+
+	public void clear()
+	{
+		yawRate = pitchRate = 0;
+	}
+
+	public float yawDelta(long millis, long now)
+	{
+		return delta(yawRate, millis, now);
+	}
+
+	public float pitchDelta(long millis, long now)
+	{
+		return delta(pitchRate, millis, now);
+	}
+
+	private float delta(float rate, long millis, long now)
+	{
+		if (now - updated < 0 || now - updated >= INPUT_TIMEOUT_NANOS)
+		{
+			return 0;
+		}
+		return rate * ANGLE_UNITS_PER_DEGREE * Math.max(0, Math.min(MAX_FRAME_MILLIS, millis)) / 1000f;
+	}
+}
