@@ -0,0 +1,23 @@
+package net.runelite.client.input.controller;
+
+/** Reused buffer. SDL standard axes: right/down positive; triggers from zero to one. */
+public final class GamepadState
+{
+	public boolean connected;
+	public float leftX, leftY, rightX, rightY, leftTrigger, rightTrigger;
+	public int buttonsHeld, buttonsPressed, buttonsReleased;
+
+	void updateButtons(int held)
+	{
+		buttonsPressed = held & ~buttonsHeld;
+		buttonsReleased = buttonsHeld & ~held;
+		buttonsHeld = held;
+	}
+
+	public void clear()
+	{
+		connected = false;
+		leftX = leftY = rightX = rightY = leftTrigger = rightTrigger = 0;
+		buttonsHeld = buttonsPressed = buttonsReleased = 0;
+	}
+}
diff --git a/client/src/net/runelite/client/input/controller/SdlGamepad.java b/client/src/net/runelite/client/input/controller/SdlGamepad.java
new file mode 100644
index 0000000..4df3a3f
--- /dev/null
+++ b/client/src/net/runelite/client/input/controller/SdlGamepad.java
@@ -0,0 +1,135 @@
+package net.runelite.client.input.controller;
+
+import com.sun.jna.Memory;
+import com.sun.jna.Native;
+import com.sun.jna.Pointer;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+/** SDL ownership and polling stay on the client thread. No AWT event synthesis. */
+public final class SdlGamepad implements AutoCloseable
+{
+	private static final Logger log = LoggerFactory.getLogger(SdlGamepad.class);
+	private static final int INIT_GAMECONTROLLER = 0x2000;
+	private static final int BUTTON_COUNT = 15;
+	private Pointer controller;
+	private boolean initialized;
+	private String name;
+
+	/** Lazy binding: a disabled plugin never loads SDL. */
+	static final class Sdl
+	{
+		static { Native.register("SDL2"); }
+		static native int SDL_InitSubSystem(int flags);
+		static native void SDL_QuitSubSystem(int flags);
+		static native void SDL_GetVersion(Pointer version);
+		static native Pointer SDL_GetError();
+		static native int SDL_SetHint(String name, String value);
+		static native int SDL_NumJoysticks();
+		static native int SDL_IsGameController(int index);
+		static native Pointer SDL_GameControllerOpen(int index);
+		static native void SDL_GameControllerClose(Pointer controller);
+		static native int SDL_GameControllerGetAttached(Pointer controller);
+		static native Pointer SDL_GameControllerName(Pointer controller);
+		static native Pointer SDL_GameControllerMapping(Pointer controller);
+		static native void SDL_free(Pointer pointer);
+		static native void SDL_GameControllerUpdate();
+		static native int SDL_GameControllerEventState(int state);
+		static native int SDL_JoystickEventState(int state);
+		static native short SDL_GameControllerGetAxis(Pointer controller, int axis);
+		static native byte SDL_GameControllerGetButton(Pointer controller, int button);
+	}
+
+	public void init()
+	{
+		if (initialized) return;
+		try (Memory version = new Memory(3))
+		{
+			Sdl.SDL_GetVersion(version);
+			int major = version.getByte(0) & 255;
+			int minor = version.getByte(1) & 255;
+			int patch = version.getByte(2) & 255;
+			if (major != 2 || (minor == 0 && patch < 22))
+			{
+				throw new IllegalStateException("Install SDL2 2.0.22+ for controller support");
+			}
+			log.info("SoloScape controller provider: SDL {}.{}.{}", major, minor, patch);
+		}
+		// SDL owns no window here. The plugin gates input with the real AWT canvas focus.
+		Sdl.SDL_SetHint("SDL_JOYSTICK_ALLOW_BACKGROUND_EVENTS", "1");
+		if (Sdl.SDL_InitSubSystem(INIT_GAMECONTROLLER) != 0)
+		{
+			throw new IllegalStateException("SDL controller initialization: " + Sdl.SDL_GetError().getString(0));
+		}
+		initialized = true;
+		// We poll state, not SDL events. Avoid filling an unused SDL event queue.
+		Sdl.SDL_GameControllerEventState(0);
+		Sdl.SDL_JoystickEventState(0);
+	}
+
+	public void poll(GamepadState state)
+	{
+		if (!initialized) throw new IllegalStateException("Controller provider not initialized");
+		Sdl.SDL_GameControllerUpdate();
+		if (controller != null && Sdl.SDL_GameControllerGetAttached(controller) == 0)
+		{
+			log.info("SoloScape controller disconnected: {}", name);
+			closeController();
+			state.clear();
+		}
+		if (controller == null)
+		{
+			int count = Sdl.SDL_NumJoysticks();
+			for (int i = 0; i < count; i++)
+			{
+				if (Sdl.SDL_IsGameController(i) == 0) continue;
+				controller = Sdl.SDL_GameControllerOpen(i);
+				if (controller == null) continue;
+				state.clear();
+				name = Sdl.SDL_GameControllerName(controller).getString(0, "UTF-8");
+				Pointer mapping = Sdl.SDL_GameControllerMapping(controller);
+				String guid = "unknown";
+				if (mapping != null)
+				{
+					try { guid = mapping.getString(0, "UTF-8").split(",", 2)[0]; }
+					finally { Sdl.SDL_free(mapping); }
+				}
+				log.info("SoloScape controller connected: {} (GUID {})", name, guid);
+				break;
+			}
+		}
+		if (controller == null)
+		{
+			state.clear();
+			return;
+		}
+		state.connected = true;
+		state.leftX = StickMath.normalize(Sdl.SDL_GameControllerGetAxis(controller, 0));
+		state.leftY = StickMath.normalize(Sdl.SDL_GameControllerGetAxis(controller, 1));
+		state.rightX = StickMath.normalize(Sdl.SDL_GameControllerGetAxis(controller, 2));
+		state.rightY = StickMath.normalize(Sdl.SDL_GameControllerGetAxis(controller, 3));
+		state.leftTrigger = Math.max(0, StickMath.normalize(Sdl.SDL_GameControllerGetAxis(controller, 4)));
+		state.rightTrigger = Math.max(0, StickMath.normalize(Sdl.SDL_GameControllerGetAxis(controller, 5)));
+		int buttons = 0;
+		for (int i = 0; i < BUTTON_COUNT; i++)
+		{
+			if (Sdl.SDL_GameControllerGetButton(controller, i) != 0) buttons |= 1 << i;
+		}
+		state.updateButtons(buttons);
+	}
+
+	private void closeController()
+	{
+		if (controller != null) Sdl.SDL_GameControllerClose(controller);
+		controller = null;
+		name = null;
+	}
+
+	@Override
+	public void close()
+	{
+		closeController();
+		if (initialized) Sdl.SDL_QuitSubSystem(INIT_GAMECONTROLLER);
+		initialized = false;
+	}
+}
