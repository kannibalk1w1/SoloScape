+package net.runelite.client.plugins.soloscapecontroller;
+
+import net.runelite.client.config.Config;
+import net.runelite.client.config.ConfigGroup;
+import net.runelite.client.config.ConfigItem;
+import net.runelite.client.config.Range;
+
+@ConfigGroup("soloscapecontroller")
+public interface SoloScapeControllerConfig extends Config
+{
+	@Range(min = 0, max = 90)
+	@ConfigItem(keyName = "deadzone", name = "Stick deadzone (%)", description = "Radial right-stick deadzone.", position = 0)
+	default int deadzone() { return 18; }
+
+	@Range(min = 10, max = 360)
+	@ConfigItem(keyName = "yawSpeed", name = "Camera turn speed", description = "Degrees per second at full stick tilt.", position = 1)
+	default int yawSpeed() { return 120; }
+
+	@Range(min = 10, max = 180)
+	@ConfigItem(keyName = "pitchSpeed", name = "Camera pitch speed", description = "Degrees per second at full stick tilt.", position = 2)
+	default int pitchSpeed() { return 70; }
+
+	@ConfigItem(keyName = "invertY", name = "Invert vertical camera", description = "Reverse the right-stick vertical direction.", position = 3)
+	default boolean invertY() { return false; }
+
+	@ConfigItem(keyName = "debug", name = "Controller diagnostics", description = "Log stick values at most once a second.", position = 4)
+	default boolean debug() { return false; }
+}
