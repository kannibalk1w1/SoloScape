@@ -0,0 +1,102 @@
+package net.runelite.client.plugins.soloscapecontroller;
+
+import com.GameClient;
+import com.google.inject.Provides;
+import java.awt.Canvas;
+import javax.inject.Inject;
+import lombok.extern.slf4j.Slf4j;
+import net.runelite.api.events.ClientTick;
+import net.runelite.client.callback.ClientThread;
+import net.runelite.client.config.ConfigManager;
+import net.runelite.client.eventbus.Subscribe;
+import net.runelite.client.input.controller.GamepadState;
+import net.runelite.client.input.controller.SdlGamepad;
+import net.runelite.client.input.controller.StickMath;
+import net.runelite.client.plugins.Plugin;
+import net.runelite.client.plugins.PluginDescriptor;
+
+@PluginDescriptor(
+	name = "SoloScape Controller",
+	description = "Experimental native controller detection and right-stick camera",
+	tags = {"controller", "gamepad", "soloscape", "steam deck"},
+	enabledByDefault = false,
+	loadWhenOutdated = true
+)
+@Slf4j
+public class SoloScapeControllerPlugin extends Plugin
+{
+	@Inject private GameClient client;
+	@Inject private ClientThread clientThread;
+	@Inject private SoloScapeControllerConfig config;
+	private final GamepadState state = new GamepadState();
+	private SdlGamepad gamepad;
+	private boolean failed;
+	private volatile boolean active;
+	private long lastDebug;
+
+	@Provides
+	SoloScapeControllerConfig provideConfig(ConfigManager configManager)
+	{
+		return configManager.getConfig(SoloScapeControllerConfig.class);
+	}
+
+	@Override
+	protected void startUp()
+	{
+		clientThread.invoke(() -> { reset(); failed = false; active = true; });
+	}
+
+	@Override
+	protected void shutDown()
+	{
+		active = false;
+		clientThread.invoke(this::reset);
+	}
+
+	private void reset()
+	{
+		active = false;
+		client.setControllerCameraInput(0, 0);
+		state.clear();
+		if (gamepad != null) gamepad.close();
+		gamepad = null;
+	}
+
+	@Subscribe
+	public void onClientTick(ClientTick event)
+	{
+		if (!active || failed) return;
+		try
+		{
+			if (gamepad == null)
+			{
+				gamepad = new SdlGamepad();
+				gamepad.init();
+				log.info("SoloScape controller enabled; waiting for an SDL-mapped gamepad");
+			}
+			gamepad.poll(state);
+			Canvas canvas = client.getCanvas();
+			if (!state.connected || canvas == null || !canvas.isFocusOwner() || !client.hasLocalPlayer())
+			{
+				client.setControllerCameraInput(0, 0);
+				return;
+			}
+			float scale = StickMath.deadzoneScale(state.rightX, state.rightY, config.deadzone() / 100f);
+			float yaw = state.rightX * scale;
+			float pitch = state.rightY * scale * (config.invertY() ? 1 : -1);
+			client.setControllerCameraInput(yaw * config.yawSpeed(), pitch * config.pitchSpeed());
+			long now = System.nanoTime();
+			if (config.debug() && now - lastDebug >= 1_000_000_000L)
+			{
+				lastDebug = now;
+				log.info("SoloScape camera stick after deadzone: ({}, {})", yaw, pitch);
+			}
+		}
+		catch (RuntimeException | LinkageError ex)
+		{
+			failed = true;
+			reset();
+			log.warn("Controller support unavailable. Install SDL2 2.0.22+ and check device permissions, then toggle the plugin to retry.", ex);
+		}
+	}
+}
