@@ -0,0 +1,63 @@
+package net.runelite.client.input.controller;
+
+import com.sun.jna.Native;
+import com.sun.jna.Pointer;
+import org.junit.Assume;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+/** Opt-in integration test using SDL's actual native virtual controller backend. */
+public class SdlGamepadTest
+{
+	static final class VirtualSdl
+	{
+		static { Native.register("SDL2"); }
+		static native int SDL_JoystickAttachVirtual(int type, int axes, int buttons, int hats);
+		static native int SDL_JoystickDetachVirtual(int index);
+		static native Pointer SDL_JoystickOpen(int index);
+		static native void SDL_JoystickClose(Pointer joystick);
+		static native int SDL_JoystickSetVirtualAxis(Pointer joystick, int axis, short value);
+		static native int SDL_JoystickSetVirtualButton(Pointer joystick, int button, byte value);
+	}
+
+	@Test public void nativeHotplugPollingAndUnplugClearState()
+	{
+		Assume.assumeTrue("Pass -PcontrollerNativeTest=true with SDL2 installed", Boolean.getBoolean("controllerNativeTest"));
+		try (SdlGamepad provider = new SdlGamepad())
+		{
+			provider.init();
+			GamepadState state = new GamepadState();
+			provider.poll(state);
+			Assume.assumeFalse("Unplug real gamepads for the virtual-device test", state.connected);
+			int index = VirtualSdl.SDL_JoystickAttachVirtual(1, 6, 15, 0);
+			assertTrue(index >= 0);
+			Pointer joystick = VirtualSdl.SDL_JoystickOpen(index);
+			assertNotNull(joystick);
+			try
+			{
+				provider.poll(state);
+				assertTrue("Recognize a newly attached mapped controller", state.connected);
+				assertEquals(0, VirtualSdl.SDL_JoystickSetVirtualAxis(joystick, 2, Short.MAX_VALUE));
+				assertEquals(0, VirtualSdl.SDL_JoystickSetVirtualAxis(joystick, 3, Short.MIN_VALUE));
+				assertEquals(0, VirtualSdl.SDL_JoystickSetVirtualButton(joystick, 0, (byte) 1));
+				provider.poll(state);
+				assertEquals(1, state.rightX, 0);
+				assertEquals(-1, state.rightY, 0);
+				assertEquals(1, state.buttonsPressed);
+				provider.poll(state);
+				assertEquals(0, state.buttonsPressed);
+				assertEquals(0, VirtualSdl.SDL_JoystickDetachVirtual(index));
+				index = -1;
+				provider.poll(state);
+				assertFalse(state.connected);
+				assertEquals(0, state.rightX, 0);
+				assertEquals(0, state.buttonsHeld);
+			}
+			finally
+			{
+				VirtualSdl.SDL_JoystickClose(joystick);
+				if (index >= 0) VirtualSdl.SDL_JoystickDetachVirtual(index);
+			}
+		}
+	}
+}
