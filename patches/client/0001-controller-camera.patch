@@ -0,0 +1,76 @@
+package net.runelite.client.input.controller;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class ControllerMathTest
+{
+	@Test public void fullAxisRangeIsSymmetric()
+	{
+		assertEquals(-1, StickMath.normalize(Short.MIN_VALUE), 0);
+		assertEquals(1, StickMath.normalize(Short.MAX_VALUE), 0);
+		assertEquals(0, StickMath.normalize((short) 0), 0);
+	}
+
+	@Test public void radialDeadzoneHasNoDriftAndPreservesDirection()
+	{
+		assertEquals(0, StickMath.deadzoneScale(0.1f, 0.1f, 0.18f), 0);
+		assertEquals(0, StickMath.deadzoneScale(0.18f, 0, 0.18f), 0);
+		float scale = StickMath.deadzoneScale(0.6f, -0.8f, 0.18f);
+		assertEquals(0.6, 0.6f * scale, 0.00001);
+		assertEquals(-0.8, -0.8f * scale, 0.00001);
+		float diagonal = StickMath.deadzoneScale(1, 1, 0.18f);
+		assertEquals(1, Math.hypot(diagonal, diagonal), 0.00001);
+		assertEquals(0.5, 0.59f * StickMath.deadzoneScale(0.59f, 0, 0.18f), 0.00001);
+	}
+
+	@Test public void invalidInputCannotPoisonCamera()
+	{
+		assertEquals(0, StickMath.deadzoneScale(Float.NaN, 0, 0.18f), 0);
+		assertEquals(0, StickMath.deadzoneScale(0, Float.POSITIVE_INFINITY, 0.18f), 0);
+		CameraIntent intent = new CameraIntent();
+		intent.set(Float.NaN, Float.POSITIVE_INFINITY, 100);
+		assertEquals(0, intent.yawDelta(20, 101), 0);
+		assertEquals(0, intent.pitchDelta(20, 101), 0);
+	}
+
+	@Test public void cameraSpeedDoesNotDependOnFrameRate()
+	{
+		CameraIntent intent = new CameraIntent();
+		intent.set(120, -70, 0);
+		assertEquals(intent.yawDelta(20, 1), 4 * intent.yawDelta(5, 1), 0.00001);
+		assertEquals(120 * 16384f / 360 / 50, intent.yawDelta(20, 1), 0.00001);
+		assertTrue(intent.pitchDelta(20, 1) < 0);
+	}
+
+	@Test public void staleInputAndHitchesCannotLeaveCameraSpinning()
+	{
+		CameraIntent intent = new CameraIntent();
+		intent.set(120, 70, 0);
+		assertEquals(intent.yawDelta(50, 1), intent.yawDelta(5000, 1), 0);
+		assertEquals(0, intent.yawDelta(-1, 1), 0);
+		assertEquals(0, intent.yawDelta(20, 100_000_000), 0);
+		intent.set(120, 70, 100_000_001);
+		assertTrue(intent.yawDelta(20, 100_000_002) > 0);
+		intent.clear();
+		assertEquals(0, intent.yawDelta(20, 100_000_002), 0);
+		assertEquals(0, intent.pitchDelta(20, 100_000_002), 0);
+	}
+
+	@Test public void buttonEdgesAreSingleUpdatesAndDisconnectClearsEverything()
+	{
+		GamepadState state = new GamepadState();
+		state.updateButtons(1);
+		assertEquals(1, state.buttonsPressed);
+		state.updateButtons(1);
+		assertEquals(0, state.buttonsPressed);
+		state.updateButtons(0);
+		assertEquals(1, state.buttonsReleased);
+		state.rightX = 1;
+		state.connected = true;
+		state.clear();
+		assertFalse(state.connected);
+		assertEquals(0, state.rightX, 0);
+		assertEquals(0, state.buttonsHeld | state.buttonsPressed | state.buttonsReleased);
+	}
+}
