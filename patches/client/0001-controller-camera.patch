+	static void setInput(float yawDegreesPerSecond, float pitchDegreesPerSecond)
+	{
+		input.set(yawDegreesPerSecond, pitchDegreesPerSecond, System.nanoTime());
+	}
+
+	static void apply(long elapsedMillis)
+	{
+		// Leave login screens, cutscenes and other scripted/free-camera modes alone.
+		if (Class240.anInt4674 != 10 || (Class348_Sub40_Sub21.anInt9282 != 1 && Class348_Sub40_Sub21.anInt9282 != 5)) return;
+		long now = System.nanoTime();
+		float yaw = input.yawDelta(elapsedMillis, now);
+		float pitch = input.pitchDelta(elapsedMillis, now);
+		Class314.aFloat3938 += yaw;
+		Class76.aFloat1287 += pitch;
+		if (yaw != 0 || pitch != 0) Class369_Sub3_Sub1.aBoolean10174 = true;
+		// Canvas_Sub1 calls the client's normal wrap/pitch clamp immediately afterward.
+	}
+}
