@@ -0,0 +1,28 @@
+package net.runelite.client.input.controller;
+
+/** Pure input math, independent of native polling and rendering. */
+public final class StickMath
+{
+	private StickMath() {}
+
+	public static float normalize(short raw)
+	{
+		return raw < 0 ? raw / 32768f : raw / 32767f;
+	}
+
+	/** Shared radial scale preserves direction and caps diagonals at unit magnitude. */
+	public static float deadzoneScale(float x, float y, float deadzone)
+	{
+		if (!Float.isFinite(x) || !Float.isFinite(y) || !Float.isFinite(deadzone))
+		{
+			return 0;
+		}
+		deadzone = Math.max(0, Math.min(0.95f, deadzone));
+		float magnitude = (float) Math.sqrt(x * x + y * y);
+		if (magnitude <= deadzone || magnitude == 0)
+		{
+			return 0;
+		}
+		return (Math.min(magnitude, 1) - deadzone) / ((1 - deadzone) * magnitude);
+	}
+}
