@@ -0,0 +1,83 @@
+package net.runelite.client.input.controller;
+
+/** View/Select toggles the wheel; stick highlights, A opens, B backs out. */
+public final class TabRadialControls
+{
+    public interface Gateway
+    {
+        int availableTabs();
+        boolean openTab(int index);
+    }
+    private static final int A = 1, B = 2, VIEW = 1 << 4;
+    private static final int PREVIOUS = (1 << 9) | (1 << 11) | (1 << 13);
+    private static final int NEXT = (1 << 10) | (1 << 12) | (1 << 14);
+    private static final int COUNT = HomeTab.values().length;
+    private final Gateway gateway;
+    private boolean active, armed, stickArmed, openingArmed;
+    private int selected, available;
+    private long refreshAt;
+    private String message;
+
+    public TabRadialControls(Gateway gateway) { this.gateway = gateway; }
+    public boolean active() { return active; }
+    public int selected() { return selected; }
+    public boolean available(int index) { return (available & (1 << index)) != 0; }
+    public String message() { return message; }
+    public void reset()
+    {
+        active = armed = stickArmed = openingArmed = false;
+        selected = available = 0; refreshAt = 0; message = null;
+    }
+
+    public boolean update(GamepadState input, long now)
+    {
+        if (!openingArmed)
+        {
+            if ((input.buttonsHeld & VIEW) == 0) openingArmed = true;
+            else return false;
+        }
+        if (!active)
+        {
+            if ((input.buttonsPressed & VIEW) == 0) return false;
+            available = gateway.availableTabs();
+            if (available == 0) return false; // Dialogue, login, native menu or hidden frame.
+            active = true; selected = 0; message = null; armed = false;
+            stickArmed = Math.hypot(input.leftX, input.leftY) < .35;
+            refreshAt = now + 100_000_000L;
+            return true; // Never dispatch an action on the opening frame.
+        }
+        if (now >= refreshAt)
+        {
+            available = gateway.availableTabs(); refreshAt = now + 100_000_000L;
+            if (available == 0) { active = false; return true; }
+        }
+        if ((input.buttonsPressed & VIEW) != 0) { active = false; return true; }
+        if (!armed)
+        {
+            if ((input.buttonsHeld & (A | B | PREVIOUS | NEXT)) == 0) armed = true;
+            else return true;
+        }
+        if ((input.buttonsPressed & B) != 0) { active = false; return true; }
+        double magnitude = Math.hypot(input.leftX, input.leftY);
+        if (magnitude < .35) stickArmed = true;
+        if (stickArmed && magnitude >= .45)
+        {
+            // SDL down is positive. Zero radians is top; sectors increase clockwise.
+            double angle = Math.atan2(input.leftX, -input.leftY);
+            double step = 2 * Math.PI / COUNT;
+            int next = Math.floorMod((int) Math.floor(angle / step + .5), COUNT);
+            double centre = selected * step;
+            double distance = Math.abs(Math.atan2(Math.sin(angle - centre), Math.cos(angle - centre)));
+            if (distance > step / 2 + Math.toRadians(3)) { selected = next; message = null; }
+        }
+        int previous = input.buttonsPressed & PREVIOUS, next = input.buttonsPressed & NEXT;
+        if (previous != 0 && next == 0) { selected = Math.floorMod(selected - 1, COUNT); message = null; }
+        if (next != 0 && previous == 0) { selected = (selected + 1) % COUNT; message = null; }
+        if ((input.buttonsPressed & A) != 0)
+        {
+            if (available(selected) && gateway.openTab(selected)) active = false;
+            else { message = "Tab unavailable here"; armed = false; }
+        }
+        return true; // Closing input also belongs to the wheel, never to the world.
+    }
+}
