@@ -0,0 +1,108 @@
+package net.runelite.client.input.controller;
+
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class TabRadialControlsTest
+{
+    private static final int VIEW = 1 << 4;
+    private static final class Fake implements TabRadialControls.Gateway
+    {
+        int mask = 65535, opens, last = -1;
+        boolean succeeds = true;
+        public int availableTabs() { return mask; }
+        public boolean openTab(int index) { opens++; last = index; return succeeds; }
+    }
+    private static void buttons(TabRadialControls radial, GamepadState state, int held, long now)
+    { state.updateButtons(held); radial.update(state, now); }
+    private static TabRadialControls open(Fake game, GamepadState state)
+    {
+        TabRadialControls radial = new TabRadialControls(game);
+        buttons(radial, state, 0, 1); buttons(radial, state, VIEW, 2);
+        assertTrue(radial.active()); buttons(radial, state, 0, 3);
+        return radial;
+    }
+
+    @Test public void stickCanSelectAllSixteenTabsAndConfirmOnce()
+    {
+        Fake game = new Fake(); GamepadState state = new GamepadState();
+        TabRadialControls radial = open(game, state);
+        for (int i = 0; i < 16; i++)
+        {
+            state.leftX = (float) Math.sin(i * 2 * Math.PI / 16);
+            state.leftY = (float) -Math.cos(i * 2 * Math.PI / 16);
+            radial.update(state, 10 + i);
+            assertEquals(i, radial.selected());
+        }
+        buttons(radial, state, 1, 30);
+        assertFalse(radial.active()); assertEquals(1, game.opens); assertEquals(15, game.last);
+        assertFalse(radial.update(state, 31)); assertEquals(1, game.opens);
+    }
+    @Test public void openingDoesNotInheritHeldWalkingOrActionInput()
+    {
+        Fake game = new Fake(); GamepadState state = new GamepadState();
+        TabRadialControls radial = new TabRadialControls(game);
+        buttons(radial, state, 0, 1);
+        state.leftX = 1;
+        buttons(radial, state, VIEW | 1, 2); buttons(radial, state, VIEW | 1, 3);
+        assertEquals(0, radial.selected()); assertEquals(0, game.opens);
+        buttons(radial, state, 0, 4); assertEquals(0, radial.selected());
+        state.leftX = 0; radial.update(state, 5);
+        state.leftX = 1; radial.update(state, 6); assertEquals(4, radial.selected());
+    }
+    @Test public void cancelAndToggleConsumeTheirClosingFrameWithoutOpeningATab()
+    {
+        Fake game = new Fake(); GamepadState state = new GamepadState();
+        TabRadialControls radial = open(game, state);
+        state.updateButtons(2); assertTrue(radial.update(state, 4));
+        assertFalse(radial.active()); assertEquals(0, game.opens);
+        buttons(radial, state, 0, 5); buttons(radial, state, VIEW, 6);
+        assertTrue(radial.active()); buttons(radial, state, 0, 7);
+        state.updateButtons(VIEW); assertTrue(radial.update(state, 8));
+        assertFalse(radial.active()); assertEquals(0, game.opens);
+    }
+    @Test public void unavailableTabsRemainOpenAndFreshAvailabilityCanInvalidateTheWheel()
+    {
+        Fake game = new Fake(); game.mask = 1 << 12;
+        GamepadState state = new GamepadState(); TabRadialControls radial = open(game, state);
+        buttons(radial, state, 1, 4);
+        assertTrue(radial.active()); assertEquals(0, game.opens); assertNotNull(radial.message());
+        buttons(radial, state, 0, 5);
+        state.leftX = -1; state.leftY = 0; radial.update(state, 6);
+        assertEquals(HomeTab.SETTINGS.ordinal(), radial.selected());
+        game.succeeds = false; buttons(radial, state, 1, 7);
+        assertTrue(radial.active()); assertEquals(1, game.opens);
+        game.mask = 0; radial.update(state, 200_000_000L);
+        assertFalse(radial.active());
+    }
+    @Test public void dpadAndBumpersWrapWithoutRepeatingWhileHeld()
+    {
+        Fake game = new Fake(); GamepadState state = new GamepadState();
+        TabRadialControls radial = open(game, state);
+        buttons(radial, state, 1 << 9, 4); assertEquals(15, radial.selected());
+        buttons(radial, state, 1 << 9, 5); assertEquals(15, radial.selected());
+        buttons(radial, state, 0, 6); buttons(radial, state, 1 << 10, 7);
+        assertEquals(0, radial.selected());
+    }
+    @Test public void resetRequiresFreshViewReleaseAndNeutralWheelCannotOpenInDialogue()
+    {
+        Fake game = new Fake(); GamepadState state = new GamepadState();
+        TabRadialControls radial = open(game, state);
+        radial.reset(); buttons(radial, state, VIEW, 4); assertFalse(radial.active());
+        buttons(radial, state, 0, 5); game.mask = 0;
+        buttons(radial, state, VIEW, 6); assertFalse(radial.active());
+        game.mask = 65535; buttons(radial, state, VIEW, 7); assertFalse(radial.active());
+        buttons(radial, state, 0, 8); buttons(radial, state, VIEW, 9); assertTrue(radial.active());
+    }
+    @Test public void sectorBoundaryHysteresisPreventsFlicker()
+    {
+        Fake game = new Fake(); GamepadState state = new GamepadState();
+        TabRadialControls radial = open(game, state);
+        state.leftX = (float) Math.sin(Math.toRadians(12)); state.leftY = (float) -Math.cos(Math.toRadians(12));
+        radial.update(state, 4); assertEquals(0, radial.selected());
+        state.leftX = (float) Math.sin(Math.toRadians(16)); state.leftY = (float) -Math.cos(Math.toRadians(16));
+        radial.update(state, 5); assertEquals(1, radial.selected());
+        state.leftX = (float) Math.sin(Math.toRadians(11)); state.leftY = (float) -Math.cos(Math.toRadians(11));
+        radial.update(state, 6); assertEquals(1, radial.selected());
+    }
+}
