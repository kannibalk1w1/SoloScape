@@ -0,0 +1,29 @@
+package net.runelite.client.input.controller;
+
+/** Main revision-634 tab buttons, pinned to gameframe.ifaces.toml. Clockwise from top. */
+public enum HomeTab
+{
+    INVENTORY("Inventory", 132, 39), EQUIPMENT("Equipment", 133, 40),
+    PRAYER("Prayer", 134, 41), SPELLBOOK("Spellbook", 135, 42),
+    COMBAT("Combat", 128, 35), SKILLS("Skills", 130, 37),
+    QUESTS("Quests", 131, 38), TASKS("Tasks", 129, 36),
+    OBJECTIVES("Objectives", 98, 43), FRIENDS("Friends", 99, 44),
+    IGNORE("Ignore", 100, 45), CLAN("Clan", 101, 46),
+    SETTINGS("Settings", 102, 47), EMOTES("Emotes", 103, 48),
+    MUSIC("Music", 104, 49), NOTES("Notes", 105, 50);
+
+    public final String label;
+    private static final HomeTab[] TABS = values();
+    private final int fixed, resized;
+    HomeTab(String label, int fixed, int resized)
+    { this.label = label; this.fixed = fixed; this.resized = resized; }
+
+    public boolean matches(int widgetId)
+    { return widgetId == (548 << 16 | fixed) || widgetId == (746 << 16 | resized); }
+
+    public static boolean isTab(int widgetId)
+    {
+        for (HomeTab tab : TABS) if (tab.matches(widgetId)) return true;
+        return false;
+    }
+}
