+package net.runelite.client.plugins.soloscapecontroller;
+
+import com.GameClient;
+import java.awt.BasicStroke;
+import java.awt.Color;
+import java.awt.Dimension;
+import java.awt.Font;
+import java.awt.Graphics2D;
+import java.awt.RenderingHints;
+import java.awt.geom.Arc2D;
+import java.awt.geom.Area;
+import java.awt.geom.Ellipse2D;
+import javax.inject.Inject;
+import net.runelite.client.input.controller.HomeTab;
+import net.runelite.client.input.controller.TabRadialControls;
+import net.runelite.client.ui.overlay.Overlay;
+import net.runelite.client.ui.overlay.OverlayLayer;
+import net.runelite.client.ui.overlay.OverlayPosition;
+import net.runelite.client.ui.overlay.OverlayPriority;
+
+/** A custom tab wheel over the unchanged native game frame. */
+public final class SoloScapeTabRadialOverlay extends Overlay
+{
+    private static final HomeTab[] TABS = HomeTab.values();
+    private final GameClient client;
+    private final SoloScapeControllerPlugin plugin;
+
+    @Inject SoloScapeTabRadialOverlay(GameClient client, SoloScapeControllerPlugin plugin)
+    {
+        super(plugin); this.client = client; this.plugin = plugin;
+        setPosition(OverlayPosition.DYNAMIC); setLayer(OverlayLayer.ABOVE_WIDGETS);
+        setPriority(OverlayPriority.HIGHEST);
+    }
+
+    @Override public Dimension render(Graphics2D graphics)
+    {
+        if (!plugin.isActive() || !plugin.getRadial().active() || client.getCanvas() == null) return null;
+        paint(graphics, client.getCanvas().getWidth(), client.getCanvas().getHeight(), plugin.getRadial());
+        return null;
+    }
+
+    public static void paint(Graphics2D graphics, int width, int height, TabRadialControls radial)
+    {
+        Graphics2D draw = (Graphics2D) graphics.create();
+        try
+        {
+            draw.setRenderingHint(RenderingHints.KEY_ANTIALIASING, RenderingHints.VALUE_ANTIALIAS_ON);
+            draw.setColor(new Color(0, 0, 0, 115)); draw.fillRect(0, 0, width, height);
+            double radius = Math.min(210, Math.min(width / 2.0 - 18, height / 2.0 - 32));
+            if (radius < 80) return;
+            double cx = width / 2.0, cy = height / 2.0;
+            double inner = radius * .51, labelRadius = radius * .78;
+            double step = 360.0 / TABS.length;
+            draw.setFont(new Font(Font.SANS_SERIF, Font.BOLD, 11));
+            for (int i = 0; i < TABS.length; i++)
+            {
+                boolean selected = i == radial.selected(), available = radial.available(i);
+                Area wedge = new Area(new Arc2D.Double(cx - radius, cy - radius, 2 * radius, 2 * radius,
+                    90 - i * step - step / 2 + 1, step - 2, Arc2D.PIE));
+                wedge.subtract(new Area(new Ellipse2D.Double(cx - inner, cy - inner, 2 * inner, 2 * inner)));
+                draw.setColor(selected ? new Color(137, 105, 39, 245) : new Color(31, 29, 26, 240));
+                draw.fill(wedge);
+                draw.setColor(selected ? new Color(255, 218, 105) : new Color(111, 91, 55));
+                draw.setStroke(new BasicStroke(selected ? 2 : 1)); draw.draw(wedge);
+                double angle = Math.toRadians(i * step);
+                int x = (int) Math.round(cx + Math.sin(angle) * labelRadius);
+                int y = (int) Math.round(cy - Math.cos(angle) * labelRadius);
+                draw.setColor(available ? (selected ? new Color(255, 237, 178) : new Color(227, 220, 198)) : new Color(125, 122, 113));
+                centre(draw, TABS[i].label, x, y + 4);
+            }
+            draw.setColor(new Color(20, 19, 17, 245));
+            draw.fill(new Ellipse2D.Double(cx - inner + 3, cy - inner + 3, 2 * inner - 6, 2 * inner - 6));
+            draw.setFont(new Font(Font.SANS_SERIF, Font.BOLD, 19));
+            draw.setColor(new Color(255, 218, 105)); centre(draw, TABS[radial.selected()].label, (int) cx, (int) cy - 9);
+            draw.setFont(new Font(Font.SANS_SERIF, Font.PLAIN, 12));
+            draw.setColor(Color.WHITE);
+            centre(draw, radial.message() != null ? radial.message() : radial.available(radial.selected()) ? "A  Open tab" : "Unavailable here", (int) cx, (int) cy + 15);
+            draw.setColor(new Color(194, 185, 161)); centre(draw, "B  Back", (int) cx, (int) cy + 38);
+            draw.setFont(new Font(Font.SANS_SERIF, Font.BOLD, 14));
+            draw.setColor(new Color(255, 222, 139)); centre(draw, "HOME TABS", (int) cx, (int) (cy - radius - 13));
+            draw.setFont(new Font(Font.SANS_SERIF, Font.PLAIN, 12));
+            centre(draw, "Left stick: choose   ·   D-pad / LB / RB: cycle   ·   View/Select: close", (int) cx, (int) (cy + radius + 21));
+        }
+        finally { draw.dispose(); }
+    }
+
+    private static void centre(Graphics2D draw, String text, int x, int y)
+    { draw.drawString(text, x - draw.getFontMetrics().stringWidth(text) / 2, y); }
+}
