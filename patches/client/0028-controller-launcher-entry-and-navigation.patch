+package net.runelite.client.soloscape.launcher;
+
+import java.awt.*;
+import java.awt.event.*;
+import java.util.*;
+import javax.swing.*;
+import javax.swing.text.*;
+import net.runelite.client.input.controller.*;
+
+/** EDT-only adapter to the existing entry controls. No native game actions or packets. */
+final class LauncherKeyboard extends JPanel
+{
+    private JTextField field;
+    private final Map<JTextField,Integer> types=new IdentityHashMap<>();
+    private final Map<JTextField,Runnable> next=new IdentityHashMap<>();
+    private final JPanel grid=new JPanel(new GridLayout(0,6,5,5));
+    private final JLabel prompt=new JLabel("D-pad: keys · A: select · X: delete · Y: next · B: leave keyboard · LB/RB: fields");
+    private final java.util.List<JButton> buttons=new ArrayList<>();
+    private final EntryControls controls;
+    private long revision;
+    private String[] drawn;
+    Window owner;
+    LauncherKeyboard()
+    {
+        super(new BorderLayout(5,5));add(prompt,BorderLayout.NORTH);add(grid,BorderLayout.CENTER);setVisible(false);
+        controls=new EntryControls(new UiControls.Gateway(){
+            public UiState snapshot(){return UiState.EMPTY;}
+            public boolean openInventory(){return false;}
+            public boolean invoke(UiState.Widget w,UiState.Action a){return false;}
+            public void cancelSelection(){} public void cancelDialogue(){}
+            public boolean editEntry(EntryState state,String value){if(!current(state)||!EntryState.valid(state.type,value))return false;field.setText(value);return true;}
+            public boolean submitEntry(EntryState state){if(!current(state))return false;Runnable advance=next.get(field);deactivate();advance.run();return true;}
+            public void cancelEntry(EntryState state){if(current(state))deactivate();}
+        });
+    }
+    void register(JTextField text,int type,Runnable advance)
+    {
+        types.put(text,type);next.put(text,advance);
+        ((AbstractDocument)text.getDocument()).setDocumentFilter(new DocumentFilter(){
+            @Override public void insertString(FilterBypass bypass,int offset,String value,AttributeSet attributes)throws BadLocationException{replace(bypass,offset,0,value,attributes);}
+            @Override public void replace(FilterBypass bypass,int offset,int length,String value,AttributeSet attributes)throws BadLocationException{
+                String old=bypass.getDocument().getText(0,bypass.getDocument().getLength());String changed=old.substring(0,offset)+(value==null?"":value)+old.substring(offset+length);
+                if(EntryState.valid(type,changed))bypass.replace(offset,length,value,attributes);
+            }
+        });
+        text.addFocusListener(new FocusAdapter(){@Override public void focusGained(FocusEvent event){activate(text);}});
+    }
+    boolean accepts(Component focus){return types.containsKey(focus);}
+    void activate(JTextField text){if(!types.containsKey(text))return;field=text;revision++;controls.reset();setVisible(true);GamepadState held=new GamepadState();held.buttonsHeld=1;controls.update(snapshot(),held,System.nanoTime());draw();revalidate();}
+    void deactivate(){field=null;controls.reset();setVisible(false);drawn=null;revalidate();}
+    boolean active(){return field!=null;}
+    private EntryState snapshot(){return field==null?null:new EntryState(types.get(field),revision,field.getName(),field.getText());}
+    private boolean current(EntryState state){return owner!=null&&owner.isShowing()&&active()&&state.sameSession(snapshot());}
+    void update(GamepadState input,long now)
+    {
+        if(!active())return;
+        if((input.buttonsPressed&((1<<9)|(1<<10)))!=0){JTextField previous=field;boolean back=(input.buttonsPressed&(1<<9))!=0;deactivate();if(back)previous.transferFocusBackward();else previous.transferFocus();return;}
+        controls.update(snapshot(),input,now);if(active())draw();
+    }
+    private void draw()
+    {
+        String[] keys=controls.keys();
+        if(!Arrays.equals(drawn,keys)){
+            grid.removeAll();buttons.clear();drawn=keys;
+            for(int i=0;i<keys.length;i++){
+                final int key=i;JButton button=new JButton(keys[i].equals(" ")?"Space":keys[i]);button.setFocusable(false);button.setPreferredSize(new Dimension(65,32));
+                button.addActionListener(e->{if(!active())return;GamepadState click=new GamepadState();controls.update(snapshot(),click,System.nanoTime());controls.focusKey(key);click.buttonsHeld=click.buttonsPressed=1;controls.update(snapshot(),click,System.nanoTime());if(active())draw();});
+                buttons.add(button);grid.add(button);
+            }
+            grid.revalidate();grid.repaint();
+        }
+        for(int i=0;i<buttons.size();i++)buttons.get(i).setBackground(i==controls.index()?new Color(140,190,230):UIManager.getColor("Button.background"));
+    }
+}
