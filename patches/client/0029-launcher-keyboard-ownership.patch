@@ -0,0 +1,40 @@
+package net.runelite.client.soloscape.launcher;
+
+import java.awt.event.KeyEvent;
+import java.util.*;
+import javax.swing.*;
+import net.runelite.client.input.controller.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+
+public class LauncherKeyboardTest {
+    @Test public void steamOwnsAllControllerInputUntilEntryFinishes() throws Exception {
+        SwingUtilities.invokeAndWait(()->{
+            List<Boolean> requests=new ArrayList<>();LauncherKeyboard keyboard=new LauncherKeyboard(true,requests::add);
+            JTextField field=new JTextField();boolean[] advanced={false};keyboard.register(field,EntryState.LAUNCHER_LABEL,()->advanced[0]=true);
+            keyboard.activate(field);keyboard.activate(field);assertEquals(Arrays.asList(true),requests);
+            field.setText("SteamTyped");GamepadState input=new GamepadState();input.buttonsHeld=input.buttonsPressed=0x7fff;input.leftX=1;input.leftY=-1;
+            keyboard.update(input,System.nanoTime());assertEquals("SteamTyped",field.getText());assertTrue(keyboard.active());assertFalse(advanced[0]);
+            long before=keyboard.revision();field.postActionEvent();assertTrue(advanced[0]);assertFalse(keyboard.active());assertTrue(keyboard.revision()>before);assertEquals(Arrays.asList(true,false),requests);
+            keyboard.deactivate();assertEquals(2,requests.size());
+        });
+    }
+    @Test public void fallbackConsumesDesktopMappedNavigationOnlyDuringLocalEntry() throws Exception {
+        SwingUtilities.invokeAndWait(()->{
+            LauncherKeyboard keyboard=new LauncherKeyboard(false,open->{fail("Local fallback invoked Steam");});JTextField field=new JTextField("abc");
+            keyboard.register(field,EntryState.LAUNCHER_LABEL,()->{});keyboard.activate(field);field.setCaretPosition(3);
+            for(int key:new int[]{KeyEvent.VK_LEFT,KeyEvent.VK_RIGHT,KeyEvent.VK_UP,KeyEvent.VK_DOWN,KeyEvent.VK_ENTER,KeyEvent.VK_BACK_SPACE,KeyEvent.VK_SPACE,KeyEvent.VK_ESCAPE}){
+                KeyEvent event=new KeyEvent(field,KeyEvent.KEY_PRESSED,0,0,key,KeyEvent.CHAR_UNDEFINED);assertTrue(keyboard.consumeNavigation(event));assertTrue(event.isConsumed());
+            }
+            assertEquals(3,field.getCaretPosition());assertFalse(keyboard.consumeNavigation(new KeyEvent(new JTextField(),KeyEvent.KEY_PRESSED,0,0,KeyEvent.VK_LEFT,KeyEvent.CHAR_UNDEFINED)));
+            keyboard.deactivate();assertFalse(keyboard.consumeNavigation(new KeyEvent(field,KeyEvent.KEY_PRESSED,0,0,KeyEvent.VK_LEFT,KeyEvent.CHAR_UNDEFINED)));
+        });
+    }
+    @Test public void steamAllowsOrdinaryCursorKeysAndKeepsAccountValidation() throws Exception {
+        SwingUtilities.invokeAndWait(()->{
+            LauncherKeyboard keyboard=new LauncherKeyboard(true,open->{});JTextField field=new JTextField();keyboard.register(field,EntryState.LAUNCHER_ACCOUNT,()->{});keyboard.activate(field);
+            assertFalse(keyboard.consumeNavigation(new KeyEvent(field,KeyEvent.KEY_PRESSED,0,0,KeyEvent.VK_LEFT,KeyEvent.CHAR_UNDEFINED)));
+            field.setText("valid_name");field.setText("bad-name");assertEquals("valid_name",field.getText());keyboard.deactivate();
+        });
+    }
+}
