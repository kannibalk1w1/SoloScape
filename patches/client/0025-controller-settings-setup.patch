@@ -0,0 +1,27 @@
+package net.runelite.client.input.controller;
+import java.util.*;
+import org.junit.Test;
+import static org.junit.Assert.*;
+public class ControllerSettingsModelTest {
+ static class Memory implements ControllerSettingsModel.Store {Map<String,String> values=new HashMap<>();public String get(String key){return values.get(key);}public void set(String key,String value){values.put(key,value);}}
+ @Test public void settingsAreLocalAndRejectChangedPreferencesAndActions(){
+  Memory store=new Memory();ControllerSettingsModel model=new ControllerSettingsModel(store);
+  UiState.Widget deadzone=model.snapshot(true).panes[0].widgets[1];assertEquals("18",deadzone.status);
+  assertEquals(0,model.invoke(deadzone,deadzone.actions[0],true));assertEquals("20",store.get("deadzone"));
+  assertEquals(-1,model.invoke(deadzone,deadzone.actions[0],true));
+  UiState.Widget current=model.snapshot(true).panes[0].widgets[1];assertEquals(-1,model.invoke(current,new UiState.Action("Next",18,0),true));
+  assertEquals(0,model.invoke(current,current.actions[1],true));assertEquals("18",store.get("deadzone"));
+ }
+ @Test public void remappingSwapsTheExistingOwnerWithoutDuplicates(){
+  Memory store=new Memory();ControllerSettingsModel model=new ControllerSettingsModel(store);
+  UiState.Widget confirm=model.snapshot(false).panes[1].widgets[0];assertEquals(0,model.invoke(confirm,confirm.actions[0],false));
+  assertEquals("B",store.get("confirmButton"));assertEquals("A",store.get("cancelButton"));assertEquals("CUSTOM",store.get("preset"));
+  Set<String> used=new HashSet<>();for(UiState.Widget w:model.snapshot(false).panes[1].widgets)assertTrue(used.add(w.status));
+ }
+ @Test public void nativeSettingsAndSetupCompletionRemainSeparate(){
+  Memory store=new Memory();ControllerSettingsModel model=new ControllerSettingsModel(store);
+  UiState.Widget game=model.snapshot(true).panes[3].widgets[0],done=model.snapshot(true).panes[3].widgets[1];
+  assertEquals(1,model.invoke(game,game.actions[0],true));assertNull(store.get("setupComplete"));
+  assertEquals(2,model.invoke(done,done.actions[0],true));assertEquals("true",store.get("setupComplete"));
+ }
+}
