+package net.runelite.client.input.controller;
+
+import java.awt.Rectangle;
+import java.util.*;
+
+/** Local preferences only. These action IDs must never reach the native widget gateway. */
+public final class ControllerSettingsModel {
+ public static final int ID=65534, ACTION=-100;
+ public interface Store {String get(String key);void set(String key,String value);}
+ private static final class Option {
+  final String key,label,help;final String[] values;
+  Option(String key,String label,String help,String...values){this.key=key;this.label=label;this.help=help;this.values=values;}
+ }
+ private static Option toggle(String key,String label){return new Option(key,label,"A toggles this preference; B returns to Home.","false","true");}
+ private static Option range(String key,String label,int first,int last,int step,int fallback){
+  List<String> values=new ArrayList<>();values.add(String.valueOf(fallback));for(int i=fallback+step;i<=last;i+=step)values.add(String.valueOf(i));for(int i=first;i<fallback;i+=step)values.add(String.valueOf(i));
+  return new Option(key,label,"A / X: increase or decrease. Native game settings remain available below.",values.toArray(new String[0]));
+ }
+ private static final String[] BUTTONS={"A","B","X","Y","LEFT_BUMPER","RIGHT_BUMPER","VIEW","START","LEFT_STICK","RIGHT_STICK"};
+ private static Option button(String key,String label,String fallback){List<String> values=new ArrayList<>();values.add(fallback);for(String b:BUTTONS)if(!b.equals(fallback))values.add(b);return new Option(key,label,"Changing a binding swaps the existing owner, keeping all buttons distinct. Release controls before continuing.",values.toArray(new String[0]));}
+ private static final Option[][] OPTIONS={
+  {new Option("preset","Preset","A selects a preset. It applies its defaults on the next input tick.","CUSTOM","XBOX","PLAYSTATION","STEAM_DECK"),
+   range("deadzone","Stick deadzone (%)",0,90,2,18),range("overlayScale","Overlay size (%)",75,175,5,100),range("runThreshold","Run threshold (%)",50,100,5,90),
+   toggle("directMovement","Direct movement"),toggle("serverFeatures","SoloScape server features"),toggle("invertY","Invert camera Y"),
+   new Option("glyphs","Button labels","Choose the labels displayed in controller hints.","XBOX","PLAYSTATION"),toggle("showGuide","Controller guide")},
+  {button("confirmButton","Confirm / interact","A"),button("cancelButton","Back / cancel","B"),button("actionsButton","Actions / assign","X"),
+   button("previousButton","Previous target / pane","LEFT_BUMPER"),button("nextButton","Next target / pane","RIGHT_BUMPER"),
+   button("inventoryButton","Inventory","Y"),button("homeButton","Home wheel","VIEW"),button("quickButton","Quick wheel","START")},
+  {toggle("customInventory","Custom inventory"),toggle("customEquipment","Custom equipment"),toggle("customBank","Custom bank"),toggle("customShop","Custom shop"),
+   toggle("customQuests","Custom quests"),toggle("customSkills","Custom skills"),toggle("customCombat","Custom combat"),toggle("customPrayer","Custom prayer"),toggle("customSpellbook","Custom spellbook")}
+ };
+ private final Store store;
+ public ControllerSettingsModel(Store store){this.store=store;}
+ private String value(Option option){String value=store.get(option.key);return value==null||value.isEmpty()?option.values[0]:value;}
+ public UiState.Panel snapshot(boolean setup){
+  UiState.Pane[] panes=new UiState.Pane[4];String[] names={"Basics","Bindings","Screens"};
+  for(int p=0;p<OPTIONS.length;p++){
+   UiState.Widget[] widgets=new UiState.Widget[OPTIONS[p].length];
+   for(int i=0;i<widgets.length;i++){Option o=OPTIONS[p][i];widgets[i]=row(p*100+i,o.label,value(o),o.help,"Next","Previous");}
+   panes[p]=new UiState.Pane(names[p],widgets);
+  }
+  panes[3]=new UiState.Pane("Finish",new UiState.Widget[]{row(900,"Game settings","","Open the native game settings; all existing submenus remain available.","Open"),
+    row(901,setup?"Finish controller setup":"Return to Home","","Preferences persist as you change them. You can reopen this screen from Home > Settings.","Done")});
+  return new UiState.Panel(ID,0,setup?"Controller setup":"Controller settings",panes,false);
+ }
+ private UiState.Widget row(int component,String name,String status,String detail,String...labels){
+  UiState.Action[] actions=new UiState.Action[labels.length];for(int i=0;i<labels.length;i++)actions[i]=new UiState.Action(labels[i],ACTION,i);
+  return new UiState.Widget(ID<<16|component,-1,-1,0,name,new Rectangle(0,component*32,400,28),actions,detail,status);
+ }
+ /** Return 1 for native settings, 2 for done, 0 for a preference change, -1 for stale input. */
+ public int invoke(UiState.Widget expected,UiState.Action action,boolean setup){
+  if(expected==null||action==null||action.type!=ACTION)return -1;
+  UiState.Widget fresh=null;
+  for(UiState.Pane pane:snapshot(setup).panes)for(UiState.Widget row:pane.widgets)if(row.same(expected)&&row.status.equals(expected.status))fresh=row;
+  if(fresh==null)return -1;boolean permitted=false;for(UiState.Action a:fresh.actions)if(a.same(action))permitted=true;if(!permitted)return -1;
+  int component=expected.id&65535;if(component==900)return 1;if(component==901){store.set("setupComplete","true");return 2;}
+  int pane=component/100,index=component%100;if(pane>=OPTIONS.length||index>=OPTIONS[pane].length)return -1;
+  Option option=OPTIONS[pane][index];String old=value(option);int next=Arrays.asList(option.values).indexOf(old);
+  next=Math.floorMod((next<0?0:next)+(action.operation==1?-1:1),option.values.length);String replacement=option.values[next];
+  if(pane==1){for(Option other:OPTIONS[1])if(other!=option&&value(other).equals(replacement))store.set(other.key,old);store.set("preset","CUSTOM");}
+  store.set(option.key,replacement);return 0;
+ }
+}
