+    private static final class ReachabilityKey
+    {
+        final int kind, x, y, width, height;
+        final long object;
+
+        ReachabilityKey(ControllerTarget t)
+        {
+            kind = t.kind(); x = t.x; y = t.y; width = t.width; height = t.height;
+            // Object identity encodes shape/rotation/definition access restrictions.
+            // NPCs of equal size and all ground items share the same path geometry.
+            object = kind == 2 ? t.identifier : 0;
+        }
+
+        @Override public boolean equals(Object other)
+        {
+            if (!(other instanceof ReachabilityKey)) return false;
+            ReachabilityKey key = (ReachabilityKey) other;
+            return kind == key.kind && x == key.x && y == key.y
+                && width == key.width && height == key.height && object == key.object;
+        }
+
+        @Override public int hashCode()
+        {
+            int hash = (((kind * 31 + x) * 31 + y) * 31 + width) * 31 + height;
+            return hash * 31 + (int) (object ^ (object >>> 32));
+        }
+    }
+
+    private static boolean reachable(ControllerTarget t, Map<ReachabilityKey, Boolean> paths)
+    {
+        ReachabilityKey key = new ReachabilityKey(t);
+        Boolean cached = paths.get(key);
+        if (cached != null) return cached;
+        if (paths.size() >= 8) return false;
+        boolean result = reachable(t);
+        paths.put(key, result);
+        return result;
+    }
+
