+    @Test fun `running turns around a corner in every quadrant without cutting the diagonal`() {
+        for (x in listOf(-1, 1)) for (y in listOf(-1, 1)) {
+            val origin = Tile(64, 64)
+            player.tile = origin
+            val allowed = setOf(origin, origin.add(x, 0), origin.add(x, y))
+            val flags = CollisionFlagMap()
+            for (px in 60..68) for (py in 60..68) {
+                flags.allocateIfAbsent(px, py, 0)
+                flags[px, py, 0] = -1
+            }
+            allowed.forEach { flags[it.x, it.y, it.level] = 0 }
+            val nativeValidator = StepValidator(flags)
+            every { validator.canTravel(any(), any(), any(), any(), any(), any(), any(), any()) } answers {
+                nativeValidator.canTravel(arg(0), arg(1), arg(2), arg(3), arg(4), arg(5), arg(6), arg(7))
+            }
+            mode(x, y, run = true).tick()
+            assertEquals(origin.add(x, y), player.tile)
+            assertTrue(player.steps.isEmpty())
+            assertEquals(if (x == 1) 2 else 6, player.visuals.walkStep)
+            assertEquals(if (y == 1) 0 else 4, player.visuals.runStep)
+        }
+    }
