+
+/**
+ * One connected spirit wolf supply chain on a single player and inventory, with every step native:
+ *
+ * 1. A real level 1 owner (empty xp) kills the Stronghold wolf with a fatal hit and a lowest drop roll. The
+ *    native death and floor publication create the gold charm and wolf bones. Nothing is injected.
+ * 2. The drops are taken with the native Take option.
+ * 3. The owner is teleported next to Pikkupstix (fixture). Only coins are supplied, as the shop currency.
+ *    The shard and blank pouch quantities and prices are read from the cached pouch and shop [Price].
+ * 4. The shop is closed with the native interface-close API and the owner is teleported to the obelisk (fixture). The
+ *    pouch is infused from the materials acquired above.
+ * 5. The pouch is summoned. The follower, pouch and points are checked against the native definitions.
+ *
+ * The members setting is set for this case and restored afterwards. The owner's coins, teleports and fatal
+ * damage are fixtures, not earned results. The save-and-reload recovery is not exercised here.
+ */
+@EnabledIfEnvironmentVariable(named = "SOLOSCAPE_TEST_ROOT", matches = ".+")
+class ConnectedSpiritWolfSupplyTest : WorldTest() {
+
+    private val deathTile = Tile(1873, 5239)
+    private val wolfSideTile = Tile(1873, 5238)
+    private val pikkupstixTile = Tile(2925, 3443)
+    private val obeliskTile = Tile(2521, 3055)
+    private val obeliskSideTile = Tile(2523, 3056)
+    private val pouchId = "spirit_wolf_pouch"
+    private val familiarId = "spirit_wolf_familiar"
+
+    private fun setMembers(value: String): String? {
+        val previous = settings["world.members"] as? String
+        settings["world.members"] = value
+        return previous
+    }
+
+    private fun restoreMembers(previous: String?) {
+        if (previous == null) {
+            settings.remove("world.members")
+        } else {
+            settings["world.members"] = previous
+        }
+    }
+
+    /** Creates the wolf at its configured tile, hits it fatally from the player, and runs the native death. */
+    private fun killWolf(player: Player) {
+        val wolf = createNPC("wolf_stronghold_of_security", deathTile)
+        val hitpoints = wolf.levels.get(Skill.Constitution)
+        assertTrue(hitpoints > 0, "the native wolf starts alive")
+        assertEquals(hitpoints, player.hit(wolf, damage = hitpoints, delay = 0))
+        // The roll is forced to its lowest value after the hit is launched, so the native death uses it.
+        setRandom(object : FakeRandom() {
+            override fun nextInt(from: Int, until: Int) = from
+        })
+        tickIf(20) { wolf.levels.get(Skill.Constitution) > 0 }
+        assertEquals(0, wolf.levels.get(Skill.Constitution), "the supplied fatal hit must kill the wolf")
+        assertTrue(wolf.dead, "native death processing was entered")
+        assertSame(player, wolf.killer, "the native damage path attributes the kill to the player")
+        tickIf(100) { !wolf.hide && wolf.index > 0 }
+        assertTrue(wolf.hide || wolf.index <= 0, "native corpse processing finishes before collecting loot")
+        tick() // Publish any floor items queued by the completed native death.
+    }
+
+    /** Talks to Pikkupstix and picks "Can I buy some Summoning supplies, please?", asserting each stage. */
+    private fun buySupplies(player: Player) {
+        val pikkupstix = createNPC("pikkupstix", pikkupstixTile)
+        player.npcOption(pikkupstix, "Talk-to")
+        tick(2)
+        assertTrue(player.dialogue.orEmpty().startsWith("dialogue_npc_chat")) { "stage 1 is the tutor's greeting, was ${player.dialogue}" }
+        player.dialogueContinue()
+        assertTrue(player.dialogue.orEmpty().startsWith("dialogue_multi")) { "stage 2 is the choice menu, was ${player.dialogue}" }
+        player.dialogueOption(2) // "Can I buy some Summoning supplies, please?"
+        assertTrue(player.dialogue.orEmpty().startsWith("dialogue_chat")) { "stage 3 is the player's chosen line, was ${player.dialogue}" }
+        player.dialogueContinue()
+        assertTrue(player.dialogue.orEmpty().startsWith("dialogue_npc_chat")) { "stage 4 is the tutor's reply, was ${player.dialogue}" }
+        player.dialogueContinue()
+        tick(2)
+        assertTrue(player.hasOpen("shop")) { "the summoning supplies shop did not open" }
+        assertEquals("summoning_supplies", player.shop())
+    }
+
+    /** The shop interface slot for an item, as the stock list is laid out (six slots per row). */
+    private fun stockSlot(player: Player, item: String) = player.shopInventory(false).indexOf(item) * 6
+
+    private fun ownedFamiliars(player: Player) = NPCs.count { it.id == familiarId && it["owner_index", -1] == player.index }
+
+    @Test
+    fun `Wolf drops buy shards and a blank pouch, then infuse and summon one spirit wolf from the same inventory`() {
+        val previous = setMembers("true")
+        try {
+            val pouch = Item(pouchId)
+            val charmId: Int = pouch.def["summoning_charm_id"]
+            val charmAmount: Int = pouch.def["summoning_charm_amount"]
+            val shardId: Int = pouch.def["summoning_shard_id"]
+            val shardAmount: Int = pouch.def["summoning_shard_amount"]
+            val blankId: Int = pouch.def["summoning_pouch_id"]
+            val blankAmount: Int = pouch.def["summoning_pouch_amount"]
+            val tertiaryId: Int = pouch.def["summoning_pouch_req_item_id_1"]
+            val tertiaryAmount: Int = pouch.def["summoning_pouch_req_item_amount_1"]
+            val charm = ItemDefinitions.get(charmId).stringId
+            val shard = ItemDefinitions.get(shardId).stringId
+            val blank = ItemDefinitions.get(blankId).stringId
+            val tertiary = ItemDefinitions.get(tertiaryId).stringId
+            val wolfDrops = mapOf(charm to charmAmount, tertiary to tertiaryAmount)
+            val recipe = mapOf(charm to charmAmount, tertiary to tertiaryAmount, shard to shardAmount, blank to blankAmount)
+            val infuseXp: Double = ItemDefinitions.get(pouchId)["infuse_experience"]
+            val summonPoints: Int = ItemDefinitions.get(pouchId)["summon_points"]
+            val summonXp: Double = ItemDefinitions.get(pouchId)["summon_experience"]
+            assertEquals(mapOf("gold_charm" to 1, "wolf_bones" to 1, "spirit_shards" to 7, "pouch" to 1), recipe, "the native beginner recipe is the recorded four-ingredient contract")
+
+            // 0. Real beginner: level 1 with empty xp, so nothing here is maxed to bypass the requirement.
+            val player = createPlayer(wolfSideTile)
+            assertEquals(1, player.levels.get(Skill.Summoning), "the owner starts at real Summoning level 1")
+            assertEquals(0.0, player.experience.get(Skill.Summoning), 0.0001, "the owner starts with empty Summoning xp")
+            assertEquals(setOf("gold_charm", "wolf_bones"), wolfDrops.keys, "the pouch recipe's charm and tertiary are the wolf's members drops")
+            assertTrue(ItemDefinitions.get("gold_charm").members && ItemDefinitions.get("wolf_bones").members, "both drops are members-only")
+
+            // 1. Native wolf death from a fatal hit, then the native Take of each floor drop.
+            killWolf(player)
+            for ((id, amount) in wolfDrops) {
+                val floorItem = FloorItems.firstOrNull(deathTile, id)
+                assertNotNull(floorItem, "the wolf death publishes $id")
+                assertEquals(amount, floorItem!!.amount, "the lowest roll drops $amount of $id")
+                player.floorItemOption(floorItem, "Take")
+                tick(2)
+            }
+            assertEquals(charmAmount, player.inventory.count(charm), "the charm is taken once")
+            assertEquals(tertiaryAmount, player.inventory.count(tertiary), "the bones are taken once")
+            assertNull(FloorItems.firstOrNull(deathTile, charm), "the charm is no longer on the floor")
+            assertNull(FloorItems.firstOrNull(deathTile, tertiary), "the bones are no longer on the floor")
+
+            // 2. Fixture teleport to Pikkupstix, with coins as the only supplied currency.
+            player.tele(pikkupstixTile.addY(-1))
+            player.inventory.add("coins", 1000)
+            buySupplies(player)
+            val shop = player.shopInventory(false)
+            val shardStock = shop.count(shard)
+            val blankStock = shop.count(blank)
+            val shardPrice = Price.of(shard)
+            val blankPrice = Price.of(blank)
+            repeat(shardAmount) {
+                player.interfaceOption("shop", "stock", "Buy-1", item = Item(shard), slot = stockSlot(player, shard))
+            }
+            tick()
+            repeat(blankAmount) {
+                player.interfaceOption("shop", "stock", "Buy-1", item = Item(blank), slot = stockSlot(player, blank))
+            }
+            tick()
+            assertEquals(shardAmount, player.inventory.count(shard), "the shard recipe quantity is bought")
+            assertEquals(blankAmount, player.inventory.count(blank), "the blank pouch recipe quantity is bought")
+            assertEquals(shardStock - shardAmount, shop.count(shard), "the shop loses exactly the shards bought")
+            assertEquals(blankStock - blankAmount, shop.count(blank), "the shop loses exactly the blank pouches bought")
+            val spent = shardAmount * shardPrice + blankAmount * blankPrice
+            assertEquals(1000 - spent, player.inventory.count("coins"), "coins are charged the native shop prices")
+            assertEquals(charmAmount, player.inventory.count(charm), "the wolf charm is kept through shopping")
+            assertEquals(tertiaryAmount, player.inventory.count(tertiary), "the wolf bones are kept through shopping")
+
+            // 3. Close the shop through the native close path, then teleport to the obelisk (fixture).
+            // shop.ifaces.toml defines no close component, so the engine's closeInterfaces is the native path.
+            player.closeInterfaces()
+            tick()
+            assertFalse(player.hasOpen("shop"), "the native interface-close path closes the shop")
+            player.tele(obeliskSideTile)
+
+            // 4. Infuse from exactly the materials collected and purchased above.
+            for ((id, amount) in recipe) {
+                assertEquals(amount, player.inventory.count(id), "precondition: $amount of $id is ready to infuse")
+            }
+            val xpBeforeInfuse = player.experience.get(Skill.Summoning)
+            player.objectOption(GameObjects.find(obeliskTile, "obelisk"), "Infuse-pouch")
+            tick()
+            // The obelisk interface addresses pouches by enum index: (slot + 3) / 5 in SummoningCrafting.
+            val enumIndex = EnumDefinitions.get("summoning_pouch_ids_1").map!!.entries.first { it.value == pouch.def.id }.key as Int
+            player.interfaceOption("summoning_pouch_creation", "pouches", "Infuse", item = Item(pouchId), slot = enumIndex * 5 - 3)
+            tick()
+            for (id in recipe.keys) {
+                assertEquals(0, player.inventory.count(id), "infusing consumes all of $id")
+            }
+            assertEquals(1, player.inventory.count(pouchId), "infusing makes exactly one spirit wolf pouch")
+            assertEquals(infuseXp, player.experience.get(Skill.Summoning) - xpBeforeInfuse, 0.0001, "infusing awards the pouch's infuse_experience")
+            assertNull(FloorItems.firstOrNull(deathTile, charm), "no duplicate charm is published on the floor after infusing")
+            assertNull(FloorItems.firstOrNull(deathTile, tertiary), "no duplicate bones are published on the floor after infusing")
+
+            // 5. Summon from the pouch that was infused from the collected materials.
+            val pointsBeforeSummon = player.levels.get(Skill.Summoning)
+            val xpBeforeSummon = player.experience.get(Skill.Summoning)
+            player.itemOption("Summon", pouchId)
+            tick(3)
+            assertEquals(familiarId, player.follower?.id, "the summoned spirit wolf is the follower")
+            assertEquals(1, ownedFamiliars(player), "exactly one spirit wolf is in the world for this owner")
+            assertSame(player, player.follower!!.familiarOwner(), "native familiar ownership resolves to the same player")
+            assertEquals(0, player.inventory.count(pouchId), "summoning consumes the pouch")
+            assertEquals(pointsBeforeSummon - summonPoints, player.levels.get(Skill.Summoning), "summoning costs the pouch's summon_points")
+            assertEquals(summonXp, player.experience.get(Skill.Summoning) - xpBeforeSummon, 0.0001, "summoning awards exactly the cached summon_experience")
+            assertEquals(0, player.inventory.count(charm) + player.inventory.count(tertiary), "no wolf ingredients are left after summoning")
+            tick(20)
+            assertEquals(1, ownedFamiliars(player), "further ticks retain exactly one owned familiar")
+            assertSame(player, player.follower!!.familiarOwner())
+            for (id in recipe.keys + pouchId) assertEquals(0, player.inventory.count(id), "no duplicated material or pouch: $id")
+            assertNull(FloorItems.firstOrNull(deathTile, charm))
+            assertNull(FloorItems.firstOrNull(deathTile, tertiary))
+        } finally {
+            setRandom(FakeRandom())
+            restoreMembers(previous)
+        }
+    }
+}
