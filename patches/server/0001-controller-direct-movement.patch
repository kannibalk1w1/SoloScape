+package world.gregs.voidps.engine.entity.character.mode.move
+
+import io.mockk.every
+import io.mockk.verify
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.Test
+import org.koin.test.mock.declareMock
+import org.rsmod.game.pathfinder.*
+import org.rsmod.game.pathfinder.collision.CollisionStrategies
+import world.gregs.voidps.engine.client.instruction.handle.DirectMovementHandler
+import world.gregs.voidps.engine.client.variable.start
+import world.gregs.voidps.engine.data.definition.Areas
+import world.gregs.voidps.engine.entity.character.mode.EmptyMode
+import world.gregs.voidps.engine.entity.character.mode.move.target.TileTargetStrategy
+import world.gregs.voidps.engine.entity.character.move.running
+import world.gregs.voidps.engine.entity.character.player.Player
+import world.gregs.voidps.engine.inv.restrict.ValidItemRestriction
+import world.gregs.voidps.engine.inv.stack.ItemDependentStack
+import world.gregs.voidps.engine.script.KoinMock
+import world.gregs.voidps.network.client.instruction.DirectMovement
+import world.gregs.voidps.type.Tile
+
+class DirectMovementModeTest : KoinMock() {
+    private lateinit var player: Player
+    private lateinit var validator: StepValidator
+    private lateinit var pathFinder: PathFinder
+    private var now = 1L
+
+    @BeforeEach fun setup() {
+        player = Player(tile = Tile(64, 64))
+        player.collision = CollisionStrategies.Normal
+        player.inventories.normalStack = ItemDependentStack
+        player.inventories.player = player
+        player.inventories.validItemRule = ValidItemRestriction()
+        Areas.clear()
+        pathFinder = declareMock<PathFinder>()
+        validator = declareMock<StepValidator> { every { canTravel(any(), any(), any(), any(), any(), any(), any(), any()) } returns true }
+        declareMock<LineValidator>()
+    }
+    private fun mode(x: Int = 1, y: Int = 0, run: Boolean = false): DirectMovementMode {
+        val mode = DirectMovementMode(player, DirectMovement(x, y, run, now)) { now }
+        player.mode = mode
+        return mode
+    }
+    @Test fun `held intent takes one local step per tick without pathfinding or leftovers`() {
+        val mode = mode()
+        mode.tick(); assertEquals(Tile(65, 64), player.tile); assertTrue(player.steps.isEmpty())
+        mode.tick(); assertEquals(Tile(66, 64), player.tile); assertTrue(player.steps.isEmpty())
+        verify(exactly = 0) { pathFinder.findPath(any(), any(), any(), any(), any()) }
+    }
+    @Test fun `full tilt runs while gentle input and depleted energy walk without changing run preference`() {
+        player.running = false
+        val mode = mode(run = true)
+        mode.tick(); assertEquals(Tile(66, 64), player.tile); assertFalse(player.running)
+        mode.update(DirectMovement(1, 0, false, now))
+        player.running = true
+        mode.tick(); assertEquals(Tile(67, 64), player.tile); assertTrue(player.running)
+        player["energy"] = 0
+        mode.update(DirectMovement(1, 0, true, now))
+        mode.tick(); assertEquals(Tile(68, 64), player.tile)
+    }
+    @Test fun `turns apply on the next tick and cannot route around a wall`() {
+        val mode = mode()
+        mode.tick()
+        mode.update(DirectMovement(0, 1, false, now)); mode.tick()
+        assertEquals(Tile(65, 65), player.tile)
+        every { validator.canTravel(any(), any(), any(), any(), any(), any(), any(), any()) } returns false
+        mode.tick(); assertEquals(Tile(65, 65), player.tile); assertTrue(player.steps.isEmpty())
+    }
+    @Test fun `release clears intent and stale messages do not cancel a newer mouse walk`() {
+        val mode = mode()
+        DirectMovementHandler.handle(player, DirectMovement(0, 0, false))
+        assertSame(EmptyMode, player.mode); assertTrue(player.steps.isEmpty())
+        val mouse = Movement(player, TileTargetStrategy(Tile(68, 64)))
+        player.mode = mouse
+        DirectMovementHandler.handle(player, DirectMovement(0, 0, false))
+        assertSame(mouse, player.mode)
+        assertNotSame(mode, player.mode)
+    }
+    @Test fun `missing heartbeats expire intent and queued delayed input is rejected`() {
+        val mode = mode()
+        now += DirectMovement.TIMEOUT_NANOS
+        mode.tick(); assertEquals(Tile(64, 64), player.tile); assertSame(EmptyMode, player.mode)
+        DirectMovementHandler.handle(player, DirectMovement(1, 0, false, System.nanoTime() - DirectMovement.TIMEOUT_NANOS - 1))
+        assertSame(EmptyMode, player.mode)
+    }
+    @Test fun `movement delay prevents direct movement and leaves no future steps`() {
+        val mode = mode()
+        player.start("movement_delay", -1)
+        mode.tick(); assertEquals(Tile(64, 64), player.tile); assertTrue(player.steps.isEmpty())
+    }
+    @Test fun `normal replacement and teleports cannot keep directional steps alive`() {
+        val mode = mode()
+        player.steps.queueStep(Tile(65, 64))
+        player.mode = EmptyMode
+        assertTrue(player.steps.isEmpty())
+        assertNotSame(mode, player.mode)
+    }
+}
