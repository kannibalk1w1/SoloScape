+package world.gregs.voidps.network.login.protocol
+
+import io.ktor.utils.io.core.*
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import world.gregs.voidps.cache.secure.Huffman
+import world.gregs.voidps.network.client.instruction.DirectMovement
+
+class DirectMovementDecoderTest {
+    @Test fun `opcode 85 decodes every direction and stop with fixed length`() = runTest {
+        val decoder = decoders(Huffman())[85]!!
+        assertEquals(3, decoder.length)
+        for (x in -1..1) for (y in -1..1) for (run in 0..1) {
+            val packet = ByteReadPacket(byteArrayOf(x.toByte(), y.toByte(), run.toByte()))
+            val input = decoder.decode(packet) as DirectMovement
+            assertEquals(x, input.dx); assertEquals(y, input.dy); assertEquals(run == 1, input.run)
+            assertTrue(packet.isEmpty)
+        }
+    }
+    @Test fun `malformed vectors and flags are rejected`() = runTest {
+        val decoder = decoders(Huffman())[85]!!
+        for (bytes in listOf(byteArrayOf(2, 0, 0), byteArrayOf(0, -2, 0), byteArrayOf(0, 1, 2)))
+            assertNull(decoder.decode(ByteReadPacket(bytes)))
+    }
+}
