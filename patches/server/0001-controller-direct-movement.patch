+package world.gregs.voidps.network.login.protocol.decode
+
+import kotlinx.io.Source
+import world.gregs.voidps.network.client.Instruction
+import world.gregs.voidps.network.client.instruction.DirectMovement
+import world.gregs.voidps.network.login.protocol.Decoder
+
+/** Custom opcode 85, fixed payload: signed dx, signed dy, run flag (0/1). */
+class DirectMovementDecoder : Decoder(3) {
+    override suspend fun decode(packet: Source): Instruction? {
+        val dx = packet.readByte().toInt()
+        val dy = packet.readByte().toInt()
+        val run = packet.readByte().toInt()
+        if (dx !in -1..1 || dy !in -1..1 || run !in 0..1) return null
+        return DirectMovement(dx, dy, run == 1)
+    }
+}
