+package world.gregs.voidps.engine.client.instruction.handle
+
+import world.gregs.voidps.engine.client.ui.closeInterfaces
+import world.gregs.voidps.engine.entity.character.mode.EmptyMode
+import world.gregs.voidps.engine.entity.character.mode.interact.Interact
+import world.gregs.voidps.engine.entity.character.mode.move.DirectMovementMode
+import world.gregs.voidps.engine.entity.character.player.Player
+import world.gregs.voidps.network.client.instruction.DirectMovement
+
+object DirectMovementHandler {
+    fun handle(player: Player, input: DirectMovement) {
+        if (!input.valid) return
+        val current = player.mode as? DirectMovementMode
+        if (input.stopped) {
+            // A late stop must not cancel a newer mouse walk, interaction, teleport or dialogue.
+            if (current != null) player.mode = EmptyMode
+            return
+        }
+        if (System.nanoTime() - input.receivedAt >= DirectMovement.TIMEOUT_NANOS || player.contains("delay")) return
+        if (current != null) {
+            current.update(input)
+            return
+        }
+        if (player.mode is Interact) player.clearAnim()
+        player.closeInterfaces()
+        player.clearWatch()
+        player.queue.clearWeak()
+        player.suspension = null
+        player.mode = DirectMovementMode(player, input)
+        player.walkTrigger()
+    }
+}
