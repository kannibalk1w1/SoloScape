+        try{runBlocking{SaveQueue(FileStorage(dir.toFile())).direct().join()};val save=PlayerSave.load(dir.resolve("${player.accountName.lowercase()}.toml").toFile());assertEquals(player.tile,save.tile);assertEquals("completed",save.variables[quest]);assertArrayEquals(player.experience.experience,save.experience);for((id,inv)in player.inventories.instances)assertArrayEquals(inv.items,save.inventories[id])}finally{dir.toFile().deleteRecursively()}
+    }
