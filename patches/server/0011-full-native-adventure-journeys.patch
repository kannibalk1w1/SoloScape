+    private fun near(center:Tile,radius:Int,predicate:(GameObject)->Boolean):GameObject {
+        for(x in center.x-radius..center.x+radius)for(y in center.y-radius..center.y+radius){val obj=GameObjects.findOrNull(Tile(x,y,center.level),predicate);if(obj!=null)return obj}
+        error("Native object not found near $center")
+    }
+    private fun openNear(player:Player,center:Tile,radius:Int){
+        for(x in center.x-radius..center.x+radius)for(y in center.y-radius..center.y+radius){
+            val obj=GameObjects.findOrNull(Tile(x,y,center.level)){(it.def(player).name.contains("door",true)||it.def(player).name.contains("gate",true))&&it.def(player).options?.contains("Open")==true}?:continue
+            println("Route opens ${obj.id}@${obj.tile}");player.objectOption(obj,"Open");repeat(40){if(GameObjects.findOrNull(obj.tile,obj.intId)!=null)tick()}
+        }
+    }
+    private fun crossBorder(player:Player,click:Tile,exit:Tile) {
+        repeat(40){if(player.contains("delay"))tick()}
+        assertTrue(!player.contains("delay"))
+        player.walk(click)
+        repeat(100){if(player.tile!=exit||player.contains("delay"))tick()}
+        assertEquals(exit,player.tile,"Native border crossing did not reach its opposite-side endpoint")
+        assertTrue(!player.contains("delay"))
+    }
+    private fun travel(player:Player,route:List<Tile>){
+        for(tile in route){
+            // Border guards perform their native crossing and reject new Walk input
+            // during the three-tick delay. Do not lose the next intent at that handoff.
+            repeat(40){if(player.contains("delay"))tick()}
+            assertTrue(!player.contains("delay"),"Native movement delay did not settle")
+            println("Journey walk ${player.tile} -> $tile hp=${player.levels.get(Skill.Constitution)} mode=${player.mode}");player.walk(tile);repeat(100){if(player.tile!=tile)tick()}
+            val nearby=mutableListOf<String>()
+            if(player.tile!=tile)for(x in minOf(player.tile.x,tile.x)-8..maxOf(player.tile.x,tile.x)+8)for(y in minOf(player.tile.y,tile.y)-8..maxOf(player.tile.y,tile.y)+8){val obj=GameObjects.findOrNull(Tile(x,y,player.tile.level)){it.def(player).options?.any{it=="Open"||it?.startsWith("Climb")==true}==true};if(obj!=null)nearby.add("${obj.id}@${obj.tile}")}
+            if(player.tile!=tile)collisionPicture(player,tile)
+            assertEquals(tile,player.tile,"Actual route blocked; nearby native transitions $nearby")}
+    }
+    private fun collisionPicture(player:Player,target:Tile){
+        val minX=minOf(player.tile.x,target.x)-40;val maxX=maxOf(player.tile.x,target.x)+40;val minY=minOf(player.tile.y,target.y)-40;val maxY=maxOf(player.tile.y,target.y)+40;val scale=6
+        val image=java.awt.image.BufferedImage((maxX-minX+1)*scale+50,(maxY-minY+1)*scale+40,java.awt.image.BufferedImage.TYPE_INT_RGB)
+        val g=image.createGraphics();g.color=java.awt.Color.WHITE;g.fillRect(0,0,image.width,image.height)
+        val step=get<org.rsmod.game.pathfinder.StepValidator>()
+        for(x in minX..maxX)for(y in minY..maxY){val px=40+(x-minX)*scale;val py=20+(maxY-y)*scale
+            if(!step.canFit(Tile(x,y,target.level),player.collision,1,0)){g.color=java.awt.Color.GRAY;g.fillRect(px,py,scale,scale)}
+            g.color=java.awt.Color.BLACK
+            if(!step.canTravel(x=x,z=y,level=target.level,offsetX=1,offsetZ=0,size=1,extraFlag=0))g.drawLine(px+scale,py,px+scale,py+scale)
+            if(!step.canTravel(x=x,z=y,level=target.level,offsetX=0,offsetZ=1,size=1,extraFlag=0))g.drawLine(px,py,px+scale,py)
+        }
+        for(x in minX..maxX step 10){g.color=java.awt.Color.BLACK;g.drawString("$x",40+(x-minX)*scale,14)}
+        for(y in minY..maxY step 10){g.color=java.awt.Color.BLACK;g.drawString("$y",0,25+(maxY-y)*scale)}
+        for((tile,color)in listOf(target to java.awt.Color.RED,player.tile to java.awt.Color.BLUE)){g.color=color;g.fillOval(37+(tile.x-minX)*scale,17+(maxY-tile.y)*scale,10,10)}
+        g.dispose();val path=java.nio.file.Path.of(System.getenv("SOLOSCAPE_TEST_ROOT"),"collision-debug.png");Files.createDirectories(path.parent);javax.imageio.ImageIO.write(image,"png",path.toFile())
+        println("Route failed destination=${player.steps.destination} remaining=${player.steps.size} mode=${player.mode} delay=${player["delay",0]} viewportLoaded=${player.viewport?.loaded}; collision map at $path")
+    }
+    private fun verifySave(player:Player,quest:String){
