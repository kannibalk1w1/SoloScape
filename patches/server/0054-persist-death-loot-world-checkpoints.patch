@@ -0,0 +1,104 @@
+package content.area.misthalin.lumbridge.church
+
+import content.entity.player.modal.map.MapMarkers
+import content.entity.combat.dead
+import world.gregs.voidps.engine.entity.character.player.Players
+import world.gregs.voidps.engine.client.variable.remaining
+import world.gregs.voidps.engine.client.variable.start
+import world.gregs.voidps.engine.data.DeathLootSnapshot
+import world.gregs.voidps.engine.data.SaveQueue
+import world.gregs.voidps.engine.data.Settings
+import world.gregs.voidps.engine.data.Storage
+import world.gregs.voidps.engine.data.definition.ItemDefinitions
+import world.gregs.voidps.engine.data.definition.NPCDefinitions
+import world.gregs.voidps.engine.data.file.FileStorage
+import world.gregs.voidps.engine.entity.character.npc.NPC
+import world.gregs.voidps.engine.entity.character.npc.NPCs
+import world.gregs.voidps.engine.entity.character.player.Player
+import world.gregs.voidps.engine.entity.character.player.male
+import world.gregs.voidps.engine.entity.character.player.name
+import world.gregs.voidps.engine.entity.item.floor.FloorItem
+import world.gregs.voidps.engine.entity.item.floor.FloorItems
+import world.gregs.voidps.engine.get
+import world.gregs.voidps.engine.timer.epochSeconds
+import world.gregs.voidps.type.Direction
+import world.gregs.voidps.type.Tile
+import java.util.UUID
+
+/** Live world-owned identities; account logout never owns/overwrites this registry. */
+object DeathLootPersistence {
+    private val graves = linkedMapOf<String, NPC>()
+    private var restoredStorage: Storage? = null
+
+    fun register(npc: NPC, player: Player) {
+        for (old in graves.values) if (old["death_account", ""] == player.accountName.lowercase()) old["death_latest"] = false
+        val id = UUID.randomUUID().toString()
+        npc["death_account"] = player.accountName.lowercase()
+        npc["death_latest"] = true
+        npc.start("grave_timer", Gravestone.times.getValue(npc.id.removePrefix("gravestone_")) * 60, epochSeconds())
+        graves[id] = npc
+    }
+
+    fun forget(npc: NPC) { graves.entries.removeIf { it.value === npc } }
+
+    fun start() {
+        if (Settings["storage.disabled", false]) return
+        val storage = get<Storage>()
+        check(storage is FileStorage) { "Death-loot persistence requires native file storage" }
+        if (restoredStorage !== storage) {
+            val state = storage.loadWorld()?.let { DeathLootSnapshot.decode(it) }
+            // Resolve every definition before spawning anything or enabling saves.
+            if (state != null) {
+                for (g in state.graves) check(g.kind in Gravestone.times && NPCDefinitions.getOrNull("gravestone_${g.kind}") != null) { "Unknown persisted grave kind" }
+                for (p in state.piles) check(ItemDefinitions.contains(p.item)) { "Unknown persisted death-loot item" }
+            }
+            graves.clear()
+            if (state != null) {
+                for (g in state.graves) {
+                    val npc = NPCs.add("gravestone_${g.kind}", Tile(g.tile), Direction.entries[g.direction])
+                    check(npc.index > 0) { "Unable to restore gravestone" }
+                    npc["death_account"] = g.account
+                    npc["death_latest"] = g.latest
+                    npc["player_name"] = g.name
+                    npc["player_male"] = g.male
+                    npc["blessed"] = g.blessed
+                    npc.start("grave_timer", g.remaining, epochSeconds())
+                    graves[g.id] = npc
+                }
+                for (p in state.piles) {
+                    val item = FloorItem(Tile(p.tile), p.item, p.amount, p.reveal, p.disappear, p.charges, p.owner.ifEmpty { null })
+                    item.deathLootId = p.id
+                    item.deathSources.addAll(p.sources)
+                    FloorItems.restoreDeathLoot(item)
+                }
+            }
+            restoredStorage = storage
+        }
+        get<SaveQueue>().worldSnapshot = ::capture
+        get<SaveQueue>().checkpointReady = { Players.none { !it.contains("bot") && it.dead } }
+    }
+
+    fun capture(): ByteArray {
+        graves.entries.removeIf { !NPCs.activeOrQueued(it.value) }
+        val savedGraves = graves.mapNotNull { (id, npc) ->
+            val remaining = npc.remaining("grave_timer", epochSeconds())
+            if (remaining <= 0) null else DeathLootSnapshot.Grave(id, npc["death_account", ""], npc["player_name", ""], npc["player_male", true], npc.id.removePrefix("gravestone_"), npc.tile.id, npc.direction.ordinal, remaining, npc["blessed", false], npc["death_latest", false])
+        }
+        val piles = FloorItems.deathLoot().map { p -> DeathLootSnapshot.Pile(requireNotNull(p.deathLootId), p.id, p.amount, p.charges, p.tile.id, p.owner ?: "", p.deathSources.sorted(), p.revealTicks, p.disappearTicks) }
+        return DeathLootSnapshot(savedGraves, piles).encode()
+    }
+
+    fun attach(player: Player) {
+        val owned = graves.values.filter { NPCs.activeOrQueued(it) && it["death_account", ""] == player.accountName.lowercase() && it.remaining("grave_timer", epochSeconds()) > 0 }
+        if (owned.isEmpty()) return
+        // Rebuild only grave markers; unrelated user/map markers retain their slots.
+        for (i in 1..5) if (player.get<String>("world_map_marker_type_$i") == "grave") {
+            player.clear("world_map_marker_$i"); player.clear("world_map_marker_type_$i"); player.clear("world_map_marker_text_$i")
+        }
+        for (npc in owned) MapMarkers.add(player, npc.tile, "grave")
+        val latest = owned.firstOrNull { it["death_latest", false] } ?: return
+        player["gravestone_npc"] = latest
+        player["gravestone_tile"] = latest.tile
+        player["gravestone_time"] = epochSeconds().toLong() + latest.remaining("grave_timer", epochSeconds())
+    }
+}
