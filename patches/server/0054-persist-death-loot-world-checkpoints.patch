+package world.gregs.voidps.engine.data.file
+
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import world.gregs.voidps.engine.data.DeathLootSnapshot
+import java.nio.file.Files
+import java.nio.file.Path
+import kotlin.test.*
+
+class DeathLootStorageTest {
+    @TempDir lateinit var directory: Path
+    private val snapshot = DeathLootSnapshot(emptyList(), listOf(DeathLootSnapshot.Pile("00000000-0000-0000-0000-000000000001", "bronze_dagger_p+", 1, 0, 100, "owner", listOf("owner"), 500, 560)))
+
+    @Test
+    fun `Native item punctuation survives the world codec`() {
+        assertEquals(snapshot, DeathLootSnapshot.decode(snapshot.encode()))
+    }
+
+    @Test
+    fun `Guarded accounts refuse a missing or corrupt world without overwriting either`() {
+        val storage = FileStorage(directory.toFile())
+        storage.saveWorld(listOf(AccountBatchRecoveryTest.snapshot("batchone", 10)), DeathLootSnapshot(emptyList(), emptyList()).encode())
+        val path = directory.resolve(DeathLootSnapshot.FILE)
+        val save = directory.resolve("batchone.toml")
+        val original = Files.readAllBytes(save)
+        val world = Files.readAllBytes(path)
+        assertEquals(1, storage.load("batchone")!!.storageVersion)
+        assertFails { storage.save(listOf(AccountBatchRecoveryTest.snapshot("batchone", 0))) }
+        Files.delete(path)
+        assertFails { storage.loadWorld() }
+        assertFails { storage.load("batchone") }
+        assertFails { storage.names() }
+        assertFails { storage.save(listOf(AccountBatchRecoveryTest.snapshot("batchone", 0))) }
+        assertContentEquals(original, Files.readAllBytes(save))
+        Files.write(path, world.copyOf().also { it[0] = '!'.code.toByte() })
+        assertFails { storage.loadWorld() }
+        assertContentEquals(original, Files.readAllBytes(save))
+    }
+}
