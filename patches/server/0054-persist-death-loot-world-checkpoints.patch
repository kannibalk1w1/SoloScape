+object NativeDeathLootProcess {
+    @JvmStatic fun main(args: Array<String>) {
+        try {
+            val world = DeathLootWorldHarness()
+            world.beforeAll()
+            world.beforeEach()
+            world.phase(args[0], args[1])
+            exitProcess(0) // No WorldTest teardown: preserve this disposable world for the next JVM.
+        } catch (t: Throwable) { t.printStackTrace(); exitProcess(1) }
+    }
