+package world.gregs.voidps.engine.data
+
+import world.gregs.config.Config
+import world.gregs.config.writePair
+import java.security.MessageDigest
+import java.util.Base64
+
+/** Versioned original world records. No NPC indexes, Player objects, or wall-clock deadlines. */
+data class DeathLootSnapshot(val graves: List<Grave>, val piles: List<Pile>) {
+    data class Grave(val id: String, val account: String, val name: String, val male: Boolean, val kind: String, val tile: Int, val direction: Int, val remaining: Int, val blessed: Boolean, val latest: Boolean)
+    data class Pile(val id: String, val item: String, val amount: Int, val charges: Int, val tile: Int, val owner: String, val sources: List<String>, val reveal: Int, val disappear: Int)
+
+    fun encode(): ByteArray {
+        val payload = Config.stringWriter {
+            writePair("graves", graves.map { g -> mapOf("id" to g.id, "account" to g.account, "name" to g.name, "male" to g.male, "kind" to g.kind, "tile" to g.tile, "direction" to g.direction, "remaining" to g.remaining, "blessed" to g.blessed, "latest" to g.latest) })
+            writePair("piles", piles.map { p -> mapOf("id" to p.id, "item" to p.item, "amount" to p.amount, "charges" to p.charges, "tile" to p.tile, "owner" to p.owner, "sources" to p.sources, "reveal" to p.reveal, "disappear" to p.disappear) })
+        }.toByteArray(Charsets.UTF_8)
+        val bytes = Config.stringWriter {
+            writePair("format", 1)
+            writePair("payload", Base64.getEncoder().encodeToString(payload))
+            writePair("sha256", digest(payload))
+        }.toByteArray(Charsets.UTF_8)
+        // Every constructed record obeys the same rules as an on-disk record.
+        decode(bytes)
+        return bytes
+    }
+
+    companion object {
+        const val FILE = ".soloscape-death-loot.v1"
+        private val UUID = Regex("[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
+        private val ACCOUNT = Regex("[a-z0-9 _-]{1,64}")
+        private val ID = Regex("[a-z0-9_]{1,128}")
+        private val ITEM = Regex("[^\\p{C}\\p{Zl}\\p{Zp}]{1,256}")
+        private val SHA = Regex("[0-9a-f]{64}")
+        private const val LIMIT = 32 * 1024 * 1024
+        private fun digest(bytes: ByteArray) = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+
+        private fun parse(bytes: ByteArray): Map<String, Any> {
+            require(bytes.size in 1..LIMIT) { "Death-loot snapshot exceeds size limit" }
+            val text = Charsets.UTF_8.newDecoder().decode(java.nio.ByteBuffer.wrap(bytes)).toString()
+            val result = linkedMapOf<String, Any>()
+            Config.stringReader(text) {
+                while (nextPair()) {
+                    val name = key()
+                    require(!result.containsKey(name)) { "Duplicate death-loot field" }
+                    result[name] = value()
+                }
+                require(!nextSection()) { "Unexpected death-loot section" }
+            }
+            return result
+        }
+        private fun Map<*, *>.exact(vararg keys: String) { require(this.keys == keys.toSet()) { "Unexpected death-loot fields" } }
+        private fun Map<*, *>.text(key: String, pattern: Regex? = null): String {
+            val v = this[key] as? String ?: error("Invalid death-loot text: $key")
+            require(if (pattern != null) pattern.matches(v) else v.length <= 64 && v.all { it >= ' ' && it != '\u007f' }) { "Invalid death-loot text: $key" }
+            return v
+        }
+        private fun Map<*, *>.number(key: String, min: Int = 0, max: Int = Int.MAX_VALUE): Int = (this[key] as? Int)?.also { require(it in min..max) { "Invalid death-loot number: $key" } } ?: error("Invalid death-loot number: $key")
+        private fun Map<*, *>.flag(key: String) = this[key] as? Boolean ?: error("Invalid death-loot flag: $key")
+        private fun Map<*, *>.rows(key: String, max: Int): List<Map<*, *>> = (this[key] as? List<*>)?.also { require(it.size <= max) }?.map { it as? Map<*, *> ?: error("Invalid death-loot record") } ?: error("Invalid death-loot list")
+
+        fun decode(bytes: ByteArray): DeathLootSnapshot {
+            val envelope = parse(bytes)
+            envelope.exact("format", "payload", "sha256")
+            require(envelope.number("format") == 1) { "Unsupported death-loot version" }
+            val payloadString = envelope["payload"] as? String ?: error("Missing death-loot payload")
+            val payload = Base64.getDecoder().decode(payloadString)
+            require(Base64.getEncoder().encodeToString(payload) == payloadString && envelope.text("sha256", SHA) == digest(payload)) { "Death-loot checksum mismatch" }
+            val root = parse(payload)
+            root.exact("graves", "piles")
+            val graves = root.rows("graves", 2048).map { g ->
+                g.exact("id", "account", "name", "male", "kind", "tile", "direction", "remaining", "blessed", "latest")
+                Grave(g.text("id", UUID), g.text("account", ACCOUNT), g.text("name"), g.flag("male"), g.text("kind", ID), g.number("tile", max = 0x3fffffff), g.number("direction", max = 8), g.number("remaining", min = 1), g.flag("blessed"), g.flag("latest"))
+            }
+            val piles = root.rows("piles", 16384).map { p ->
+                p.exact("id", "item", "amount", "charges", "tile", "owner", "sources", "reveal", "disappear")
+                val sources = (p["sources"] as? List<*>)?.map { (it as? String)?.also { a -> require(ACCOUNT.matches(a)) } ?: error("Invalid source account") } ?: error("Missing source accounts")
+                require(sources.size in 1..2048 && sources.distinct().size == sources.size)
+                val pile = Pile(p.text("id", UUID), p.text("item", ITEM), p.number("amount", min = 1), p.number("charges"), p.number("tile", max = 0x3fffffff), p.text("owner"), sources.toList(), p.number("reveal", -1), p.number("disappear", -1))
+                require(if (pile.owner.isEmpty()) pile.reveal <= 0 else pile.reveal == -1 || pile.reveal > 0) { "Inconsistent death-loot visibility" }
+                pile
+            }
+            require(graves.map { it.id }.distinct().size == graves.size && piles.map { it.id }.distinct().size == piles.size) { "Duplicate death-loot identity" }
+            require(graves.all { it.name.isNotEmpty() } && graves.map { it.id }.toSet().intersect(piles.map { it.id }.toSet()).isEmpty()) { "Invalid grave name or shared record identity" }
+            require(graves.filter { it.latest }.groupBy { it.account }.all { it.value.size == 1 }) { "Multiple latest graves" }
+            return DeathLootSnapshot(graves.toList(), piles.toList())
+        }
+    }
+}
