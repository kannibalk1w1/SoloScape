+
+/** Supplied levels, task and points; real cache tables/interface validation and native disk save. */
+@EnabledIfEnvironmentVariable(named = "SOLOSCAPE_TEST_ROOT", matches = ".+")
+class SlayerBlockedTaskTest : WorldTest() {
+    @TestFactory
+    fun `Each existing block slot excludes its task from weighted assignment`() = (0 until 5).map { slot ->
+        dynamicTest("blocked slot $slot") {
+            val player = suppliedPlayer("blocked$slot")
+            player["blocked_task_$slot"] = "banshees"
+            val fresh = saveAndLoad(player)
+            assertEquals("banshees", fresh["blocked_task_$slot", ""], "Each block slot must survive disk load")
+            setRandom(FakeRandom()) // Without the exclusion, the first eligible Mazchna row is banshees.
+            val (task, amount) = assignTask(fresh, "mazchna")
+            assertNotEquals("banshees", task)
+            assertTrue(amount > 0)
+            assertEquals(task, fresh.slayerTask)
+            assertEquals(amount, fresh.slayerTaskRemaining)
+            assertEquals("banshees", player["blocked_task_$slot", ""])
+        }
+    }
+
+    @Test
+    fun `A block belongs to its account and does not remove the task from other players`() {
+        val blocked = suppliedPlayer("blockowner")
+        val other = suppliedPlayer("blockother")
+        blocked["blocked_task_4"] = "banshees"
+        setRandom(FakeRandom())
+        assertNotEquals("banshees", assignTask(blocked, "mazchna").first)
+        setRandom(FakeRandom())
+        assertEquals("banshees", assignTask(other, "mazchna").first)
+    }
+
+    @Test
+    fun `Paying for a permanent block excludes the task after a native disk load`() {
+        val player = suppliedPlayer("blockbuyer")
+        player.slayerTask = "banshees"
+        player.slayerTaskRemaining = 11
+        player.slayerMaster = "mazchna"
+        player.slayerPoints = 150
+        player.open("slayer_rewards_assignment")
+        blockCurrentTask(player)
+        assertEquals(50, player.slayerPoints)
+        assertEquals("nothing", player.slayerTask)
+        assertEquals("banshees", player["blocked_task_0", ""])
+        val fresh = saveAndLoad(player)
+        assertEquals("banshees", fresh["blocked_task_0", ""])
+        assertEquals(50, fresh.slayerPoints)
+        setRandom(FakeRandom())
+        assertNotEquals("banshees", assignTask(fresh, "mazchna").first)
+        assertEquals(50, fresh.slayerPoints, "Rolling the next task must not charge again")
+    }
+
+    @Test
+    fun `A refused purchase leaves the task available and points unchanged`() {
+        val player = suppliedPlayer("blockpoor")
+        player.slayerTask = "banshees"
+        player.slayerTaskRemaining = 11
+        player.slayerPoints = 99
+        player.open("slayer_rewards_assignment")
+        blockCurrentTask(player)
+        assertEquals(99, player.slayerPoints)
+        assertEquals("banshees", player.slayerTask)
+        assertEquals(11, player.slayerTaskRemaining)
+        assertTrue((0 until 5).none { player.contains("blocked_task_$it") })
+        setRandom(FakeRandom())
+        assertEquals("banshees", assignTask(player, "mazchna").first)
+    }
+
+    @TestFactory
+    fun `Unblocking each native slot restores that task without changing another block`() = (0 until 5).map { slot ->
+        dynamicTest("unblock slot $slot") {
+            val player = suppliedPlayer("unblock$slot")
+            val other = (slot + 1) % 5
+            player["blocked_task_$slot"] = "banshees"
+            player["blocked_task_$other"] = "bears"
+            player.slayerPoints = 50
+            player.open("slayer_rewards_assignment")
+            val component = "cancel_${slot + 1}"
+            val option = InterfaceDefinitions.getComponent("slayer_rewards_assignment", component)!!.options!!.filterNotNull().first()
+            repeat(2) { player.interfaceOption("slayer_rewards_assignment", component, option) }
+            assertTrue(!player.contains("blocked_task_$slot"))
+            assertEquals("bears", player["blocked_task_$other", ""])
+            assertEquals(50, player.slayerPoints, "Unblocking does not refund or charge points")
+            val fresh = saveAndLoad(player)
+            assertTrue(!fresh.contains("blocked_task_$slot"))
+            assertEquals("bears", fresh["blocked_task_$other", ""])
+            setRandom(FakeRandom())
+            assertEquals("banshees", assignTask(fresh, "mazchna").first)
+        }
+    }
+
+    @Test
+    fun `Exhausted novice choices respond without drawing or changing task state`() {
+        val player = noviceWithEveryTaskBlocked()
+        val master = createNPC("turael", player.tile.addY(1))
+        player.npcOption(master, "Get-task")
+        tick(2)
+        assertNotNull(player.dialogue, "A blocked-out player needs a native explanation")
+        assertTrue(player.dialogue!!.startsWith("dialogue_npc_chat"))
+        player.skipDialogues()
+        assertNull(player.dialogue)
+        assertEquals("nothing", player.slayerTask)
+        assertEquals(0, player.slayerTasks)
+        assertEquals(0, player.slayerTaskRemaining)
+        assertEquals(50, player.slayerPoints)
+    }
+
+    @Test
+    fun `Exhausted Turael replacement preserves the old assignment and streak`() {
+        val player = noviceWithEveryTaskBlocked()
+        player.slayerMaster = "duradel"
+        player.slayerTask = "abyssal_demons"
+        player.slayerTaskRemaining = 11
+        player.slayerStreak = 9
+        player.slayerTasks = 17
+        val master = createNPC("turael", player.tile.addY(1))
+        player.npcOption(master, "Get-task")
+        tick(2)
+        player.skipDialogues()
+        player.dialogueOption("line1")
+        player.dialogueContinue() // The selected Yes is repeated as player chat before its callback.
+        assertNotNull(player.dialogue, "Failed replacement needs a native explanation")
+        assertTrue(player.dialogue!!.startsWith("dialogue_npc_chat"))
+        player.skipDialogues()
+        assertNull(player.dialogue)
+        assertEquals("duradel", player.slayerMaster)
+        assertEquals("abyssal_demons", player.slayerTask)
+        assertEquals(11, player.slayerTaskRemaining)
+        assertEquals(9, player.slayerStreak)
+        assertEquals(17, player.slayerTasks)
+        assertEquals(50, player.slayerPoints)
+    }
+
+    @Test
+    fun `Successful Turael replacement still resets the streak only after assignment`() {
+        val player = suppliedPlayer("blockconfirm")
+        player.slayerMaster = "duradel"
+        player.slayerTask = "abyssal_demons"
+        player.slayerTaskRemaining = 11
+        player.slayerStreak = 9
+        player.slayerTasks = 17
+        player.slayerPoints = 50
+        val master = createNPC("turael", player.tile.addY(1))
+        setRandom(FakeRandom())
+        player.npcOption(master, "Get-task")
+        tick(2)
+        player.skipDialogues()
+        player.dialogueOption("line1")
+        player.dialogueContinue() // Acknowledge Yes before the native assignment callback.
+        assertEquals("turael", player.slayerMaster)
+        assertEquals("banshees", player.slayerTask)
+        assertTrue(player.slayerTaskRemaining > 0)
+        assertEquals(0, player.slayerStreak)
+        assertEquals(18, player.slayerTasks)
+        assertEquals(50, player.slayerPoints)
+    }
+
+    @Test
+    fun `A missing master table stays a configuration error instead of an exhausted assignment`() {
+        val player = suppliedPlayer("blockconfig")
+        val error = assertFailsWith<IllegalStateException> { assignTask(player, "missing_master") }
+        assertTrue(error !is NoSlayerTaskAvailable)
+        assertEquals("nothing", player.slayerTask)
+        assertEquals(0, player.slayerTasks)
+    }
+
+    private fun noviceWithEveryTaskBlocked(): Player {
+        val player = createPlayer(Tile(3200, 3200), "blocknovice")
+        for ((slot, category) in listOf("birds", "goblin", "monkeys", "rats", "spiders").withIndex()) {
+            player["blocked_task_$slot"] = category
+        }
+        player.slayerPoints = 50 // Supplied boundary fixture, not earned points at level three.
+        setRandom(FakeRandom())
+        return player
+    }
+
+    private fun saveAndLoad(player: Player): Player {
+        val dir = Files.createTempDirectory(Path.of(System.getenv("SOLOSCAPE_TEST_ROOT")), "slayer-block-")
+        try {
+            val storage = FileStorage(dir.toFile())
+            var primarySaved = false
+            runBlocking { SaveQueue(storage, storage).direct { primarySaved = it }.join() }
+            assertTrue(primarySaved, "The real primary save must succeed")
+            val saved = PlayerSave.load(dir.resolve("${player.accountName.lowercase()}.toml").toFile())
+            val expectedCombat = player.combatLevel
+            val expectedXp = player.experience.experience.copyOf()
+            Despawn.player(player)
+            Players.remove(player)
+            tick()
+            val fresh = saved.toPlayer()
+            val accounts = get<AccountManager>()
+            accounts.setup(fresh, null, 0, viewport = true)
+            assertTrue(accounts.index(fresh))
+            accounts.spawn(fresh, null)
+            tick(3)
+            assertEquals(expectedCombat, fresh.combatLevel, "Disk reload must restore the same task eligibility")
+            assertArrayEquals(expectedXp, fresh.experience.experience)
+            return fresh
+        } finally {
+            dir.toFile().deleteRecursively()
+        }
+    }
+
+    private fun blockCurrentTask(player: Player) {
+        val definition = InterfaceDefinitions.getComponent("slayer_rewards_assignment", "block_text")!!
+        val option = definition.options!!.filterNotNull().first { it.startsWith("Permanently") }
+        player.interfaceOption("slayer_rewards_assignment", "block_text", option)
+    }
+
+    private fun suppliedPlayer(name: String): Player {
+        val player = createPlayer(Tile(3200, 3200), name)
+        for (skill in Skill.entries) {
+            val level = skill.maximum()
+            player.levels.set(skill, level)
+            player.experience.set(skill, Level.experience(skill, level))
+        }
+        return player
+    }
+}
