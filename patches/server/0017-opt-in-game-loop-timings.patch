+package world.gregs.voidps.engine
+
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import java.nio.file.Files
+import java.nio.file.Path
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+
+internal class GameLoopTimingsTest {
+    @TempDir lateinit var directory: Path
+    @Test fun `bounded samples retain whole-run count total and maximum`() {
+        val stage = Runnable {}
+        val output = directory.resolve("timings.csv")
+        val timings = GameLoopTimings(output, listOf(stage), 2)
+        for (nanos in listOf(1_000_000L, 3_000_000L, 8_000_000L)) {
+            timings.tick(nanos)
+            timings.stage(stage, nanos)
+        }
+        timings.write()
+        val lines = Files.readAllLines(output)
+        assertEquals("tick,3,4.0,1.0,8.0,true", lines[1])
+        assertTrue(lines[2].endsWith(",3,4.0,1.0,8.0,true"))
+    }
+    @Test fun `empty run does not fabricate timing measurements`() {
+        val output = directory.resolve("empty.csv")
+        GameLoopTimings(output, emptyList()).write()
+        assertEquals("tick,0,0.0,0.0,0.0,false", Files.readAllLines(output)[1])
+    }
+}
