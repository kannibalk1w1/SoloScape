+package world.gregs.voidps.engine
+
+import java.nio.file.Files
+import java.nio.file.Path
+import java.util.IdentityHashMap
+
+/** Opt-in bounded observations; no allocations or file output in ordinary sessions. */
+internal class GameLoopTimings(private val output: Path, stages: List<Runnable>, capacity: Int = 8192) {
+    private class Samples(capacity: Int) {
+        val values = LongArray(capacity)
+        var count = 0L
+        var total = 0L
+        var maximum = 0L
+        fun add(nanos: Long) {
+            if (count < values.size) values[count.toInt()] = nanos
+            count++
+            total += nanos
+            maximum = maxOf(maximum, nanos)
+        }
+        fun row(name: String): String {
+            val sorted = values.copyOf(minOf(count, values.size.toLong()).toInt()).sortedArray()
+            val p99 = if (sorted.isEmpty()) 0L else sorted[(sorted.size - 1) * 99 / 100]
+            return "$name,$count,${if (count == 0L) 0.0 else total / 1e6 / count},${p99 / 1e6},${maximum / 1e6},${count > values.size}"
+        }
+    }
+    private val ticks = Samples(capacity)
+    private val stages = IdentityHashMap<Runnable, Samples>().apply {
+        for (stage in stages) put(stage, Samples(capacity))
+    }
+    fun tick(nanos: Long) = ticks.add(nanos)
+    fun stage(stage: Runnable, nanos: Long) { stages[stage]?.add(nanos) }
+    fun write() {
+        val rows = mutableListOf("phase,samples,mean_ms,p99_ms,max_ms,truncated", ticks.row("tick"))
+        for ((stage, samples) in stages) rows.add(samples.row(stage.javaClass.simpleName.replace(',', '_')))
+        Files.write(output, rows)
+    }
+    companion object {
+        fun create(stages: List<Runnable>): GameLoopTimings? = System.getProperty("soloscape.performance.timings.file")
+            ?.let { GameLoopTimings(Path.of(it), stages) }
+    }
+}
