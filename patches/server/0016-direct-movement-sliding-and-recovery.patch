+        // Resolve collision before queuing both steps. Otherwise a diagonal slide
+        // on step one makes the absolute second destination turn back into the wall.
+        val dx: Int
+        val dy: Int
+        when {
+            canDirectStep(input.dx, input.dy) -> { dx = input.dx; dy = input.dy }
+            input.dx != 0 && input.dy != 0 && canDirectStep(input.dx, 0) -> { dx = input.dx; dy = 0 }
+            input.dx != 0 && input.dy != 0 && canDirectStep(0, input.dy) -> { dx = 0; dy = input.dy }
+            else -> { super.tick(); return }
