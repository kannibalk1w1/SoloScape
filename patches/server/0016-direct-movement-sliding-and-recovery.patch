+package world.gregs.voidps.engine.entity.character.mode.move
+
+import java.nio.file.Files
+import java.nio.file.Path
+import world.gregs.voidps.type.Tile
+
+/** Optional developer-authored exclusions for controller direct movement only. */
+internal object ControllerAvoidTiles {
+    private val tiles: Set<Tile> by lazy {
+        val path = Path.of(System.getenv("SOLOSCAPE_CONTROLLER_AVOID_TILES") ?: "data/controller-avoid-tiles.txt")
+        if (!Files.exists(path)) emptySet() else runCatching {
+            require(Files.size(path) <= 262144) { "Avoidance file is too large" }
+            val lines = Files.readAllLines(path).filter { it.isNotBlank() && !it.startsWith("#") }
+            require(lines.size <= 4096) { "Too many avoidance tiles" }
+            lines.map { line ->
+                val values = line.split(',').map { it.trim().toInt() }
+                require(values.size == 3 && values[0] in 0..16383 && values[1] in 0..16383 && values[2] in 0..3) { "Invalid avoidance tile" }
+                Tile(values[0], values[1], values[2])
+            }.toSet()
+        }.getOrElse {
+            System.err.println("Controller tile avoidance could not load; native collision remains active.")
+            emptySet()
+        }
+    }
+    fun contains(tile: Tile): Boolean = tile in tiles
+}
