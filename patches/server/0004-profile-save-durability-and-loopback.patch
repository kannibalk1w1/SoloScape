+package world.gregs.config
+
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import org.junit.jupiter.api.assertThrows
+import java.nio.file.Path
+
+class AtomicFileWriterTest {
+    @TempDir lateinit var directory: Path
+
+    @Test
+    fun `failed serialization preserves existing bytes and cleans temporary files`() {
+        val save = directory.resolve("tester.toml").toFile()
+        save.writeText("previous valid save")
+        assertThrows<IllegalStateException> {
+            Config.atomicFileWriter(save) {
+                write("partially serialized save")
+                error("simulated serialization failure")
+            }
+        }
+        assertEquals("previous valid save", save.readText())
+        assertEquals(listOf("tester.toml"), directory.toFile().list()!!.toList())
+    }
+
+    @Test
+    fun `successful replacement is complete and creates missing parents`() {
+        val save = directory.resolve("nested/saves/tester.toml").toFile()
+        Config.atomicFileWriter(save) { writePair("name", "éclair") }
+        assertEquals("name = \"éclair\"\n", save.readText())
+        Config.atomicFileWriter(save) { writePair("name", "second") }
+        assertEquals("name = \"second\"\n", save.readText())
+        assertEquals(listOf("tester.toml"), save.parentFile.list()!!.toList())
+    }
+}
