+package content.entity.player
+
+import WorldTest
+import content.skill.prayer.PrayerConfigs
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.condition.EnabledIfEnvironmentVariable
+import world.gregs.voidps.engine.data.PlayerSave
+import world.gregs.voidps.engine.data.SaveQueue
+import world.gregs.voidps.engine.data.Settings
+import world.gregs.voidps.engine.data.Storage
+import world.gregs.voidps.engine.data.file.FileStorage
+import world.gregs.voidps.engine.entity.character.player.Player
+import world.gregs.voidps.type.Tile
+import java.io.File
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+/**
+ * Reproduces whether a [SaveQueue] snapshot of a player's persisted variables keeps the values captured
+ * at [SaveQueue.save] time, using the real [FileStorage] codec and [PlayerSave.load].
+ *
+ * Persisted `bitwise` variables are live mutable lists in [Player.variables]; `Player.copy` used to share
+ * those list instances with the snapshot. These tests mutate the live list after capture and assert the literal
+ * capture-time values on disk. Fixtures are explicit native varbit additions, not earned progression.
+ *
+ * Every save file is written under a fresh subdirectory of `SOLOSCAPE_TEST_ROOT`. Primary and fallback
+ * storage are both configured explicitly; no default production storage is used.
+ */
+@EnabledIfEnvironmentVariable(named = "SOLOSCAPE_TEST_ROOT", matches = ".+")
+class SaveVariableSnapshotTest : WorldTest() {
+
+    private val root: File by lazy {
+        File(System.getenv("SOLOSCAPE_TEST_ROOT")).absoluteFile.resolve("save-variable-snapshot")
+    }
+
+    private val timeoutSeconds = 10L
+
+    private fun caseDir(name: String): File = root.resolve(name).apply {
+        deleteRecursively()
+        resolve("primary").mkdirs()
+        resolve("fallback").mkdirs()
+    }
+
+    /** A real file storage that runs [beforeWrite] first, on the writer thread, and then delegates to the real codec. */
+    private fun hooked(dir: File, beforeWrite: () -> Unit): Storage {
+        val file = FileStorage(dir)
+        return object : Storage by file {
+            override fun save(accounts: List<PlayerSave>) {
+                beforeWrite()
+                file.save(accounts)
+            }
+        }
+    }
+
+    private fun savedFile(dir: File, player: Player): File = dir.resolve("primary").resolve("${player.accountName.lowercase()}.toml")
+
+    /**
+     * Captures [player] through the real [SaveQueue.save] and [SaveQueue.run] path, waits for the writer,
+     * then loads the file it wrote. Fails if the primary write did not confirm.
+     */
+    private fun saveAndLoad(player: Player, dir: File, primary: Storage): PlayerSave {
+        Settings.load(mapOf("storage.disabled" to "false"))
+        val queue = SaveQueue(primary, FileStorage(dir.resolve("fallback")))
+        queue.save(player)
+        queue.run()
+        runBlocking { withTimeout(TimeUnit.SECONDS.toMillis(timeoutSeconds)) { queue.awaitInFlight() } }
+        assertTrue(queue.empty(), "primary save did not confirm for ${player.accountName}")
+        return PlayerSave.load(savedFile(dir, player))
+    }
+
+    @Test
+    fun `Penguins found saved after capture keeps the capture-time list when a penguin is added later`() {
+        val dir = caseDir("penguins-add-after-capture")
+        val player = createPlayer(Tile(2599, 3267), "snapshotpenguin")
+        assertTrue(player.addVarbit("penguins_found", "penguin_0"))
+
+        val saved = saveAndLoad(player, dir, hooked(dir.resolve("primary")) {
+            // Live mutation after capture, before the writer serializes the snapshot. Asserted after the save,
+            // because an assertion error on the writer thread is not caught by SaveQueue.
+            player.addVarbit("penguins_found", "penguin_1")
+        })
+
+        assertEquals(listOf("penguin_0", "penguin_1"), player.variables.get<List<Any>>("penguins_found"), "live list keeps the later add")
+        assertEquals(listOf("penguin_0"), saved.variables["penguins_found"], "saved penguins_found must be the capture-time list")
+    }
+
+    @Test
+    fun `Quick prayers saved after capture keep a prayer that is removed later`() {
+        val dir = caseDir("quick-prayers-remove-after-capture")
+        val player = createPlayer(Tile(2599, 3267), "snapshotprayer")
+        assertTrue(player.addVarbit(PrayerConfigs.QUICK_PRAYERS, "thick_skin"))
+        assertTrue(player.addVarbit(PrayerConfigs.QUICK_PRAYERS, "rock_skin"))
+
+        val saved = saveAndLoad(player, dir, hooked(dir.resolve("primary")) {
+            // Live removal after capture, before the writer serializes the snapshot.
+            player.removeVarbit(PrayerConfigs.QUICK_PRAYERS, "thick_skin")
+        })
+
+        assertEquals(listOf("rock_skin"), player.variables.get<List<Any>>(PrayerConfigs.QUICK_PRAYERS), "live list lost the removed prayer")
+        assertEquals(listOf("thick_skin", "rock_skin"), saved.variables[PrayerConfigs.QUICK_PRAYERS], "saved quick_prayers must keep the removed prayer")
+    }
+
+    @Test
+    fun `Positive control - a persisted scalar changed after capture is saved at its capture-time value`() {
+        val dir = caseDir("scalar-after-capture")
+        val player = createPlayer(Tile(2599, 3267), "snapshotscalar")
+        player["penguin_week"] = 3
+
+        val saved = saveAndLoad(player, dir, hooked(dir.resolve("primary")) {
+            player["penguin_week"] = 4
+        })
+
+        assertEquals(4, player["penguin_week", 0], "live scalar changed")
+        assertEquals(3, saved.variables["penguin_week"], "saved scalar must be the capture-time value")
+    }
+
+    @Test
+    fun `Positive control - non-persisted variables are not written to the save`() {
+        val dir = caseDir("temp-exclusion")
+        val player = createPlayer(Tile(2599, 3267), "snapshottemp")
+        // unlocked_gravestones has no persist flag, and undefined keys are not persisted either.
+        assertTrue(player.addVarbit("unlocked_gravestones", "flag"))
+        player["snapshot_temp_probe"] = "live-only"
+
+        val saved = saveAndLoad(player, dir, hooked(dir.resolve("primary")) {})
+
+        assertTrue(player.containsVarbit("unlocked_gravestones", "flag"), "live temp varbit is set")
+        assertEquals("live-only", player["snapshot_temp_probe", ""], "live temp variable is set")
+        assertFalse(saved.variables.containsKey("unlocked_gravestones"), "non-persisted varbit must not be saved")
+        assertFalse(saved.variables.containsKey("snapshot_temp_probe"), "undefined temp variable must not be saved")
+    }
+
+    @Test
+    fun `Asynchronous ordering - a writer paused after capture saves the capture-time penguins list`() {
+        val dir = caseDir("async-penguins-barrier")
+        val player = createPlayer(Tile(2599, 3267), "snapshotasync")
+        assertTrue(player.addVarbit("penguins_found", "penguin_0"))
+
+        Settings.load(mapOf("storage.disabled" to "false"))
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val file = FileStorage(dir.resolve("primary"))
+        val primary = object : Storage by file {
+            override fun save(accounts: List<PlayerSave>) {
+                entered.countDown()
+                check(release.await(timeoutSeconds, TimeUnit.SECONDS)) { "writer barrier was never released" }
+                file.save(accounts)
+            }
+        }
+        val queue = SaveQueue(primary, FileStorage(dir.resolve("fallback")))
+        try {
+            queue.save(player)
+            queue.run()
+            assertTrue(entered.await(timeoutSeconds, TimeUnit.SECONDS), "writer did not reach the barrier")
+            // The writer is paused on the real IO thread; mutate the live list on the test thread.
+            assertTrue(player.addVarbit("penguins_found", "penguin_1"))
+        } finally {
+            release.countDown()
+            runBlocking { withTimeout(TimeUnit.SECONDS.toMillis(timeoutSeconds)) { queue.awaitInFlight() } }
+        }
+        assertTrue(queue.empty(), "primary save did not confirm")
+
+        val saved = PlayerSave.load(savedFile(dir, player))
+        assertEquals(listOf("penguin_0", "penguin_1"), player.variables.get<List<Any>>("penguins_found"), "live list keeps the later add")
+        assertEquals(listOf("penguin_0"), saved.variables["penguins_found"], "saved penguins_found must be the capture-time list")
+    }
+}
