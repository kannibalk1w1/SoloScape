+    private fun fightNativeChicken(player: Player): NPC {
+        var target: NPC? = null
+        repeat(500) { attempt ->
+            target?.let { if (it.levels.get(Skill.Constitution) <= 0) return it }
+            if (attempt == 0 || (attempt % 10 == 0 && player.mode == EmptyMode)) {
+                // Native spawns roam. Pick an accessible bird rather than an occupied destination tile
+                // or a bird behind a fence; re-click if an ordinary approach is interrupted.
+                val chicken = NPCs.filter { it.id == "chicken" && it.tile.within(player.tile,12) &&
+                    get<LineValidator>().hasLineOfWalk(player,it.tile,it.size,it.size) }
+                    .minByOrNull { it.tile.distanceTo(player.tile) }
+                if (chicken != null) {
+                    target = chicken
+                    player.npcOption(chicken,"Attack")
+                }
+            }
+            tick()
+        }
+        error("No accessible native chicken defeated: tile=${player.tile} mode=${player.mode} target=$target")
+    }
+
+    private fun verifyFreshPlayerRestore(player: Player) {
+        val dir = Files.createTempDirectory("soloscape-earned-lumbridge-")
+        try {
+            runBlocking { SaveQueue(FileStorage(dir.toFile())).direct().join() }
+            val save = PlayerSave.load(dir.resolve("${player.accountName.lowercase()}.toml").toFile())
+            assertEquals(player.tile,save.tile)
+            assertArrayEquals(player.experience.experience,save.experience)
+            for ((id,inv) in player.inventories.instances) assertArrayEquals(inv.items,save.inventories[id])
+            Despawn.player(player)
+            Players.remove(player)
+            tick()
+            // toPlayer may share backing arrays with PlayerSave; freeze independent expectations before login.
+            val expectedXp = save.experience.copyOf()
+            val expectedInventories = save.inventories.mapValues { (_, items) -> items.copyOf() }
+            val fresh = save.toPlayer()
+            assertTrue(fresh !== player)
+            val accounts = get<AccountManager>()
+            accounts.setup(fresh,null,0,viewport=true)
+            assertTrue(accounts.index(fresh))
+            accounts.spawn(fresh,null)
+            tick(3)
+            assertEquals(save.tile,fresh.tile)
+            assertEquals("completed",fresh.quest("cooks_assistant"))
+            assertArrayEquals(expectedXp,fresh.experience.experience)
+            for ((id,items) in expectedInventories) assertArrayEquals(items,fresh.inventories.inventory(id).items)
+            assertTrue(fresh.contains("creation"), "Native welcome uses the persisted creation marker to avoid re-introducing an existing player")
+        } finally { dir.toFile().deleteRecursively() }
+    }
