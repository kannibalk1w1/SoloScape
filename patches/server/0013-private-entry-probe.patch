+                is world.gregs.voidps.engine.suspend.Suspension.StringEntry -> "string"
+                null -> "none"
+                else -> "other"
+            }
+            message("SOLOSCAPE-PROBE|$nonce|$pending", ChatType.Game)
+        }
+
