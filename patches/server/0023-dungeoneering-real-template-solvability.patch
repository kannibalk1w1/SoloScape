@@ -0,0 +1,37 @@
+package content.skill.dungeoneering
+
+import WorldTest
+import org.junit.jupiter.api.DynamicTest.dynamicTest
+import org.junit.jupiter.api.TestFactory
+import org.junit.jupiter.api.Assertions.assertNotNull
+import org.junit.jupiter.api.Assertions.assertTrue
+import world.gregs.voidps.type.setRandom
+import kotlin.random.Random
+
+/** Real configured templates; graph/key solvability, not a client or combat playthrough. */
+class DungeonGenerationWorldTest : WorldTest() {
+    @TestFactory
+    fun `supported solo floors generate populated reachable boss layouts`() =
+        listOf(1, 6, 11).flatMap { floor ->
+            listOf(0L, 1L, 42L).map { seed ->
+                dynamicTest("Small c1 floor $floor seed $seed") {
+                    setRandom(Random(seed))
+                    val dungeon = DungeonGenerator(DungeonSize.Small, floor, complexity = 1, playerCount = 1).generate()
+                    assertNotNull(dungeon, "Generation must succeed; null is not a passing solvability test")
+                    dungeon!!
+                    val rooms = dungeon.grid.filterNotNull()
+                    assertTrue(rooms.all { it.zone != null && !it.name.isNullOrEmpty() }, "Every generated room needs a real map template")
+                    val boss = rooms.single { it.type == DungeonRoomType.Boss }
+                    val keys = mutableSetOf<String>()
+                    val reached = mutableSetOf<DungeonRoom>()
+                    do {
+                        val previous = reached.size
+                        val reachable = dungeon.traverse { _, door, _ -> door !is DungeonDoor.Locked || door.key in keys }
+                        reached.addAll(reachable)
+                        reachable.forEach { keys.addAll(it.keys) }
+                    } while (reached.size > previous)
+                    assertTrue(boss in reached, "Boss must be reachable by collecting keys from accessible rooms")
+                }
+            }
+        }
+}
