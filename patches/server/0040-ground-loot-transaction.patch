+
+    @Test
+    fun `Take refuses a coin stack overflow without destroying floor loot`() {
+        val player = createPlayer(emptyTile)
+        player.inventory.add("coins", Int.MAX_VALUE - 1)
+        val item = FloorItems.add(player.tile, "coins", 2, owner = player)
+        tick()
+
+        player.floorItemOption(item, "Take")
+        tick(2)
+
+        assertEquals(Int.MAX_VALUE - 1, player.inventory.count("coins"))
+        assertTrue(FloorItems.at(item.tile).any { it === item }, "Rejected coins remain on the floor")
+        assertEquals(2, item.amount)
+
+        // Supplied-capacity fixture: make room in the stack, then use native Take again.
+        player.inventory.remove("coins", 1)
+        player.floorItemOption(item, "Take")
+        tick(2)
+        assertEquals(Int.MAX_VALUE, player.inventory.count("coins"))
+        assertTrue(FloorItems.at(item.tile).none { it === item })
+        assertTrue(!runBlocking { ItemTake.take(player, item) }, "A stale retry must fail")
+        assertEquals(Int.MAX_VALUE, player.inventory.count("coins"))
+    }
+
+    @Test
+    fun `Take refuses a nonstackable pile that exceeds free slots without partial loss`() {
+        val player = createPlayer(emptyTile)
+        player.inventory.add("raw_shrimps", 27)
+        val item = FloorItems.add(player.tile, "bronze_sword", 2, owner = player)
+        tick()
+        assertEquals(1, player.inventory.spaces)
+
+        player.floorItemOption(item, "Take")
+        tick(2)
+
+        assertEquals(0, player.inventory.count("bronze_sword"))
+        assertEquals(27, player.inventory.count("raw_shrimps"))
+        assertTrue(FloorItems.at(item.tile).any { it === item }, "Rejected swords remain on the floor")
+        assertEquals(2, item.amount)
+
+        player.inventory.remove("raw_shrimps", 1)
+        player.floorItemOption(item, "Take")
+        tick(2)
+        assertEquals(2, player.inventory.count("bronze_sword"))
+        assertEquals(26, player.inventory.count("raw_shrimps"))
+        assertTrue(FloorItems.at(item.tile).none { it === item })
+    }
+
+    @Test
+    fun `A stale floor reference rolls back a tentative inventory addition`() {
+        val player = createPlayer(emptyTile)
+        val item = FloorItems.add(player.tile, "coins", 2, owner = player)
+        tick()
+        assertTrue(FloorItems.remove(item))
+        tick()
+
+        assertTrue(!runBlocking { ItemTake.take(player, item) })
+        assertEquals(0, player.inventory.count("coins"))
+        assertTrue(FloorItems.at(item.tile).isEmpty())
+    }
 }
