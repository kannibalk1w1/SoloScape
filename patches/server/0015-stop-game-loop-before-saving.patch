+++ b/engine/src/test/kotlin/world/gregs/voidps/engine/GameLoopShutdownTest.kt
@@ -0,0 +1,56 @@
+package world.gregs.voidps.engine
+
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.asCoroutineDispatcher
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.runBlocking
+import kotlinx.coroutines.withTimeout
+import org.junit.jupiter.api.Test
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Executors
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlin.test.assertFalse
+import kotlin.test.assertTrue
+
+internal class GameLoopShutdownTest {
+    @Test
+    fun `shutdown waits for the in-flight tick before saving`() {
+        val entered = CountDownLatch(1)
+        val release = CountDownLatch(1)
+        val tickFinished = AtomicBoolean(false)
+        val saved = AtomicBoolean(false)
+        val dispatcher = Executors.newSingleThreadExecutor().asCoroutineDispatcher()
+        val shutdownThread = Executors.newSingleThreadExecutor()
+        val engine = GameLoop(listOf(Runnable {
+            entered.countDown()
+            check(release.await(10, TimeUnit.SECONDS))
+            tickFinished.set(true)
+        })).start(CoroutineScope(dispatcher))
+        try {
+            assertTrue(entered.await(5, TimeUnit.SECONDS))
+            val shutdown = shutdownThread.submit {
+                GameLoop.shutdown(engine) {
+                    assertTrue(tickFinished.get(), "Saving must not race the active tick")
+                    assertTrue(engine.isCompleted)
+                    saved.set(true)
+                }
+            }
+            runBlocking {
+                withTimeout(5000) {
+                    while (!engine.isCancelled) delay(1)
+                }
+            }
+            assertFalse(saved.get())
+            assertFalse(shutdown.isDone)
+            release.countDown()
+            shutdown.get(5, TimeUnit.SECONDS)
+            assertTrue(saved.get())
+        } finally {
+            release.countDown()
+            engine.cancel()
+            dispatcher.close()
+            shutdownThread.shutdownNow()
+        }
+    }
+}
