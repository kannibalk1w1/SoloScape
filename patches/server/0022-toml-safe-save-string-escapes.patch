@@ -0,0 +1,88 @@
+package world.gregs.voidps.engine.data
+
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.assertThrows
+import org.junit.jupiter.api.io.TempDir
+import world.gregs.voidps.engine.data.exchange.ExchangeOffer
+import world.gregs.voidps.engine.data.file.FileStorage
+import world.gregs.voidps.engine.entity.character.player.chat.clan.ClanRank
+import java.io.File
+import kotlin.test.assertContentEquals
+import kotlin.test.assertEquals
+
+/**
+ * Player-entered text (clan names, friends, events) must survive Save & Quit, Continue and backup copies byte-for-byte.
+ */
+internal class PlayerSaveEscapeTest {
+
+    @field:TempDir
+    lateinit var directory: File
+
+    private val save = StorageTest.save.copy(
+        variables = StorageTest.save.variables + mapOf(
+            "clan_name" to "Ye \"Olde\" C:\\Clan\\",
+            "display_name" to "Zezima",
+            "quest:last_note" to "ends with a backslash \\",
+            "multi_line" to "line one\nline two\r\n\ttabbed — café 🙂",
+            "name_history" to listOf("quote\"", "back\\slash", ""),
+        ),
+        friends = mapOf("Greg" to ClanRank.Friend, "Mod \"Mark\"" to ClanRank.Corporeal, "back\\slash" to ClanRank.Recruit),
+        ignores = listOf("Mod Murdoch", "say \"hi\"", "\\"),
+        // Loading always restores six exchange slots.
+        offers = Array(6) { StorageTest.save.offers.getOrElse(it) { ExchangeOffer.EMPTY } },
+        recentEvents = listOf(
+            RecentEvent(42, "Druidic Ritual", "The druids' \"Guthix\" blessing — quest complete! \\o/ ".repeat(8)),
+            RecentEvent(43, "Blood Pact \\", ""),
+        ),
+    )
+
+    @Test
+    fun `Awkward strings survive save and reload`() {
+        val storage = FileStorage(directory)
+        storage.save(listOf(save))
+        assertSameAccount(storage.load(save.name)!!)
+    }
+
+    @Test
+    fun `Repeated save and reload cycles keep every string`() {
+        val storage = FileStorage(directory)
+        storage.save(listOf(save))
+        // Variable order may change between saves, so compare decoded content rather than bytes.
+        repeat(3) {
+            storage.save(listOf(storage.load(save.name)!!))
+        }
+        assertSameAccount(storage.load(save.name)!!)
+    }
+
+    @Test
+    fun `Backup copies reload to the same account`() {
+        val storage = FileStorage(directory)
+        storage.save(listOf(save))
+        val backup = directory.resolve("backup").apply { mkdirs() }
+        directory.resolve("${save.name}.toml").copyTo(backup.resolve("${save.name}.toml"))
+        assertSameAccount(FileStorage(backup).load(save.name)!!)
+    }
+
+    private fun assertSameAccount(loaded: PlayerSave) {
+        assertEquals(save.variables, loaded.variables)
+        assertEquals(save.friends, loaded.friends)
+        assertEquals(save.ignores, loaded.ignores)
+        assertEquals(save.recentEvents, loaded.recentEvents)
+        assertEquals(save.inventories.keys, loaded.inventories.keys)
+        for ((key, items) in save.inventories) {
+            assertContentEquals(items, loaded.inventories.getValue(key), key)
+        }
+        // Remaining fields compare by content once arrays are excluded.
+        assertEquals(save.copy(inventories = emptyMap()), loaded.copy(inventories = emptyMap()))
+    }
+
+    @Test
+    fun `Truncated save fails loudly instead of loading partial progress`() {
+        val storage = FileStorage(directory)
+        storage.save(listOf(save))
+        val file = directory.resolve("${save.name}.toml")
+        val text = file.readText()
+        file.writeText(text.substring(0, text.indexOf("Guthix") + 3))
+        assertThrows<IllegalArgumentException> { storage.load(save.name) }
+    }
+}
