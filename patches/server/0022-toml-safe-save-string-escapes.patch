--- /dev/null
+++ b/config/src/test/kotlin/world/gregs/config/ConfigStringEscapeTest.kt
@@ -0,0 +1,121 @@
+package world.gregs.config
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.DynamicTest.dynamicTest
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.TestFactory
+import org.junit.jupiter.api.assertThrows
+
+class ConfigStringEscapeTest {
+
+    private val awkward = listOf(
+        "",
+        "\"",
+        "\\",
+        "ends with backslash \\",
+        "backslash before quote \\\"",
+        "two backslashes \\\\ in the middle",
+        "C:\\Users\\deck\\saves",
+        "say \"hello\" to \"Kaqemeex\"",
+        "single 'quoted' clan",
+        "line one\nline two\r\nline three\ttabbed",
+        "bell \u0007 escape \u001B delete \u007F form \u000C back \b",
+        "Guthix — blessing ✓ café 🙂",
+        "\\u0041 is not an escape here",
+        "x".repeat(99) + "\\\"" + "y".repeat(120),
+    )
+
+    @TestFactory
+    fun `Writer output reads back unchanged`() = awkward.mapIndexed { index, expected ->
+        dynamicTest("value $index") {
+            val text = Config.stringWriter { writePair("desc", expected) }
+            Config.stringReader(text) {
+                assertEquals("desc", key())
+                assertEquals(expected, string())
+            }
+        }
+    }
+
+    @Test
+    fun `Escaped strings survive inside lists and maps followed by more fields`() {
+        val events = listOf(mapOf("title" to "Quest \"complete\"", "desc" to "ends \\", "time" to 7), mapOf("title" to "next", "desc" to "ok", "time" to 8))
+        val text = Config.stringWriter {
+            writePair("recent_events", events)
+            writePair("after", 42)
+        }
+        Config.stringReader(text) {
+            assertEquals(mapOf("recent_events" to events, "after" to 42), sections().getValue(""))
+        }
+    }
+
+    @Test
+    fun `Keys that are not bare-safe are quoted and read back as one key`() {
+        val map = linkedMapOf("Zezima \"the\" great" to 1, "back\\slash" to 2, "dotted.name" to 3, "" to 4, "plain_key-1" to 5)
+        val text = Config.stringWriter { writePair("friends", map) }
+        assertEquals("friends = {\"Zezima \\\"the\\\" great\" = 1, \"back\\\\slash\" = 2, \"dotted.name\" = 3, \"\" = 4, plain_key-1 = 5}\n", text)
+        Config.stringReader(text) {
+            assertEquals(mapOf("friends" to map), sections().getValue(""))
+        }
+    }
+
+    @Test
+    fun `Plain strings and keys are written exactly as before`() {
+        assertEquals("display_name = \"Durial321\"\n", Config.stringWriter { writePair("display_name", "Durial321") })
+        assertEquals("clan = \"falador fun\"\n", Config.stringWriter { writePair("clan", "falador fun") })
+    }
+
+    @Test
+    fun `Writer emits TOML basic string escapes`() {
+        // The same bytes are decoded by scripts/test_profiles.py with Python's strict tomllib.
+        assertEquals(
+            "desc = \"q\\\" b\\\\ n\\n t\\t r\\r e\\u001B d\\u007F é\"\n",
+            Config.stringWriter { writePair("desc", "q\" b\\ n\n t\t r\r e\u001B d\u007F é") },
+        )
+    }
+
+    @Test
+    fun `TOML escapes written by other tools decode`() {
+        Config.stringReader("desc = \"tab\\tquote\\\" \\u00e9 \\U0001F642 \\b\\f\"") {
+            key()
+            assertEquals("tab\tquote\" é 🙂 \b\u000C", string())
+        }
+    }
+
+    @Test
+    fun `Legacy raw backslashes keep reading as before`() {
+        Config.stringReader("a = \"C:\\path\\dir\"\nb = \"\\users\\uZZ\\u12\"\nc = \"say \\\"hi\\\"\"\nd = 5") {
+            assertEquals("a", key())
+            assertEquals("C:\\path\\dir", string())
+            assertEquals("b", key())
+            assertEquals("\\users\\uZZ\\u12", string())
+            assertEquals("c", key())
+            assertEquals("say \"hi\"", string())
+            assertEquals("d", key())
+            assertEquals(5, int())
+        }
+    }
+
+    @Test
+    fun `Surrogate and out of range unicode escapes stay literal`() {
+        Config.stringReader("a = \"\\uD800 \\U00110000\"") {
+            key()
+            assertEquals("\\uD800 \\U00110000", string())
+        }
+    }
+
+    @Test
+    fun `Unterminated strings are rejected rather than swallowing the rest of a save`() {
+        assertThrows<IllegalArgumentException> {
+            Config.stringReader("desc = \"legacy trailing backslash \\\"\nnext = 1") {
+                key()
+                string()
+            }
+        }
+        assertThrows<IllegalArgumentException> {
+            Config.stringReader("desc = \"ends at backslash\\") {
+                key()
+                string()
+            }
+        }
+    }
+}
