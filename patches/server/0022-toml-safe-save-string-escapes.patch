+ * Writes a TOML basic string that both [ConfigReader] and strict TOML parsers decode to [value].
+ * Plain strings are written unchanged; quotes, backslashes and control characters are escaped.
+ */
+fun ConfigWriter.writeString(value: String) {
+    write("\"")
+    if (value.none { it == '"' || it == '\\' || it < ' ' || it == '\u007F' }) {
+        write(value)
+    } else {
+        for (char in value) {
+            when (char) {
