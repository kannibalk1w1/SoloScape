+package content.area.misthalin.lumbridge.church
+
+import WorldTest
+import interfaceOption
+import org.junit.jupiter.api.Test
+import world.gregs.voidps.engine.client.ui.open
+import world.gregs.voidps.engine.data.definition.EnumDefinitions
+import world.gregs.voidps.engine.entity.character.player.Player
+import world.gregs.voidps.engine.inv.add
+import world.gregs.voidps.engine.inv.inventory
+import world.gregs.voidps.type.Tile
+import kotlin.test.assertEquals
+import kotlin.test.assertFalse
+
+/**
+ * Server authority for gravestone purchases in the `gravestone_shop` interface.
+ * Uses the native shop open and interface option instructions only.
+ */
+class GravestoneShopAuthorityTest : WorldTest() {
+
+    private val royalSlot: Int by lazy { EnumDefinitions.get("gravestone_names").map!!.entries.first { it.value == "Royal dwarven gravestone" }.key }
+    private val royalPrice: Int by lazy { EnumDefinitions.get("gravestone_price").int(royalSlot) }
+
+    private fun Player.confirm(slot: Int) = interfaceOption("gravestone_shop", "button", "Confirm", slot = slot)
+
+    @Test
+    fun `Buy a quest-unlocked royal dwarven gravestone and pay its cache price`() {
+        val player = createPlayer(Tile(3235, 3220))
+        player["the_restless_ghost"] = "completed"
+        player["king_of_the_dwarves"] = "completed"
+        player.inventory.add("coins", royalPrice)
+        tick()
+
+        player.open("gravestone_shop")
+        tick()
+        player.confirm(royalSlot)
+        tick()
+
+        assertEquals("royal_dwarven_gravestone", player["gravestone_current", "memorial_plaque"])
+        assertEquals(0, player.inventory.count("coins"))
+    }
+
+    @Test
+    fun `Quest-locked royal dwarven gravestone is not bought and costs nothing`() {
+        val player = createPlayer(Tile(3235, 3220))
+        player["the_restless_ghost"] = "completed"
+        player.inventory.add("coins", royalPrice)
+        tick()
+
+        player.open("gravestone_shop")
+        tick()
+        assertFalse(player.containsVarbit("unlocked_gravestones", "royal_dwarven_gravestone"))
+
+        player.confirm(royalSlot)
+        tick()
+
+        assertEquals("memorial_plaque", player["gravestone_current", "memorial_plaque"])
+        assertEquals(royalPrice, player.inventory.count("coins"))
+    }
+
+    @Test
+    fun `Re-selecting the current grave does not charge again`() {
+        val player = createPlayer(Tile(3235, 3220))
+        player["the_restless_ghost"] = "completed"
+        player["king_of_the_dwarves"] = "completed"
+        player.inventory.add("coins", royalPrice * 2)
+        tick()
+
+        player.open("gravestone_shop")
+        tick()
+        player.confirm(royalSlot)
+        tick()
+        assertEquals(royalPrice, player.inventory.count("coins"))
+
+        player.confirm(royalSlot)
+        tick()
+
+        assertEquals("royal_dwarven_gravestone", player["gravestone_current", "memorial_plaque"])
+        assertEquals(royalPrice, player.inventory.count("coins"))
+    }
+    @Test
+    fun `Returning to the free plaque works without an unlock bit`() {
+        val player = createPlayer(Tile(3235, 3220))
+        player["the_restless_ghost"] = "completed"
+        player["gravestone_current"] = "flag"
+        player.inventory.add("coins", 100)
+        tick()
+        player.open("gravestone_shop")
+        tick()
+        assertFalse(player.containsVarbit("unlocked_gravestones", "memorial_plaque"))
+        val plaqueSlot = EnumDefinitions.get("gravestone_names").map!!.entries.first { it.value == "Memorial plaque" }.key
+        player.confirm(plaqueSlot)
+        tick()
+        assertEquals("memorial_plaque", player["gravestone_current", "memorial_plaque"])
+        assertEquals(100, player.inventory.count("coins"))
+    }
+
+    @Test
+    fun `Malformed selection does not change the grave or coins`() {
+        val player = createPlayer(Tile(3235, 3220))
+        player["the_restless_ghost"] = "completed"
+        player.inventory.add("coins", royalPrice)
+        tick()
+        player.open("gravestone_shop")
+        tick()
+        for (slot in listOf(-1, 32767)) {
+            player.confirm(slot)
+            tick()
+            assertEquals("memorial_plaque", player["gravestone_current", "memorial_plaque"])
+            assertEquals(royalPrice, player.inventory.count("coins"))
+        }
+    }
+
+}
