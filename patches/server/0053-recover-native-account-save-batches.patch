+package world.gregs.voidps.engine.data.file
+
+import world.gregs.voidps.engine.data.PlayerSave
+import java.io.File
+import java.nio.channels.FileChannel
+import java.nio.file.Files
+import java.nio.file.LinkOption.NOFOLLOW_LINKS
+import java.nio.file.Path
+import java.nio.file.StandardCopyOption.ATOMIC_MOVE
+import java.nio.file.StandardCopyOption.REPLACE_EXISTING
+import java.nio.file.StandardOpenOption.READ
+import java.security.MessageDigest
+import java.util.UUID
+
+/**
+ * A recoverable redo batch for the native account files. The pending directory is
+ * the commit decision: before publication no canonical file changes; afterwards
+ * every account must be installed before an account reader may proceed.
+ *
+ * One owned server/Storage instance is required, as with the existing save path.
+ * This does not capture world entities or make arbitrary account snapshots coherent.
+ */
+internal class AccountSaveBatch(private val directory: File) {
+    private val root = directory.toPath().toAbsolutePath().normalize()
+
+    // Test-only observation seam; no setting, packet or environment variable enables it.
+    internal var boundary: (String) -> Unit = {}
+
+    fun save(accounts: List<PlayerSave>) {
+        recover()
+        if (accounts.isEmpty()) return
+        require(accounts.size <= MAX_ACCOUNTS) { "Account save batch is too large" }
+        val byName = accounts.associateBy { filename(it.name) }
+        require(byName.size == accounts.size) { "Duplicate account in save batch" }
+        safeAncestors(root)
+        Files.createDirectories(root)
+        for (name in byName.keys) target(root.resolve(name))
+        val stage = Files.createDirectory(root.resolve(".account-save-stage-${UUID.randomUUID()}"))
+        var published = false
+        try {
+            val records = byName.toSortedMap().map { (name, account) ->
+                val path = stage.resolve(name)
+                account.save(path.toFile())
+                val record = inspect(path, name)
+                force(path)
+                boundary("staged:$name")
+                record
+            }
+            require(records.sumOf { it.size } <= MAX_TOTAL) { "Account save batch is too large" }
+            val text = HEADER + "\n" + records.joinToString("") { "${it.name}\t${it.size}\t${it.digest}\n" }
+            Files.writeString(stage.resolve(MANIFEST), text)
+            force(stage.resolve(MANIFEST))
+            force(stage)
+            boundary("prepared")
+            Files.move(stage, root.resolve(PENDING), ATOMIC_MOVE)
+            published = true
+            force(root)
+            boundary("published")
+            recover()
+        } finally {
+            // A published decision is retained on failure for deterministic replay.
+            if (!published && Files.exists(stage, NOFOLLOW_LINKS)) {
+                // Only our own freshly created, bounded stage is eligible for cleanup.
+                for (name in byName.keys + MANIFEST) Files.deleteIfExists(stage.resolve(name))
+                // Native atomic-writer failure artifacts remain as evidence, if any.
+                if (Files.list(stage).use { !it.findAny().isPresent }) Files.delete(stage)
+            }
+        }
+    }
+
+    fun recover() {
+        val pending = root.resolve(PENDING)
+        if (!Files.exists(pending, NOFOLLOW_LINKS)) return
+        safeAncestors(root)
+        check(Files.isDirectory(pending, NOFOLLOW_LINKS)) { "Account batch journal is not a directory; preserve it for recovery" }
+        val manifest = pending.resolve(MANIFEST)
+        regular(manifest, MAX_MANIFEST)
+        val text = Files.readString(manifest)
+        val lines = text.split('\n')
+        check(lines.first() == HEADER && lines.last() == "") { "Unsupported or damaged account batch journal" }
+        val records = lines.drop(1).dropLast(1).map { row ->
+            val parts = row.split('\t')
+            check(parts.size == 3 && NAME.matches(parts[0]) && HASH.matches(parts[2])) { "Invalid account batch member" }
+            val size = parts[1].toLongOrNull()
+            check(size != null && size in 1..MAX_FILE && size.toString() == parts[1]) { "Invalid account batch member size" }
+            Record(parts[0], size, parts[2])
+        }
+        check(records.size in 1..MAX_ACCOUNTS && records.map { it.name } == records.map { it.name }.distinct().sorted()) { "Invalid account batch member order/count" }
+        check(records.sumOf { it.size } <= MAX_TOTAL) { "Account batch exceeds size limit" }
+        val members = Files.list(pending).use { paths -> paths.map { it.fileName.toString() }.toList().toSet() }
+        check(members == records.map { it.name }.toSet() + MANIFEST) { "Account batch contains missing or unknown files" }
+        // Validate the complete batch before touching any canonical account file.
+        for (record in records) {
+            check(inspect(pending.resolve(record.name), record.name) == record) { "Account batch checksum mismatch; preserve it for recovery" }
+            target(root.resolve(record.name))
+            target(installPath(record.name))
+        }
+        for (record in records) {
+            val install = installPath(record.name)
+            Files.copy(pending.resolve(record.name), install, REPLACE_EXISTING)
+            check(inspect(install, record.name) == record) { "Account batch changed during replay" }
+            force(install)
+            Files.move(install, root.resolve(record.name), ATOMIC_MOVE, REPLACE_EXISTING)
+            boundary("installed:${record.name}")
+        }
+        force(root)
+        boundary("materialized")
+        // Atomic retirement avoids leaving a half-deleted authoritative journal.
+        val complete = root.resolve(".account-save-complete-${UUID.randomUUID()}")
+        Files.move(pending, complete, ATOMIC_MOVE)
+        force(root)
+        boundary("retired")
+        // Cleanup is optional once the durable decision has retired. A crash or IO
+        // refusal here leaves inert evidence, never a partially authoritative journal.
+        runCatching {
+            for (record in records) Files.delete(complete.resolve(record.name))
+            Files.delete(complete.resolve(MANIFEST))
+            Files.delete(complete)
+        }
+    }
+
+    private fun installPath(name: String) = root.resolve(".save-account-batch-$name.tmp")
+
+    private fun filename(account: String): String = "${account.lowercase()}.toml".also {
+        require(NAME.matches(it)) { "Unsupported account filename" }
+    }
+
+    private fun inspect(path: Path, expectedName: String): Record {
+        regular(path, MAX_FILE)
+        val size = Files.size(path)
+        val hash = MessageDigest.getInstance("SHA-256")
+        Files.newInputStream(path, NOFOLLOW_LINKS).use { input ->
+            val buffer = ByteArray(8192)
+            var total = 0L
+            while (true) {
+                val n = input.read(buffer)
+                if (n < 0) break
+                total += n
+                check(total <= MAX_FILE) { "Account batch member exceeds size limit" }
+                hash.update(buffer, 0, n)
+            }
+            check(total == size) { "Account batch member changed while reading" }
+        }
+        check(filename(PlayerSave.load(path.toFile()).name) == expectedName) { "Account batch identity mismatch" }
+        return Record(expectedName, size, hash.digest().joinToString("") { "%02x".format(it) })
+    }
+
+    private fun target(path: Path) {
+        check(!Files.exists(path, NOFOLLOW_LINKS) || Files.isRegularFile(path, NOFOLLOW_LINKS)) { "Account target is not a regular file: ${path.fileName}" }
+    }
+
+    private fun regular(path: Path, limit: Long) {
+        check(Files.isRegularFile(path, NOFOLLOW_LINKS) && Files.size(path) in 1..limit) { "Invalid account batch file: ${path.fileName}" }
+    }
+
+    private fun safeAncestors(path: Path) {
+        var parent: Path? = path
+        while (parent != null) {
+            check(!Files.isSymbolicLink(parent)) { "Linked account storage is unsupported" }
+            parent = parent.parent
+        }
+    }
+
+    private fun force(path: Path) = FileChannel.open(path, READ).use { it.force(true) }
+
+    private data class Record(val name: String, val size: Long, val digest: String)
+
+    companion object {
+        const val PENDING = ".soloscape-account-save"
+        const val MANIFEST = "manifest.tsv"
+        const val HEADER = "SOLOSCAPE_ACCOUNT_BATCH_V1"
+        private val NAME = Regex("[a-z0-9 _-]{1,64}\\.toml")
+        private val HASH = Regex("[0-9a-f]{64}")
+        private const val MAX_ACCOUNTS = 2048
+        private const val MAX_FILE = 32L * 1024 * 1024
+        private const val MAX_TOTAL = 512L * 1024 * 1024
+        private const val MAX_MANIFEST = 512L * 1024
+    }
+}
