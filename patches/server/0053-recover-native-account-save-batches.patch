+package world.gregs.voidps.engine.data.file
+
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.io.TempDir
+import world.gregs.voidps.engine.data.PlayerSave
+import world.gregs.voidps.engine.entity.item.Item
+import world.gregs.voidps.type.Tile
+import java.io.File
+import java.io.IOException
+import java.net.URLClassLoader
+import java.nio.file.Files
+import java.nio.file.Path
+import java.security.MessageDigest
+import java.util.concurrent.TimeUnit
+import kotlin.test.*
+
+class AccountBatchRecoveryTest {
+    @TempDir
+    lateinit var directory: Path
+
+    private fun initial(root: Path): FileStorage = FileStorage(root.toFile()).also {
+        it.save(listOf(snapshot("batchone", 10), snapshot("batchtwo", 0)))
+    }
+
+    @Test
+    fun `Cold process exits select all old or all new native account files`() {
+        val boundaries = listOf("staged:batchone.toml", "staged:batchtwo.toml", "prepared", "published", "installed:batchone.toml", "installed:batchtwo.toml", "materialized", "retired")
+        for ((index, boundary) in boundaries.withIndex()) {
+            val root = Files.createDirectory(directory.resolve("case$index"))
+            initial(root)
+            val beforeCommit = index < 3
+            child(root, "write", boundary, 73)
+            child(root, "read", if (beforeCommit) "10,0" else "2,8", 0)
+            assertFalse(Files.exists(root.resolve(AccountSaveBatch.PENDING)), boundary)
+            assertEquals(10, amount(FileStorage(root.toFile()).load("batchone")!!) + amount(FileStorage(root.toFile()).load("batchtwo")!!))
+        }
+    }
+
+    @Test
+    fun `A second process exit during replay is idempotently recovered`() {
+        initial(directory)
+        child(directory, "write", "published", 73)
+        child(directory, "read-crash", "installed:batchone.toml", 73)
+        child(directory, "read", "2,8", 0)
+        child(directory, "read", "2,8", 0)
+    }
+
+    @Test
+    fun `Corrupt journal refuses every account entrypoint before mutation`() {
+        val storage = initial(directory)
+        storage.accountBatch.boundary = { if (it == "published") throw IOException("fixture cut") }
+        assertFails { storage.save(listOf(snapshot("batchone", 2), snapshot("batchtwo", 8))) }
+        val journal = directory.resolve(AccountSaveBatch.PENDING)
+        Files.writeString(journal.resolve("batchtwo.toml"), "invalid original fixture")
+        val before = fingerprint(directory)
+        val fresh = FileStorage(directory.toFile())
+        for (read in listOf<() -> Any?>({ fresh.names() }, { fresh.clans() }, { fresh.exists("batchone") }, { fresh.load("batchone") }, { fresh.save(emptyList()) })) {
+            assertFails { read() }
+            assertEquals(before, fingerprint(directory))
+        }
+    }
+
+    @Test
+    fun `Corruption after one installation refuses mixed state instead of serving it`() {
+        val storage = initial(directory)
+        storage.accountBatch.boundary = { if (it == "installed:batchone.toml") throw IOException("fixture cut") }
+        assertFails { storage.save(listOf(snapshot("batchone", 2), snapshot("batchtwo", 8))) }
+        // These direct disk reads demonstrate the exact mixed state which the guarded
+        // Storage readers must never expose. They do not use the recovery entrypoint.
+        assertEquals(2, amount(PlayerSave.load(directory.resolve("batchone.toml").toFile())))
+        assertEquals(0, amount(PlayerSave.load(directory.resolve("batchtwo.toml").toFile())))
+        Files.writeString(directory.resolve("${AccountSaveBatch.PENDING}/batchtwo.toml"), "corrupt")
+        val before = fingerprint(directory)
+        assertFails { FileStorage(directory.toFile()).load("batchone") }
+        assertEquals(before, fingerprint(directory))
+    }
+
+    @Test
+    fun `Linked journal member refuses without touching external sentinel`() {
+        val storage = initial(directory)
+        storage.accountBatch.boundary = { if (it == "published") throw IOException("fixture cut") }
+        assertFails { storage.save(listOf(snapshot("batchone", 2), snapshot("batchtwo", 8))) }
+        val member = directory.resolve("${AccountSaveBatch.PENDING}/batchone.toml")
+        val sentinel = directory.resolve("sentinel")
+        Files.writeString(sentinel, "external original fixture")
+        Files.delete(member)
+        Files.createSymbolicLink(member, sentinel)
+        assertFails { FileStorage(directory.toFile()).load("batchone") }
+        assertEquals("external original fixture", Files.readString(sentinel))
+        assertTrue(Files.isSymbolicLink(member))
+        assertEquals(10, amount(PlayerSave.load(directory.resolve("batchone.toml").toFile())))
+    }
+
+    @Test
+    fun `Identity mismatch refuses even with a matching new manifest digest`() {
+        val storage = initial(directory)
+        storage.accountBatch.boundary = { if (it == "published") throw IOException("fixture cut") }
+        assertFails { storage.save(listOf(snapshot("batchone", 2), snapshot("batchtwo", 8))) }
+        val journal = directory.resolve(AccountSaveBatch.PENDING)
+        val member = journal.resolve("batchone.toml")
+        snapshot("other", 2).save(member.toFile())
+        val manifest = journal.resolve(AccountSaveBatch.MANIFEST)
+        val lines = Files.readAllLines(manifest).map {
+            if (it.startsWith("batchone.toml\t")) "batchone.toml\t${Files.size(member)}\t${digest(Files.readAllBytes(member))}" else it
+        }
+        Files.writeString(manifest, lines.joinToString("\n") + "\n")
+        val before = fingerprint(directory)
+        assertFails { FileStorage(directory.toFile()).load("batchone") }
+        assertEquals(before, fingerprint(directory))
+    }
+
+    @Test
+    fun `Unexpected or absent journal members refuse and retain all evidence`() {
+        for (extra in listOf(true, false)) {
+            val root = Files.createDirectory(directory.resolve(if (extra) "extra" else "absent"))
+            val storage = initial(root)
+            storage.accountBatch.boundary = { if (it == "published") throw IOException("fixture cut") }
+            assertFails { storage.save(listOf(snapshot("batchone", 2), snapshot("batchtwo", 8))) }
+            val journal = root.resolve(AccountSaveBatch.PENDING)
+            if (extra) Files.writeString(journal.resolve("unlisted"), "fixture") else Files.delete(journal.resolve("batchtwo.toml"))
+            val before = fingerprint(root)
+            assertFails { FileStorage(root.toFile()).load("batchone") }
+            assertEquals(before, fingerprint(root))
+        }
+    }
+
+    @Test
+    fun `Case equivalent duplicate names cannot publish a batch`() {
+        val storage = initial(directory)
+        val before = fingerprint(directory)
+        assertFails { storage.save(listOf(snapshot("BatchOne", 2), snapshot("batchone", 8))) }
+        assertEquals(before, fingerprint(directory))
+    }
+
+    private fun child(root: Path, mode: String, value: String, expected: Int) {
+        val urls = generateSequence(javaClass.classLoader) { it.parent }.filterIsInstance<URLClassLoader>()
+            .flatMap { it.urLs.asSequence() }.map { File(it.toURI()).path }.toList()
+        val classpath = (urls + System.getProperty("java.class.path").split(File.pathSeparator)).distinct().joinToString(File.pathSeparator)
+        val log = root.resolve("$mode-${value.replace(':', '-')}.log").toFile()
+        val process = ProcessBuilder(File(System.getProperty("java.home"), "bin/java").path, "-cp", classpath, AccountBatchCrashProcess::class.java.name, root.toString(), mode, value)
+            .redirectErrorStream(true).redirectOutput(log).start()
+        if (!process.waitFor(20, TimeUnit.SECONDS)) {
+            process.destroyForcibly().waitFor()
+            fail("Owned fixture child timed out: $mode $value")
+        }
+        assertEquals(expected, process.exitValue(), "Child $mode/$value failed: ${log.readText().takeLast(2500)}")
+    }
+
+    private fun fingerprint(root: Path): Map<String, String> = Files.walk(root).use { paths ->
+        paths.filter { Files.isRegularFile(it) }.toList().associate { root.relativize(it).toString() to digest(Files.readAllBytes(it)) }
+    }
+
+    companion object {
+        fun snapshot(name: String, coins: Int) = PlayerSave(
+            name = name, password = "original-fixture", tile = Tile(3200, 3201),
+            experience = IntArray(25), blocked = emptyList(), levels = IntArray(25) { 1 },
+            male = true, looks = IntArray(7), colours = IntArray(5), variables = emptyMap(),
+            inventories = mapOf("inventory" to arrayOf(if (coins == 0) Item.EMPTY else Item("coins", coins))),
+            friends = emptyMap(), ignores = emptyList(), offers = emptyArray(), history = emptyList(),
+            kills = emptyMap(), records = emptyMap(), recentEvents = emptyList(),
+        )
+        fun amount(save: PlayerSave) = save.inventories.getValue("inventory").filter { it.id == "coins" }.sumOf { it.value }
+        fun digest(bytes: ByteArray) = MessageDigest.getInstance("SHA-256").digest(bytes).joinToString("") { "%02x".format(it) }
+    }
+}
+
+/** Original native storage fixture, run only by the test in a disposable subprocess. */
+object AccountBatchCrashProcess {
+    @JvmStatic
+    fun main(args: Array<String>) {
+        val storage = FileStorage(File(args[0]))
+        when (args[1]) {
+            "write", "read-crash" -> {
+                storage.accountBatch.boundary = { if (it == args[2]) Runtime.getRuntime().halt(73) }
+                if (args[1] == "write") storage.save(listOf(AccountBatchRecoveryTest.snapshot("batchone", 2), AccountBatchRecoveryTest.snapshot("batchtwo", 8)))
+                else storage.load("batchone")
+                error("Requested native crash boundary was not observed")
+            }
+            "read" -> {
+                val expected = args[2].split(',').map { it.toInt() }
+                // names/clans are startup consumers, before an actual account load.
+                check(storage.names().keys == setOf("batchone", "batchtwo"))
+                check(storage.clans().keys == setOf("batchone", "batchtwo"))
+                val actual = listOf("batchone", "batchtwo").map { AccountBatchRecoveryTest.amount(storage.load(it)!!) }
+                check(actual == expected && actual.sum() == 10) { "Nonconserving or mixed native accounts: $actual" }
+                check(!File(args[0], AccountSaveBatch.PENDING).exists())
+            }
+            else -> error("Unknown fixture mode")
+        }
+    }
+}
