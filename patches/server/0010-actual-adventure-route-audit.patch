+@EnabledIfEnvironmentVariable(named = "SOLOSCAPE_TEST_ROOT", matches = ".+")
+internal class ActualAdventureRouteTest : WorldTest() {
+    override var loadNpcs: Boolean = true
+
+    @Test
+    fun `walk the actual Restless Ghost route with native NPCs and objects`() {
+        val player = createPlayer(Tile(3245, 3207))
+
+        // start quest
+        val fatherAereck = NPCs.find(player.tile.regionLevel, "father_aereck")
+        player.npcOption(fatherAereck, "Talk-to")
+        tick()
+        player.skipDialogues()
+        player.dialogueOption(3) // I'm looking for a quest!
+        player.skipDialogues()
+        tick(2)
+        // quest overview interface
+        player.interfaceOption("quest_intro", "startyes_layer", "Yes")
+        player.skipDialogues()
+
+        assertNull(player.dialogue)
+        assertEquals("started", player.quest("the_restless_ghost"))
+
+        // get ghostspeak amulet at father urhney
+        travel(player,listOf(Tile(3243,3209),Tile(3236,3205),Tile(3244,3190),Tile(3241,3176),Tile(3239,3160),Tile(3221,3156),Tile(3201,3155),Tile(3207,3153)))
+        openDoor(player,Tile(3207,3152))
+        travel(player,listOf(Tile(3207,3149)))
+        val fatherUrhney = NPCs.find(player.tile.regionLevel, "father_urhney")
+        player.npcOption(fatherUrhney, "Talk-to")
+        tick()
+        player.skipDialogues()
+        player.dialogueOption(2) // Father Aereck sent me to talk to you.
+        player.skipDialogues()
+        player.dialogueOption(1) // A ghost is haunting his graveyard.
+        player.skipDialogues()
+
+        assertNull(player.dialogue)
+        assertEquals("ghost", player.quest("the_restless_ghost"))
+        assertEquals(1, player.inventory.count("ghostspeak_amulet"))
+
+        // equip amulet
+        player.equipItem("ghostspeak_amulet", 0, "Wear")
+        assertEquals(0, player.inventory.count("ghostspeak_amulet"))
+
+        // go talk to ghost
+        openDoor(player,Tile(3207,3152))
+        travel(player,listOf(Tile(3207,3153),Tile(3201,3155),Tile(3221,3156),Tile(3239,3160),Tile(3241,3176),Tile(3244,3190),Tile(3251,3192)))
+        val closedCoffin = GameObjects.find(Tile(3249, 3192), "restless_ghost_coffin_closed")
+        player.interactObject(closedCoffin, "Open")
+        tick(5)
+        val restlessGhost = NPCs.find(Tile(3250, 3195), "restless_ghost")
+        player.npcOption(restlessGhost, "Talk-to")
+        tick(2)
+        player.skipDialogues()
+        player.dialogueOption(1) // Yep. Now, tell me what the problem is.
+        player.skipDialogues()
+
+        assertNull(player.dialogue)
+        assertEquals("mining_spot", player.quest("the_restless_ghost"))
+
+        // get skull from rock
+        travel(player,listOf(Tile(3244,3190),Tile(3241,3176),Tile(3239,3160),Tile(3234,3147)))
+        val rock = GameObjects.find(Tile(3234, 3145), "rocks_skull_restless_ghost_quest_base")
+        player.interactObject(rock, "Search")
+        tick()
+        player.continueDialogue()
+
+        assertNull(player.dialogue)
+        assertEquals(1, player.inventory.count("muddy_skull"))
+        assertEquals("found_skull", player.quest("the_restless_ghost"))
+        // flee from skeleton
+        travel(player,listOf(Tile(3239,3160),Tile(3241,3176),Tile(3244,3190),Tile(3251,3192)))
+
+        // put skull into coffin and complete the quest
+        val coffin2 = GameObjects.find(Tile(3249, 3192), "coffin_restless_ghost_2")
+        player.interactObject(coffin2, "Search")
+        tick(16)
+
+        assertEquals("completed", player.quest("the_restless_ghost"))
+        assertEquals(1125.0, player.experience.get(Skill.Prayer))
+        verifySave(player,mapOf("the_restless_ghost" to "completed"))
+    }
+
+    @Test
+    fun `walk kitchen castle floors start Rune Mysteries and bank the talisman`() {
+        val player=createPlayer(Tile(3208,3215))
+        val cook=NPCs.find(player.tile.regionLevel,"cook_lumbridge")
+        player.npcOption(cook,"Talk-to");tick();player.skipDialogues()
+        player.dialogueOption(1);player.skipDialogues();player.dialogueOption(1);player.skipDialogues()
+        assertEquals("started",player.quest("cooks_assistant"))
+        travel(player,listOf(Tile(3211,3214),Tile(3208,3210),Tile(3215,3216),Tile(3215,3224),Tile(3208,3227)))
+        openDoor(player,Tile(3207,3227))
+        travel(player,listOf(Tile(3205,3228)))
+        player.objectOption(GameObjects.find(Tile(3204,3229),"lumbridge_castle_staircase_north"),"Climb-up");tick(6)
+        assertEquals(1,player.tile.level)
+        travel(player,listOf(Tile(3206,3222,1)))
+        openDoor(player,Tile(3207,3222,1))
+        travel(player,listOf(Tile(3210,3223,1)))
+        val duke=NPCs.find(player.tile.regionLevel,"duke_horacio")
+        player.npcOption(duke,"Talk-to");tick(5);player.skipDialogues()
+        player.dialogueOption(1);player.skipDialogues();player.dialogueOption(1);player.skipDialogues()
+        assertEquals("started",player.quest("rune_mysteries"));assertEquals(1,player.inventory.count("talisman_rune_mysteries"))
+        openDoor(player,Tile(3207,3222,1))
+        travel(player,listOf(Tile(3206,3222,1),Tile(3205,3228,1)))
+        player.objectOption(GameObjects.find(Tile(3204,3229,1),"lumbridge_castle_staircase_north_middle"),"Climb-up");tick(6)
+        assertEquals(2,player.tile.level)
+        travel(player,listOf(Tile(3205,3228,2),Tile(3208,3219,2)))
+        val banker=NPCs.find(player.tile.regionLevel,"banker_3")
+        player.npcOption(banker,"Bank");tick(4)
+        assertTrue(player.interfaces.contains("bank"))
+        player.interfaceOption("bank_side","inventory","Deposit-1",item=world.gregs.voidps.engine.entity.item.Item("talisman_rune_mysteries"),slot=player.inventory.indexOf("talisman_rune_mysteries"));tick()
+        assertEquals(0,player.inventory.count("talisman_rune_mysteries"));assertEquals(1,player.bank.count("talisman_rune_mysteries"))
+        verifySave(player,mapOf("cooks_assistant" to "started","rune_mysteries" to "started"))
+    }
+
+    private fun verifySave(player:Player,quests:Map<String,String>){
+        val directory=Files.createTempDirectory("soloscape-actual-adventure-")
+        try{
+            runBlocking{SaveQueue(FileStorage(directory.toFile())).direct().join()}
+            val restored=PlayerSave.load(directory.resolve("${player.accountName.lowercase()}.toml").toFile())
+            assertEquals(player.tile,restored.tile)
+            for((quest,state) in quests)assertEquals(state,restored.variables[quest])
+            assertArrayEquals(player.experience.experience,restored.experience)
+            for((name,inventory) in player.inventories.instances)assertArrayEquals(inventory.items,restored.inventories[name])
+        }finally{directory.toFile().deleteRecursively()}
+    }
+
+    private fun openDoor(player:Player,tile:Tile){
+        val door=GameObjects.findOrNull(tile){it.id.contains("door")&&it.id.endsWith("closed")}?:return
+        player.objectOption(door,"Open");tick(6)
+    }
+    private fun travel(player: Player,route:List<Tile>) {
+        for(destination in route){
+            player.walk(destination)
+            repeat(80){if(player.tile!=destination)tick()}
+            val nearby=mutableListOf<String>()
+            if(player.tile!=destination)for(x in player.tile.x-8..player.tile.x+8)for(y in player.tile.y-8..player.tile.y+8){
+                val obj=GameObjects.findOrNull(Tile(x,y,player.tile.level)){it.id.contains("door")||it.id.contains("gate")}
+                if(obj!=null)nearby.add("${obj.id}@${obj.tile}")
+            }
+            assertEquals(destination,player.tile,"Route blocked; nearby doors: $nearby")
+        }
+    }
+}
