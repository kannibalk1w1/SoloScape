diff --git a/engine/src/test/kotlin/world/gregs/voidps/engine/queue/ActionQueueTest.kt b/engine/src/test/kotlin/world/gregs/voidps/engine/queue/ActionQueueTest.kt
index 4898e9a..c74b8f1 100644
--- a/engine/src/test/kotlin/world/gregs/voidps/engine/queue/ActionQueueTest.kt
+++ b/engine/src/test/kotlin/world/gregs/voidps/engine/queue/ActionQueueTest.kt
@@ -165,4 +165,43 @@ internal class ActionQueueTest {
         assertTrue(pastAwait, "Action should advance when the Custom predicate is already satisfied")
         assertTrue(queue.isEmpty())
     }
+    @Test
+    fun `Logout cancels unanswered typed entries without manufacturing an answer`() {
+        for (type in 7..9) {
+            var answered = false
+            var cleaned = false
+            queue.add(Action<Player>("pending_entry", 1, ActionPriority.Long) {
+                try {
+                    if (type == 7) suspendCancellableCoroutine<Int> { suspension = Suspension.IntEntry(it) }
+                    else suspendCancellableCoroutine<String> { suspension = if (type == 8) Suspension.NameEntry(it) else Suspension.StringEntry(it) }
+                    answered = true
+                } finally { cleaned = true }
+            })
+            queue.logout()
+            assertFalse(answered, "Logout must not supply text/quantity")
+            assertTrue(cleaned, "Cancelled continuation must clean up")
+            assertTrue(player.suspension == null)
+            assertTrue(queue.isEmpty())
+        }
+    }
+    @Test
+    fun `Logout drains cleanup suspension installed while cancelling typed entry`() {
+        var cleaned = false
+        queue.add(Action<Player>("entry_with_cleanup", 1, ActionPriority.Long) {
+            try {
+                suspendCancellableCoroutine<Int> { suspension = Suspension.IntEntry(it) }
+            } finally {
+                kotlinx.coroutines.withContext(kotlinx.coroutines.NonCancellable) {
+                    suspendCancellableCoroutine<Unit> { suspension = Suspension.Continue(it) }
+                    suspension = null
+                    cleaned = true
+                }
+            }
+        })
+        queue.logout()
+        assertTrue(cleaned, "Logout must drain the replacement cleanup suspension")
+        assertTrue(player.suspension == null)
+        assertTrue(queue.isEmpty())
+    }
+
 }
