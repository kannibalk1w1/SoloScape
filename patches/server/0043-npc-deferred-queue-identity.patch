+    // Native engine contract only: deferred NPCs queue APIs with the fake test definition.
+    // Not a network or physical reachability test.
+
+    @Test
+    fun `Duplicate queued removal does not decrement size twice`() {
+        try {
+            val npc1 = NPCs.add("test", Tile(1))
+            val npc2 = NPCs.add("test", Tile(1))
+            val index1 = npc1.index
+            NPCs.run()
+            assertEquals(2, NPCs.size)
+
+            NPCs.remove(npc1)
+            NPCs.remove(npc1)
+            NPCs.run()
+
+            assertEquals(1, NPCs.size)
+            assertNull(NPCs.indexed(index1))
+            val live = NPCs.toList()
+            assertEquals(1, live.size)
+            assertSame(npc2, live.single())
+            assertSame(npc2, NPCs.indexed(npc2.index))
+        } finally {
+            drainQueues()
+        }
+    }
+
+    @Test
+    fun `Add then remove before run never spawns a ghost`() {
+        try {
+            val npc = NPCs.add("test", Tile(1))
+            val index = npc.index
+            assertTrue(NPCs.remove(npc))
+            NPCs.run()
+
+            assertNull(NPCs.indexed(index))
+            assertTrue(NPCs.toList().isEmpty())
+            assertEquals(0, NPCs.size)
+        } finally {
+            drainQueues()
+        }
+    }
+
+    @Test
