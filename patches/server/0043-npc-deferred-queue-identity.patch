+            val npc1 = NPCs.add("test", Tile(1))
+            val npc2 = NPCs.add("test", Tile(2))
+            assertNotEquals(npc1.index, npc2.index)
+            NPCs.run()
+
+            assertEquals(2, NPCs.size)
+            assertSame(npc1, NPCs.indexed(npc1.index))
+            assertSame(npc2, NPCs.indexed(npc2.index))
+            val live = NPCs.toList()
+            assertEquals(2, live.size)
+            assertTrue(live.any { it === npc1 })
+            assertTrue(live.any { it === npc2 })
+        } finally {
+            indexer.setInt(NPCs, original)
+            drainQueues()
+        }
+    }
+
