@@ -0,0 +1,24 @@
+package world.gregs.voidps.engine.client.instruction.handle
+
+import world.gregs.voidps.engine.client.ui.closeInterfaces
+import world.gregs.voidps.engine.entity.character.mode.EmptyMode
+import world.gregs.voidps.engine.entity.character.mode.interact.Interact
+import world.gregs.voidps.engine.entity.character.mode.move.Movement
+import world.gregs.voidps.engine.entity.character.player.Player
+
+object CancelWorldActionHandler {
+    fun handle(player: Player) {
+        // Match ordinary walking's busy gate; do not break forced actions such as agility.
+        if (player.contains("delay")) return
+        if (player.mode is Interact) player.clearAnim()
+        player.closeInterfaces()
+        player.clearWatch()
+        player.queue.clearWeak()
+        player.suspension = null
+        player.clearWalkTrigger()
+        if (player.mode is Movement) {
+            player.mode = EmptyMode
+            player.steps.clear()
+        }
+    }
+}
