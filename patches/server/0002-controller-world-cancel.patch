+package world.gregs.voidps.network.login.protocol
+
+import io.ktor.utils.io.core.*
+import kotlinx.coroutines.test.runTest
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.Test
+import world.gregs.voidps.cache.secure.Huffman
+import world.gregs.voidps.network.client.instruction.CancelWorldAction
+
+class CancelWorldActionDecoderTest {
+    @Test fun `cancel is opcode 86 with no client position and preserves direct opcode 85`() = runTest {
+        val decoders = decoders(Huffman())
+        assertEquals(0, decoders[86]!!.length)
+        val packet = ByteReadPacket(byteArrayOf())
+        assertSame(CancelWorldAction, decoders[86]!!.decode(packet))
+        assertTrue(packet.isEmpty)
+        assertEquals(3, decoders[85]!!.length)
+    }
+}
