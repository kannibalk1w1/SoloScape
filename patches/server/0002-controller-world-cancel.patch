+package world.gregs.voidps.engine.client.instruction.handle
+
+import io.mockk.*
+import org.junit.jupiter.api.Assertions.*
+import org.junit.jupiter.api.BeforeEach
+import org.junit.jupiter.api.AfterEach
+import org.junit.jupiter.api.Test
+import org.koin.test.mock.declareMock
+import org.rsmod.game.pathfinder.*
+import world.gregs.voidps.engine.client.ui.closeInterfaces
+import world.gregs.voidps.engine.entity.character.mode.EmptyMode
+import world.gregs.voidps.engine.entity.character.mode.Mode
+import world.gregs.voidps.engine.entity.character.mode.move.Movement
+import world.gregs.voidps.engine.entity.character.player.Player
+import world.gregs.voidps.engine.script.KoinMock
+import world.gregs.voidps.type.Tile
+
+class CancelWorldActionHandlerTest : KoinMock() {
+    private lateinit var player: Player
+    @BeforeEach fun setup() {
+        declareMock<StepValidator>(); declareMock<LineValidator>(); declareMock<PathFinder>()
+        player = Player(tile = Tile(64, 64))
+        mockkStatic("world.gregs.voidps.engine.client.ui.InterfacesKt")
+        every { player.closeInterfaces() } returns true
+    }
+    @AfterEach fun restore() { unmockkStatic("world.gregs.voidps.engine.client.ui.InterfacesKt") }
+    @Test fun `cancel clears the current approach queue and watch without moving the player`() {
+        player.mode = Movement(player)
+        player.steps.queueStep(Tile(70, 64))
+        player["face_entity"] = Any()
+        var triggered = false
+        player.walkTrigger { triggered = true }
+        CancelWorldActionHandler.handle(player)
+        assertSame(EmptyMode, player.mode); assertTrue(player.steps.isEmpty())
+        assertEquals(Tile(64, 64), player.tile); assertNull(player.walkTrigger); assertFalse(triggered)
+        verify(exactly = 1) { player.closeInterfaces() }
+    }
+    @Test fun `forced busy action is preserved`() {
+        val forced = Movement(player)
+        player.mode = forced; player.steps.queueStep(Tile(65, 64), noCollision = true)
+        player["delay"] = -1
+        CancelWorldActionHandler.handle(player)
+        assertSame(forced, player.mode); assertFalse(player.steps.isEmpty())
+        verify(exactly = 0) { player.closeInterfaces() }
+    }
+    @Test fun `nonmovement modes are not replaced or stripped of their steps`() {
+        val mode = object : Mode { override fun tick() {} }
+        player.mode = mode; player.steps.queueStep(Tile(65, 64))
+        CancelWorldActionHandler.handle(player)
+        assertSame(mode, player.mode); assertFalse(player.steps.isEmpty())
+    }
+}
