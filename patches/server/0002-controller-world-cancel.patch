+package world.gregs.voidps.network.login.protocol.decode
+
+import kotlinx.io.Source
+import world.gregs.voidps.network.client.instruction.CancelWorldAction
+import world.gregs.voidps.network.login.protocol.Decoder
+
+/** SoloScape opcode 86 has no payload and carries no client position. */
+class CancelWorldActionDecoder : Decoder(0) {
+    override suspend fun decode(packet: Source) = CancelWorldAction
+}
