+package world.gregs.config
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.api.Test
+import org.junit.jupiter.api.TestFactory
+import org.junit.jupiter.api.DynamicTest.dynamicTest
+import java.io.BufferedWriter
+import java.io.StringWriter
+
+class ConfigReaderLongStringTest {
+    @TestFactory
+    fun `Quoted strings preserve bytes across the initial buffer boundary`() = listOf(99, 100, 101, 256, 1024).map { length -> dynamicTest("$length bytes") {
+        val expected = "x".repeat(length)
+        Config.stringReader("desc = \"$expected\"\nnext = 42") {
+            assertEquals("desc", key())
+            assertEquals(expected, string())
+            assertEquals("next", key())
+            assertEquals(42, int())
+        }
+    } }
+
+    @Test
+    fun `Recent event descriptions round trip with UTF8`() {
+        val expected = mapOf("recent_events" to listOf(mapOf("time" to 42, "title" to "Druidic Ritual", "desc" to "The druids' Guthix blessing — quest complete! ".repeat(12))))
+        val text = StringWriter()
+        BufferedWriter(text).use { it.writePair("recent_events", expected.getValue("recent_events")) }
+        Config.stringReader(text.toString()) {
+            assertEquals(expected, sections().getValue(""))
+        }
+    }
+
+    @Test
+    fun `Escaped quotes survive growth at the buffer boundary`() {
+        val prefix = "x".repeat(100)
+        Config.stringReader("desc = \"$prefix\\\"Guthix\\\"\"\nnext = 9") {
+            assertEquals("desc", key())
+            assertEquals("$prefix\"Guthix\"", string())
+            assertEquals("next", key())
+            assertEquals(9, int())
+        }
+    }
+
+    @Test
+    fun `Tiny buffers grow for long sections bare keys and literal strings`() {
+        val section = "region".repeat(24)
+        val key = "event".repeat(30)
+        val value = "quest complete ".repeat(30)
+        Config.stringReader("[$section]\n$key = '$value'\nnext = 7", maxStringLength = 0) {
+            assertEquals(section, section())
+            assertEquals(key, key())
+            assertEquals(value, string())
+            assertEquals("next", key())
+            assertEquals(7, int())
+        }
+    }
+}
