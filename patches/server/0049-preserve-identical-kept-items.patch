diff --git a/game/src/test/kotlin/content/area/misthalin/lumbridge/church/IdenticalItemsKeptOnDeathTest.kt b/game/src/test/kotlin/content/area/misthalin/lumbridge/church/IdenticalItemsKeptOnDeathTest.kt
