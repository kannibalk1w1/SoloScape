diff --git a/game/src/test/kotlin/content/area/misthalin/lumbridge/church/DeathDropChargeRecoveryTest.kt b/game/src/test/kotlin/content/area/misthalin/lumbridge/church/DeathDropChargeRecoveryTest.kt
