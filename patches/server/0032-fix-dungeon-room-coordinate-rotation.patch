+package content.skill.dungeoneering
+
+import org.junit.jupiter.api.Assertions.assertEquals
+import org.junit.jupiter.params.ParameterizedTest
+import org.junit.jupiter.params.provider.ValueSource
+import world.gregs.voidps.type.Region
+import world.gregs.voidps.type.Tile
+
+class DungeonRoomCoordinateTest {
+    @ParameterizedTest
+    @ValueSource(ints = [0, 1, 2, 3])
+    fun `Room rotation preserves all tile positions and agrees with quarter-turn geometry`(rotation: Int) {
+        val room = DungeonRoom(Tile(2, 1), isCritical = true).apply { this.rotation = rotation }
+        val grid = arrayOfNulls<DungeonRoom>(20).apply { this[7] = room }
+        val dungeon = DungeonMap(5, 4, room.tile, grid, "frozen", 1).apply { region = Region(100, 50) }
+        val base = dungeon.tile(room)
+        val positions = mutableSetOf<Tile>()
+        for (x in 0 until 16) {
+            for (y in 0 until 16) {
+                // Independent geometric oracle: rotate a point around the 16x16 square, one quarter-turn at a time.
+                var expectedX = x
+                var expectedY = y
+                repeat(rotation) {
+                    val previousX = expectedX
+                    expectedX = 15 - expectedY
+                    expectedY = previousX
+                }
+                val actual = dungeon.tile(room, x, y)
+                assertEquals(base.add(expectedX, expectedY), actual, "rotation=$rotation input=($x,$y)")
+                positions.add(actual)
+            }
+        }
+        assertEquals(256, positions.size, "A rotated room must not collapse different source tiles")
+    }
+}
