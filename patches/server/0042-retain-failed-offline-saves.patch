 internal class SaveQueueTest : KoinMock() {
 
+    @TempDir
+    lateinit var nativeDirectory: Path
+
+    private fun refusedAccount(directory: Path, account: String): FileStorage {
+        Files.createDirectories(directory.resolve("$account.toml"))
+        Files.writeString(directory.resolve("$account.toml/sentinel"), "original fixture")
+        return FileStorage(directory.toFile())
+    }
+
+    @Test
+    fun `Offline double write failure cannot become an empty successful shutdown`() {
+        val account = "offline_double"
+        val primary = refusedAccount(nativeDirectory.resolve("primary"), account)
+        val fallback = refusedAccount(nativeDirectory.resolve("fallback"), account)
+        val queue = SaveQueue(primary, fallback, retryMillis = 0)
+        queue.save(Player(accountName = account, tile = Tile(3200, 3201)))
+        queue.run()
+        runBlocking { queue.awaitInFlight() }
+        val results = CopyOnWriteArrayList<Boolean>()
+
+        runBlocking { queue.direct { results.add(it) }.join() }
+
+        assertEquals(listOf(false), results, "A failed offline save must still fail final primary confirmation")
+        assertTrue(queue.saving(account), "The failed offline snapshot must remain pending")
+        assertEquals("original fixture", Files.readString(nativeDirectory.resolve("primary/$account.toml/sentinel")))
+        assertEquals("original fixture", Files.readString(nativeDirectory.resolve("fallback/$account.toml/sentinel")))
+    }
+
+    @Test
+    fun `Offline fallback success cannot become an empty primary confirmation`() {
+        val account = "offline_fallback"
+        val primary = refusedAccount(nativeDirectory.resolve("primary"), account)
+        val fallbackDirectory = Files.createDirectories(nativeDirectory.resolve("fallback"))
+        val fallback = FileStorage(fallbackDirectory.toFile())
+        val queue = SaveQueue(primary, fallback, retryMillis = 0)
+        val tile = Tile(3202, 3203)
+        queue.save(Player(accountName = account, tile = tile))
+        queue.run()
+        runBlocking { queue.awaitInFlight() }
+        assertEquals(tile, fallback.load(account)?.tile, "Native fallback actually received the snapshot")
+        val results = CopyOnWriteArrayList<Boolean>()
+
+        runBlocking { queue.direct { results.add(it) }.join() }
+
+        assertEquals(listOf(false), results, "Fallback is not a successful primary account save")
+        assertTrue(queue.saving(account), "Relogin stays blocked by the existing pending-save gate")
+    }
+
+    @Test
+    fun `Offline fallback keeps the snapshot available for a later primary retry`() {
+        val account = "offline_retry"
+        val primaryDirectory = nativeDirectory.resolve("primary")
+        val primary = refusedAccount(primaryDirectory, account)
+        val fallback = FileStorage(Files.createDirectories(nativeDirectory.resolve("fallback")).toFile())
+        val queue = SaveQueue(primary, fallback, retryMillis = 0)
+        val tile = Tile(3204, 3205)
+        queue.save(Player(accountName = account, tile = tile))
+        queue.run()
+        runBlocking { queue.awaitInFlight() }
+        assertEquals(tile, fallback.load(account)?.tile)
+        assertTrue(queue.saving(account), "Fallback must not discard the retryable offline snapshot")
+
+        // Remove only this test's deliberate refusal fixture, allowing the primary disk write.
+        Files.delete(primaryDirectory.resolve("$account.toml/sentinel"))
+        Files.delete(primaryDirectory.resolve("$account.toml"))
+        queue.run()
+        runBlocking { queue.awaitInFlight() }
+
+        assertEquals(tile, primary.load(account)?.tile, "Primary retry writes the original offline snapshot")
+        assertFalse(queue.saving(account))
+        assertTrue(queue.empty())
+        assertEquals(tile, fallback.load(account)?.tile, "Retain the fallback evidence")
+    }
+
+
     private open class TestStorage : Storage {
         override fun names(): Map<String, AccountDefinition> = emptyMap()
 
