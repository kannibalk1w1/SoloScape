+        "unfired_pot_lid, pot_lid, 25, 20.0",
+    )
+    fun `Fire each recipe with a finished pot earlier in inventory`(raw: String, product: String, level: Int, xp: Double) {
+        val player = createPlayer(Tile(3085, 3408))
+        player.levels.set(Skill.Crafting, level)
+        player.inventory.add("empty_pot")
+        player.inventory.add("soft_clay")
+        player.inventory.add(raw)
+        val before = player.inventory.count(product)
+        val oven = GameObjects.find(Tile(3084, 3407), "pottery_oven")
+        player.objectOption(oven, "Fire")
+        tick()
+        player.continueDialogue("dialogue_skill_creation", "choice1")
+        tick(3)
+        assertEquals(0, player.inventory.count(raw))
+        assertEquals(before + 1, player.inventory.count(product))
+        assertEquals(1, player.inventory.count("soft_clay"))
+        assertEquals(if (product == "empty_pot") 2 else 1, player.inventory.count("empty_pot"))
+        assertEquals(xp, player.experience.get(Skill.Crafting))
+    }
