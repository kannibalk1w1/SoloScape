# Copy to local.env. Paths are executable files, not shell command strings.
SERVER_JAVA=java
CLIENT_JAVA=/path/to/jdk8/bin/java
# Cache defaults to upstream/game-server/data/cache; no automatic asset downloads.
# Optional shared input directory outside a replaceable code installation:
# SOLOSCAPE_CACHE_HOME=/absolute/path/to/authorized-cache

# Optional stable profiles and launcher settings/art for future versioned installs:
# SOLOSCAPE_PROFILE_HOME=/absolute/path/to/profiles
# SOLOSCAPE_LAUNCHER_HOME=/absolute/path/to/launcher-home
